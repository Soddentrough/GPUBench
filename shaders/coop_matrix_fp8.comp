#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_float_e4m3 : require

layout (local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
layout (local_size_x_id = 3) in;

layout (constant_id = 0) const uint TILE_M = 16u;
layout (constant_id = 1) const uint TILE_N = 16u;
layout (constant_id = 2) const uint TILE_K = 16u;

layout(set = 0, binding = 0) buffer DataA {
    floate4m3_t data[];
} BufferA;

layout(set = 0, binding = 1) buffer DataC {
    float data[];
} BufferC;

void main() {
    coopmat<floate4m3_t, gl_ScopeSubgroup, TILE_M, TILE_K, gl_MatrixUseA> matA;
    coopmat<floate4m3_t, gl_ScopeSubgroup, TILE_K, TILE_N, gl_MatrixUseB> matB;

    uint gid = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    uint strideA = max(TILE_K, 16u);
    uint strideB = max(TILE_N, 16u);
    uint inSpan = max(TILE_M * strideA, TILE_K * strideB);
    uint outSpan = TILE_M * TILE_N;
    coopMatLoad(matA, BufferA.data, (gid % 2048u) * inSpan, strideA, 0);
    coopMatLoad(matB, BufferA.data, ((gid + 1u) % 2048u) * inSpan, strideB, 0);

    // Use 8 distinct initial accumulators to prevent CSE/GVN from collapsing matC1..matC7 into matC0
    float seed = float((gid & 255u) + 1u) * 0.001;
    coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator> matC0 = coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator>(seed * 1.0);
    coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator> matC1 = coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator>(seed * 2.0);
    coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator> matC2 = coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator>(seed * 3.0);
    coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator> matC3 = coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator>(seed * 4.0);
    coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator> matC4 = coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator>(seed * 5.0);
    coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator> matC5 = coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator>(seed * 6.0);
    coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator> matC6 = coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator>(seed * 7.0);
    coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator> matC7 = coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator>(seed * 8.0);

    // 4096 * 8 = 32768 total matrix operations per workgroup
    for (int i = 0; i < 4096; ++i) {
        matC0 = coopMatMulAdd(matA, matB, matC0);
        matC1 = coopMatMulAdd(matA, matB, matC1);
        matC2 = coopMatMulAdd(matA, matB, matC2);
        matC3 = coopMatMulAdd(matA, matB, matC3);
        matC4 = coopMatMulAdd(matA, matB, matC4);
        matC5 = coopMatMulAdd(matA, matB, matC5);
        matC6 = coopMatMulAdd(matA, matB, matC6);
        matC7 = coopMatMulAdd(matA, matB, matC7);
    }

    // Combine to prevent dead-code elimination
    matC0 = matC0 + matC1;
    matC2 = matC2 + matC3;
    matC4 = matC4 + matC5;
    matC6 = matC6 + matC7;
    matC0 = matC0 + matC2;
    matC4 = matC4 + matC6;
    matC0 = (matC0 + matC4) * (16.0 / float(TILE_K));

    coopMatStore(matC0, BufferC.data, (gid % 1024u) * outSpan, TILE_N, 0);
}
