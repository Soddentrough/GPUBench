#version 460
#extension GL_EXT_ray_tracing : require

hitAttributeEXT vec2 attribs;

layout(push_constant) uniform PushConstants {
    uint rayCount;
    float alphaDensity; // 0.0 to 1.0 (1.0 = solid)
    uint seed;
} pc;

uint hash(uint seed) {
    seed = (seed ^ 61) ^ (seed >> 16);
    seed *= 9;
    seed = seed ^ (seed >> 4);
    seed *= 0x27d4eb2d;
    seed = seed ^ (seed >> 15);
    return seed;
}

void main() {
    // Compute barycentric UV coordinate across triangle surface
    vec2 uv = attribs * 16.0;
    
    // Procedural multi-frequency alpha cutout mask (simulating foliage leaf / fence cutout)
    float mask = sin(uv.x * 6.28318) * cos(uv.y * 6.28318);
    mask += 0.5 * sin(uv.x * 18.849) * cos(uv.y * 18.849);
    float alphaVal = clamp(0.5 + 0.5 * mask, 0.0, 1.0);

    // Alpha test threshold: if alpha < (1.0 - alphaDensity), the surface is transparent
    if (alphaVal < (1.0 - pc.alphaDensity)) {
        ignoreIntersectionEXT;
    }
}
