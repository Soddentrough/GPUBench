#version 460
#extension GL_KHR_shader_subgroup_ballot : enable
// GPUBench Dual-Issue & Concurrency Benchmark Suite
// Config 6: Dual-Issue Mixed (FP32+INT32, 1:1 Instruction Co-Issue)
// Evaluates concurrent execution across mixed datapaths (16 FP32 FMA instructions + 16 INT32 ALU instructions).

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Data {
    float data[];
} InOutBuffer;

layout(push_constant) uniform PushConstants {
    float multiplier;
    uint num_elements;
} pushConstants;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pushConstants.num_elements) return;

    float base = uintBitsToFloat((floatBitsToUint(InOutBuffer.data[index]) & 0x007FFFFFu) | 0x3F800000u);
    uint ubase = uint(base * 1000.0) + index;

    // 16 independent FP32 scalar accumulator chains (16 FMA instructions = 32 FLOPs/iter)
    float f0  = base;
    float f1  = base + 0.1;
    float f2  = base + 0.2;
    float f3  = base + 0.3;
    float f4  = base + 0.4;
    float f5  = base + 0.5;
    float f6  = base + 0.6;
    float f7  = base + 0.7;
    float f8  = base + 0.8;
    float f9  = base + 0.9;
    float f10 = base + 1.0;
    float f11 = base + 1.1;
    float f12 = base + 1.2;
    float f13 = base + 1.3;
    float f14 = base + 1.4;
    float f15 = base + 1.5;

    float mf = pushConstants.multiplier;

    // 8 independent INT32 scalar accumulator chains (8 add + 8 and = 16 INT32 instructions = 16 IOPs/iter)
    uint u0 = ubase;
    uint u1 = ubase + 1u;
    uint u2 = ubase + 2u;
    uint u3 = ubase + 3u;
    uint u4 = ubase + 4u;
    uint u5 = ubase + 5u;
    uint u6 = ubase + 6u;
    uint u7 = ubase + 7u;

    uint mu = (floatBitsToUint(pushConstants.multiplier) & 0x3FFu) | 1u;
    uint mask = (pushConstants.num_elements ^ 0x7FFF7FFFu) | 1u;

    // 65536 iterations * (16 scalar FMAs + 8 scalar INT add+and)
    // = 65536 * (32 FP32 ops + 16 INT32 ops) = 65536 * 48 = 3,145,728 operations
    for (int i = 0; i < 65536; ++i) {
        f0  = fma(mf, f0,  f0);
        u0  = (u0 + mu) & mask;
        f1  = fma(mf, f1,  f1);

        f2  = fma(mf, f2,  f2);
        u1  = (u1 + mu) & mask;
        f3  = fma(mf, f3,  f3);

        f4  = fma(mf, f4,  f4);
        u2  = (u2 + mu) & mask;
        f5  = fma(mf, f5,  f5);

        f6  = fma(mf, f6,  f6);
        u3  = (u3 + mu) & mask;
        f7  = fma(mf, f7,  f7);

        f8  = fma(mf, f8,  f8);
        u4  = (u4 + mu) & mask;
        f9  = fma(mf, f9,  f9);

        f10 = fma(mf, f10, f10);
        u5  = (u5 + mu) & mask;
        f11 = fma(mf, f11, f11);

        f12 = fma(mf, f12, f12);
        u6  = (u6 + mu) & mask;
        f13 = fma(mf, f13, f13);

        f14 = fma(mf, f14, f14);
        u7  = (u7 + mu) & mask;
        f15 = fma(mf, f15, f15);
    }

    float fres = ((f0 + f1) + (f2 + f3)) + ((f4 + f5) + (f6 + f7)) +
                 ((f8 + f9) + (f10 + f11)) + ((f12 + f13) + (f14 + f15));
    uint ures = ((u0 + u1) ^ (u2 + u3) ^ (u4 + u5) ^ (u6 + u7)) & 0x00FFFFFFu;

    InOutBuffer.data[index] = fres + float(ures | 1u);
}
