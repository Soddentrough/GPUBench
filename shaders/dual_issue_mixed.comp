#version 460
// GPUBench Dual-Issue & Concurrency Benchmark Suite
// Config 6: Dual-Issue Mixed (FP32+INT32, 50/50 Dual-Issue)
// Evaluates concurrent execution across mixed datapaths (8 FP32 + 8 INT32 scalar chains).

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Data {
    float data[];
} InOutBuffer;

layout(push_constant) uniform PushConstants {
    float multiplier;
    uint num_elements;
} pushConstants;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pushConstants.num_elements) return;

    float base = uintBitsToFloat((floatBitsToUint(InOutBuffer.data[index]) & 0x007FFFFFu) | 0x3F800000u);
    uint ubase = uint(base * 1000.0) + index;

    // 8 independent FP32 scalar accumulator chains
    float f0 = base;
    float f1 = base + 0.1;
    float f2 = base + 0.2;
    float f3 = base + 0.3;
    float f4 = base + 0.4;
    float f5 = base + 0.5;
    float f6 = base + 0.6;
    float f7 = base + 0.7;

    float mf = pushConstants.multiplier * 0.00001;

    // 8 independent INT32 scalar accumulator chains
    uint u0 = ubase;
    uint u1 = ubase + 1u;
    uint u2 = ubase + 2u;
    uint u3 = ubase + 3u;
    uint u4 = ubase + 4u;
    uint u5 = ubase + 5u;
    uint u6 = ubase + 6u;
    uint u7 = ubase + 7u;

    uint mu = uint(pushConstants.multiplier * 1000.0) | 1u;
    uint mask = (pushConstants.num_elements ^ 0x7FFF7FFFu) | 1u;

    // 65536 iterations * (8 scalar FMAs + 8 scalar INT add+and)
    // = 65536 * (16 FP32 ops + 16 INT32 ops) = 65536 * 32 = 2,097,152 operations
    for (int i = 0; i < 65536; ++i) {
        f0 = fma(f0, mf, f0);
        u0 = (u0 + mu) & mask;

        f1 = fma(f1, mf, f1);
        u1 = (u1 + mu) & mask;

        f2 = fma(f2, mf, f2);
        u2 = (u2 + mu) & mask;

        f3 = fma(f3, mf, f3);
        u3 = (u3 + mu) & mask;

        f4 = fma(f4, mf, f4);
        u4 = (u4 + mu) & mask;

        f5 = fma(f5, mf, f5);
        u5 = (u5 + mu) & mask;

        f6 = fma(f6, mf, f6);
        u6 = (u6 + mu) & mask;

        f7 = fma(f7, mf, f7);
        u7 = (u7 + mu) & mask;
    }

    float fres = (f0 + f1) + (f2 + f3) + (f4 + f5) + (f6 + f7);
    uint ures = ((u0 + u1) ^ (u2 + u3) ^ (u4 + u5) ^ (u6 + u7)) & 0x00FFFFFFu;

    InOutBuffer.data[index] = fres + float(ures | 1u);
}
