#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_opacity_micromap : require

layout(constant_id = 0) const uint kForceOmm2State = 0u;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(std430, set = 0, binding = 1) buffer OutputBuffer {
    vec4 pixels[];
} outBuf;

struct RayPayload {
    vec3 color;
    uint hits;
};

layout(location = 0) rayPayloadEXT RayPayload payload;

void main() {
    uvec2 launchID = gl_LaunchIDEXT.xy;
    uvec2 launchSize = gl_LaunchSizeEXT.xy;
    uint pixelIdx = launchID.y * launchSize.x + launchID.x;

    vec2 uv = (vec2(launchID) + vec2(0.5)) / vec2(launchSize);
    vec3 origin = vec3(uv.x * 2.0 - 1.0, uv.y * 2.0 - 1.0, -2.0);
    vec3 direction = normalize(vec3(0.0, 0.0, 1.0));

    payload.color = vec3(0.0);
    payload.hits = 0u;

    uint rayFlags = (kForceOmm2State != 0u)
                        ? gl_RayFlagsForceOpacityMicromap2StateEXT
                        : gl_RayFlagsNoneEXT;

    traceRayEXT(topLevelAS, rayFlags, 0xFFu, 0u, 0u, 0u,
                origin, 0.001, direction, 100.0, 0);

    outBuf.pixels[pixelIdx] = vec4(payload.color, float(payload.hits));
}
