#version 460
#extension GL_EXT_control_flow_attributes : enable

layout (local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly restrict buffer InputData {
    vec4 inputData[];
} InputBuffer;

layout(set = 0, binding = 1, std430) writeonly restrict buffer OutputData {
    vec4 outputData[];
} OutputBuffer;

layout(push_constant) uniform PushConstants {
    uint mode;
    uint bufferSize;  // Buffer size in bytes
} pc;

void main() {
    uint thread_id = gl_GlobalInvocationID.x;
    uint num_threads = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    
    uint total_vec4s = pc.bufferSize / 16;
    uint buffer_mask = total_vec4s - 1;

    vec4 accumulator = vec4(0.0);

    if (pc.mode == 1) { // Write
        for (int i = 0; i < 32; ++i) {
            uint base = (i * 32) * num_threads + thread_id;

            OutputBuffer.outputData[(base + 0 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 1 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 2 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 3 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 4 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 5 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 6 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 7 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 8 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 9 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 10 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 11 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 12 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 13 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 14 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 15 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 16 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 17 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 18 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 19 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 20 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 21 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 22 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 23 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 24 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 25 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 26 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 27 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 28 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 29 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 30 * num_threads) & buffer_mask] = vec4(1.0);
            OutputBuffer.outputData[(base + 31 * num_threads) & buffer_mask] = vec4(1.0);
        }
    } else if (pc.mode == 0) { // Read
        for (int i = 0; i < 32; ++i) {
            uint base = (i * 32) * num_threads + thread_id;

            vec4 data0 = InputBuffer.inputData[(base + 0 * num_threads) & buffer_mask];
            vec4 data1 = InputBuffer.inputData[(base + 1 * num_threads) & buffer_mask];
            vec4 data2 = InputBuffer.inputData[(base + 2 * num_threads) & buffer_mask];
            vec4 data3 = InputBuffer.inputData[(base + 3 * num_threads) & buffer_mask];
            vec4 data4 = InputBuffer.inputData[(base + 4 * num_threads) & buffer_mask];
            vec4 data5 = InputBuffer.inputData[(base + 5 * num_threads) & buffer_mask];
            vec4 data6 = InputBuffer.inputData[(base + 6 * num_threads) & buffer_mask];
            vec4 data7 = InputBuffer.inputData[(base + 7 * num_threads) & buffer_mask];
            vec4 data8 = InputBuffer.inputData[(base + 8 * num_threads) & buffer_mask];
            vec4 data9 = InputBuffer.inputData[(base + 9 * num_threads) & buffer_mask];
            vec4 data10 = InputBuffer.inputData[(base + 10 * num_threads) & buffer_mask];
            vec4 data11 = InputBuffer.inputData[(base + 11 * num_threads) & buffer_mask];
            vec4 data12 = InputBuffer.inputData[(base + 12 * num_threads) & buffer_mask];
            vec4 data13 = InputBuffer.inputData[(base + 13 * num_threads) & buffer_mask];
            vec4 data14 = InputBuffer.inputData[(base + 14 * num_threads) & buffer_mask];
            vec4 data15 = InputBuffer.inputData[(base + 15 * num_threads) & buffer_mask];
            vec4 data16 = InputBuffer.inputData[(base + 16 * num_threads) & buffer_mask];
            vec4 data17 = InputBuffer.inputData[(base + 17 * num_threads) & buffer_mask];
            vec4 data18 = InputBuffer.inputData[(base + 18 * num_threads) & buffer_mask];
            vec4 data19 = InputBuffer.inputData[(base + 19 * num_threads) & buffer_mask];
            vec4 data20 = InputBuffer.inputData[(base + 20 * num_threads) & buffer_mask];
            vec4 data21 = InputBuffer.inputData[(base + 21 * num_threads) & buffer_mask];
            vec4 data22 = InputBuffer.inputData[(base + 22 * num_threads) & buffer_mask];
            vec4 data23 = InputBuffer.inputData[(base + 23 * num_threads) & buffer_mask];
            vec4 data24 = InputBuffer.inputData[(base + 24 * num_threads) & buffer_mask];
            vec4 data25 = InputBuffer.inputData[(base + 25 * num_threads) & buffer_mask];
            vec4 data26 = InputBuffer.inputData[(base + 26 * num_threads) & buffer_mask];
            vec4 data27 = InputBuffer.inputData[(base + 27 * num_threads) & buffer_mask];
            vec4 data28 = InputBuffer.inputData[(base + 28 * num_threads) & buffer_mask];
            vec4 data29 = InputBuffer.inputData[(base + 29 * num_threads) & buffer_mask];
            vec4 data30 = InputBuffer.inputData[(base + 30 * num_threads) & buffer_mask];
            vec4 data31 = InputBuffer.inputData[(base + 31 * num_threads) & buffer_mask];

            accumulator += data0 + data1 + data2 + data3 + data4 + data5 + data6 + data7;
            accumulator += data8 + data9 + data10 + data11 + data12 + data13 + data14 + data15;
            accumulator += data16 + data17 + data18 + data19 + data20 + data21 + data22 + data23;
            accumulator += data24 + data25 + data26 + data27 + data28 + data29 + data30 + data31;
        }
    } else { // Read/Write
        for (int i = 0; i < 32; ++i) {
            uint base = (i * 32) * num_threads + thread_id;

            vec4 data0 = InputBuffer.inputData[(base + 0 * num_threads) & buffer_mask];
            vec4 data1 = InputBuffer.inputData[(base + 1 * num_threads) & buffer_mask];
            vec4 data2 = InputBuffer.inputData[(base + 2 * num_threads) & buffer_mask];
            vec4 data3 = InputBuffer.inputData[(base + 3 * num_threads) & buffer_mask];
            vec4 data4 = InputBuffer.inputData[(base + 4 * num_threads) & buffer_mask];
            vec4 data5 = InputBuffer.inputData[(base + 5 * num_threads) & buffer_mask];
            vec4 data6 = InputBuffer.inputData[(base + 6 * num_threads) & buffer_mask];
            vec4 data7 = InputBuffer.inputData[(base + 7 * num_threads) & buffer_mask];
            vec4 data8 = InputBuffer.inputData[(base + 8 * num_threads) & buffer_mask];
            vec4 data9 = InputBuffer.inputData[(base + 9 * num_threads) & buffer_mask];
            vec4 data10 = InputBuffer.inputData[(base + 10 * num_threads) & buffer_mask];
            vec4 data11 = InputBuffer.inputData[(base + 11 * num_threads) & buffer_mask];
            vec4 data12 = InputBuffer.inputData[(base + 12 * num_threads) & buffer_mask];
            vec4 data13 = InputBuffer.inputData[(base + 13 * num_threads) & buffer_mask];
            vec4 data14 = InputBuffer.inputData[(base + 14 * num_threads) & buffer_mask];
            vec4 data15 = InputBuffer.inputData[(base + 15 * num_threads) & buffer_mask];
            vec4 data16 = InputBuffer.inputData[(base + 16 * num_threads) & buffer_mask];
            vec4 data17 = InputBuffer.inputData[(base + 17 * num_threads) & buffer_mask];
            vec4 data18 = InputBuffer.inputData[(base + 18 * num_threads) & buffer_mask];
            vec4 data19 = InputBuffer.inputData[(base + 19 * num_threads) & buffer_mask];
            vec4 data20 = InputBuffer.inputData[(base + 20 * num_threads) & buffer_mask];
            vec4 data21 = InputBuffer.inputData[(base + 21 * num_threads) & buffer_mask];
            vec4 data22 = InputBuffer.inputData[(base + 22 * num_threads) & buffer_mask];
            vec4 data23 = InputBuffer.inputData[(base + 23 * num_threads) & buffer_mask];
            vec4 data24 = InputBuffer.inputData[(base + 24 * num_threads) & buffer_mask];
            vec4 data25 = InputBuffer.inputData[(base + 25 * num_threads) & buffer_mask];
            vec4 data26 = InputBuffer.inputData[(base + 26 * num_threads) & buffer_mask];
            vec4 data27 = InputBuffer.inputData[(base + 27 * num_threads) & buffer_mask];
            vec4 data28 = InputBuffer.inputData[(base + 28 * num_threads) & buffer_mask];
            vec4 data29 = InputBuffer.inputData[(base + 29 * num_threads) & buffer_mask];
            vec4 data30 = InputBuffer.inputData[(base + 30 * num_threads) & buffer_mask];
            vec4 data31 = InputBuffer.inputData[(base + 31 * num_threads) & buffer_mask];

            OutputBuffer.outputData[(base + 0 * num_threads) & buffer_mask] = data0;
            OutputBuffer.outputData[(base + 1 * num_threads) & buffer_mask] = data1;
            OutputBuffer.outputData[(base + 2 * num_threads) & buffer_mask] = data2;
            OutputBuffer.outputData[(base + 3 * num_threads) & buffer_mask] = data3;
            OutputBuffer.outputData[(base + 4 * num_threads) & buffer_mask] = data4;
            OutputBuffer.outputData[(base + 5 * num_threads) & buffer_mask] = data5;
            OutputBuffer.outputData[(base + 6 * num_threads) & buffer_mask] = data6;
            OutputBuffer.outputData[(base + 7 * num_threads) & buffer_mask] = data7;
            OutputBuffer.outputData[(base + 8 * num_threads) & buffer_mask] = data8;
            OutputBuffer.outputData[(base + 9 * num_threads) & buffer_mask] = data9;
            OutputBuffer.outputData[(base + 10 * num_threads) & buffer_mask] = data10;
            OutputBuffer.outputData[(base + 11 * num_threads) & buffer_mask] = data11;
            OutputBuffer.outputData[(base + 12 * num_threads) & buffer_mask] = data12;
            OutputBuffer.outputData[(base + 13 * num_threads) & buffer_mask] = data13;
            OutputBuffer.outputData[(base + 14 * num_threads) & buffer_mask] = data14;
            OutputBuffer.outputData[(base + 15 * num_threads) & buffer_mask] = data15;
            OutputBuffer.outputData[(base + 16 * num_threads) & buffer_mask] = data16;
            OutputBuffer.outputData[(base + 17 * num_threads) & buffer_mask] = data17;
            OutputBuffer.outputData[(base + 18 * num_threads) & buffer_mask] = data18;
            OutputBuffer.outputData[(base + 19 * num_threads) & buffer_mask] = data19;
            OutputBuffer.outputData[(base + 20 * num_threads) & buffer_mask] = data20;
            OutputBuffer.outputData[(base + 21 * num_threads) & buffer_mask] = data21;
            OutputBuffer.outputData[(base + 22 * num_threads) & buffer_mask] = data22;
            OutputBuffer.outputData[(base + 23 * num_threads) & buffer_mask] = data23;
            OutputBuffer.outputData[(base + 24 * num_threads) & buffer_mask] = data24;
            OutputBuffer.outputData[(base + 25 * num_threads) & buffer_mask] = data25;
            OutputBuffer.outputData[(base + 26 * num_threads) & buffer_mask] = data26;
            OutputBuffer.outputData[(base + 27 * num_threads) & buffer_mask] = data27;
            OutputBuffer.outputData[(base + 28 * num_threads) & buffer_mask] = data28;
            OutputBuffer.outputData[(base + 29 * num_threads) & buffer_mask] = data29;
            OutputBuffer.outputData[(base + 30 * num_threads) & buffer_mask] = data30;
            OutputBuffer.outputData[(base + 31 * num_threads) & buffer_mask] = data31;
        }
    }

    if (accumulator.x > 1e30) {
        OutputBuffer.outputData[0] = accumulator;
    }
}
