#version 460
#extension GL_EXT_ray_query : enable
#extension GL_EXT_ray_flags_primitive_culling : enable

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1) buffer Results {
    uint totalRays;
    uint totalHits;
    float accumulatedLuminance;
} results;

layout(push_constant) uniform PushConstants {
    uint rayCount;
    uint mode;     // 0: Material Divergence, 1: Multi-Bounce Path Tracing, 2: Incoherent GI
    uint bounces;  // Max bounces (for mode 1)
    uint seed;
} pc;

shared uint localRays;
shared uint localHits;

// PCG Random Generator
uint pcg_hash(inout uint state) {
    uint oldstate = state;
    state = oldstate * 747796405u + 2891336453u;
    uint word = ((oldstate >> ((oldstate >> 28u) + 4u)) ^ oldstate) * 277803737u;
    return (word >> 22u) ^ word;
}

float rand_float(inout uint state) {
    return float(pcg_hash(state) & 0x00FFFFFFu) / 16777216.0;
}

vec3 cosine_sample_hemisphere(float u1, float u2) {
    float r = sqrt(u1);
    float theta = 6.28318530718 * u2;
    float x = r * cos(theta);
    float y = r * sin(theta);
    float z = sqrt(max(0.0, 1.0 - u1));
    return vec3(x, y, z);
}

vec3 align_to_normal(vec3 sample_dir, vec3 normal) {
    vec3 up = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);
    return tangent * sample_dir.x + bitangent * sample_dir.y + normal * sample_dir.z;
}

// Procedural 3D Voronoi cellular noise for Car Paint Flakes
float voronoiFlakes(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    float minDist = 1.0;
    for (int z = -1; z <= 1; ++z) {
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                vec3 g = vec3(float(x), float(y), float(z));
                vec3 o = fract(sin(vec3(dot(i + g, vec3(127.1, 311.7, 74.7)),
                                        dot(i + g, vec3(269.5, 183.3, 246.1)),
                                        dot(i + g, vec3(113.5, 271.9, 124.6)))) * 43758.5453);
                vec3 diff = g + o - f;
                minDist = min(minDist, dot(diff, diff));
            }
        }
    }
    return sqrt(minDist);
}

// 3D Hash and FBM for Weathered Rust
float hash13(vec3 p3) {
    p3 = fract(p3 * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float noise3D(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    vec3 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(mix(hash13(i + vec3(0,0,0)), hash13(i + vec3(1,0,0)), u.x),
                   mix(hash13(i + vec3(0,1,0)), hash13(i + vec3(1,1,0)), u.x), u.y),
               mix(mix(hash13(i + vec3(0,0,1)), hash13(i + vec3(1,0,1)), u.x),
                   mix(hash13(i + vec3(0,1,1)), hash13(i + vec3(1,1,1)), u.x), u.y), u.z);
}

float fbmRust(vec3 p) {
    float v = 0.0;
    float a = 0.5;
    vec3 shift = vec3(100.0);
    for (int o = 0; o < 5; ++o) {
        v += a * noise3D(p);
        p = p * 2.04 + shift;
        a *= 0.5;
    }
    return v;
}

void buildOrthonormalBasis(vec3 n, out vec3 t, out vec3 b) {
    if (abs(n.z) < 0.999) {
        t = normalize(cross(n, vec3(0.0, 0.0, 1.0)));
    } else {
        t = normalize(cross(n, vec3(0.0, 1.0, 0.0)));
    }
    b = cross(n, t);
}

// 5 Realistic Production Material Archetypes across 32 IDs
vec3 evalMaterialBSDF(uint matId, vec3 normal, vec3 inDir, vec3 hitPos, inout uint rng) {
    vec3 viewDir = -inDir;
    vec3 lightDir = normalize(vec3(0.57735, 0.57735, 0.57735));
    vec3 halfVec = normalize(viewDir + lightDir);
    float NdotL = max(dot(normal, lightDir), 0.0);
    float NdotV = max(dot(normal, viewDir), 0.001);
    float NdotH = max(dot(normal, halfVec), 0.0);
    float VdotH = max(dot(viewDir, halfVec), 0.0);
    vec3 color = vec3(0.0);

    uint archetype = matId % 5;

    switch (archetype) {
        case 0: {
            // Archetype 0: Pure Conductors & Standard Dielectric PBR (Fast baseline)
            float a2 = 0.04;
            float d = NdotH * NdotH * (a2 - 1.0) + 1.0;
            float D = a2 / (3.14159 * d * d + 0.0001);
            float k = 0.18;
            float G = (NdotL / (NdotL * (1.0 - k) + k)) * (NdotV / (NdotV * (1.0 - k) + k));
            vec3 baseCol = (matId % 2 == 0) ? vec3(1.0, 0.78, 0.34) : vec3(0.9, 0.9, 0.92);
            vec3 F = baseCol + (1.0 - baseCol) * pow(clamp(1.0 - VdotH, 0.0, 1.0), 5.0);
            color = (D * G * F) / (4.0 * NdotL * NdotV + 0.001) * NdotL + baseCol * 0.1;
            break;
        }
        case 1: {
            // Archetype 1: Automotive Clearcoat with Metallic Voronoi Flakes
            float flakeNoise = voronoiFlakes(hitPos * 120.0);
            vec3 flakeNormal = normalize(normal + (fract(vec3(flakeNoise * 13.0, flakeNoise * 7.0, flakeNoise * 19.0)) - 0.5) * 0.15);
            float flakeNdotH = max(dot(flakeNormal, halfVec), 0.0);
            float flakeNdotL = max(dot(flakeNormal, lightDir), 0.0);
            
            float a2 = 0.06;
            float d = flakeNdotH * flakeNdotH * (a2 - 1.0) + 1.0;
            float D_base = a2 / (3.14159 * d * d + 0.0001);
            vec3 baseTint = vec3(0.85, 0.04, 0.08); // Crimson
            vec3 baseSpec = (D_base * 0.8 * baseTint) / (4.0 * NdotL * NdotV + 0.001) * flakeNdotL;

            float a2_coat = 0.0004;
            float d_coat = NdotH * NdotH * (a2_coat - 1.0) + 1.0;
            float D_coat = a2_coat / (3.14159 * d_coat * d_coat + 0.0001);
            float F_coat = 0.04 + 0.96 * pow(clamp(1.0 - VdotH, 0.0, 1.0), 5.0);
            vec3 coatSpec = vec3((D_coat * F_coat) / (4.0 * NdotL * NdotV + 0.001) * NdotL);

            vec3 absorption = exp(-vec3(0.1, 0.8, 0.7) * 0.05);
            color = coatSpec + baseSpec * (1.0 - F_coat) * absorption;
            break;
        }
        case 2: {
            // Archetype 2: Organic Jade / Subsurface Scattering
            vec3 baseJade = vec3(0.1, 0.75, 0.45);
            float wrap = 0.45;
            float diffuseWrap = max((dot(normal, lightDir) + wrap) / (1.0 + wrap), 0.0);
            vec3 sssProfile = exp(-vec3(0.4, 0.9, 0.3) * (1.0 - diffuseWrap));
            float a2 = 0.0225;
            float d = NdotH * NdotH * (a2 - 1.0) + 1.0;
            float D = a2 / (3.14159 * d * d + 0.0001);
            float F = 0.05 + 0.95 * pow(clamp(1.0 - VdotH, 0.0, 1.0), 5.0);
            vec3 coat = vec3((D * F) / (4.0 * NdotL * NdotV + 0.001) * NdotL);
            color = baseJade * diffuseWrap * sssProfile * 2.0 + coat;
            break;
        }
        case 3: {
            // Archetype 3: Anisotropic Woven Velvet with Charlie Sheen
            vec3 t, b;
            buildOrthonormalBasis(normal, t, b);
            float TdotH = dot(t, halfVec);
            float BdotH = dot(b, halfVec);
            float ax = 0.04;
            float ay = 0.36;
            float d_aniso = (TdotH * TdotH) / (ax * ax) + (BdotH * BdotH) / (ay * ay) + NdotH * NdotH;
            float D_aniso = 1.0 / (3.14159 * ax * ay * d_aniso * d_aniso + 0.0001);
            
            float sin2 = max(1.0 - NdotV * NdotV, 0.0);
            float sheen = pow(sin2, 1.25) * 1.5;
            vec3 sheenCol = vec3(0.95, 0.4, 0.85);
            vec3 baseCol = vec3(0.35, 0.03, 0.28);
            
            float weave = 0.5 + 0.5 * sin(dot(hitPos.xy, vec2(80.0)));
            color = (baseCol * weave * NdotL + sheenCol * sheen + vec3(D_aniso * 0.1) * NdotL);
            break;
        }
        case 4: {
            // Archetype 4: Weathered Industrial Rust (Heavy 5-octave FBM loop)
            float rustNoise = fbmRust(hitPos * 4.0);
            float rustMask = smoothstep(0.35, 0.65, rustNoise);
            
            vec3 steelCol = vec3(0.45, 0.47, 0.50);
            float d_steel = NdotH * NdotH * (0.09 - 1.0) + 1.0;
            float D_steel = 0.09 / (3.14159 * d_steel * d_steel + 0.0001);
            vec3 steelSpec = steelCol * (D_steel / (4.0 * NdotL * NdotV + 0.001) * NdotL);

            vec3 rustCol = vec3(0.55, 0.18, 0.05);
            vec3 rustDiff = rustCol * NdotL;

            color = mix(steelSpec, rustDiff, rustMask);
            break;
        }
    }

    return color;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.rayCount) return;

    if (gl_LocalInvocationID.x == 0) {
        localRays = 0;
        localHits = 0;
    }
    barrier();

    uint rngState = idx + pc.seed;
    float fx = float(idx % 512) - 256.0 + 0.5;
    float fy = float((idx / 512) % 512) - 256.0 + 0.5;

    vec3 origin = vec3(fx * 0.02, fy * 0.02, -5.0);
    vec3 direction = vec3(0.0, 0.0, 1.0);
    vec3 accumulated = vec3(0.0);
    vec3 throughput = vec3(1.0);
    uint threadRays = 0;
    uint threadHits = 0;

    if (pc.mode == 0) {
        // Mode 0: Material Divergence Stress Test (32 materials)
        threadRays++;
        rayQueryEXT query;
        rayQueryInitializeEXT(query, topLevelAS, gl_RayFlagsNoneEXT, 0xFF, origin, 0.001, direction, 20.0);
        while (rayQueryProceedEXT(query)) {}

        if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
            threadHits++;
            float t = rayQueryGetIntersectionTEXT(query, true);
            vec3 hitPos = origin + direction * t;
            uint primId = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
            // Derive normal
            vec3 normal = (primId % 2 == 0) ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
            if (dot(normal, direction) > 0.0) normal = -normal;

            // Divergent material ID assignment across threads in the wavefront
            uint matId = (primId + idx) % 32;
            accumulated = evalMaterialBSDF(matId, normal, direction, hitPos, rngState);
        }
    } else if (pc.mode == 1) {
        // Mode 1: Multi-Bounce Path Tracing with Russian Roulette (SIMD Lane Starvation)
        for (uint b = 0; b < pc.bounces; ++b) {
            threadRays++;
            rayQueryEXT query;
            rayQueryInitializeEXT(query, topLevelAS, gl_RayFlagsNoneEXT, 0xFF, origin, 0.001, direction, 20.0);
            while (rayQueryProceedEXT(query)) {}

            if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
                threadHits++;
                float t = rayQueryGetIntersectionTEXT(query, true);
                vec3 hitPos = origin + direction * t;
                uint primId = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
                vec3 normal = vec3(0.0, 1.0, 0.0);
                if (dot(normal, direction) > 0.0) normal = -normal;

                // Hemisphere reflection
                float u1 = rand_float(rngState);
                float u2 = rand_float(rngState);
                direction = align_to_normal(cosine_sample_hemisphere(u1, u2), normal);
                origin = hitPos + normal * 0.002;

                throughput *= vec3(0.8);

                // Russian roulette termination (40% termination probability)
                // In traditional execution, terminated threads must idle until the entire wave completes!
                if (b >= 2 && rand_float(rngState) < 0.4) {
                    break; // Thread becomes inactive; remaining lanes keep looping
                }
            } else {
                accumulated += throughput * vec3(0.5, 0.7, 1.0);
                break;
            }
        }
    } else {
        // Mode 2: Incoherent Secondary GI (Hemisphere Scattering without Spatial Binning)
        threadRays++;
        rayQueryEXT query1;
        rayQueryInitializeEXT(query1, topLevelAS, gl_RayFlagsNoneEXT, 0xFF, origin, 0.001, direction, 20.0);
        while (rayQueryProceedEXT(query1)) {}

        if (rayQueryGetIntersectionTypeEXT(query1, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
            threadHits++;
            float t = rayQueryGetIntersectionTEXT(query1, true);
            vec3 hitPos = origin + direction * t;
            vec3 normal = vec3(0.0, 1.0, 0.0);

            // Incoherent scattering: arbitrary random directions
            float u1 = rand_float(rngState);
            float u2 = rand_float(rngState);
            vec3 incohDir = align_to_normal(cosine_sample_hemisphere(u1, u2), normal);

            // Secondary ray: high BVH cache miss rate when unorganized
            threadRays++;
            rayQueryEXT query2;
            rayQueryInitializeEXT(query2, topLevelAS, gl_RayFlagsNoneEXT, 0xFF, hitPos + normal * 0.002, 0.001, incohDir, 20.0);
            while (rayQueryProceedEXT(query2)) {}

            if (rayQueryGetIntersectionTypeEXT(query2, true) != 0) {
                threadHits++;
                accumulated += vec3(1.0);
            }
        }
    }

    if (threadRays > 0) atomicAdd(localRays, threadRays);
    if (threadHits > 0) atomicAdd(localHits, threadHits);
    barrier();

    if (gl_LocalInvocationID.x == 0) {
        atomicAdd(results.totalRays, localRays);
        atomicAdd(results.totalHits, localHits);
    }
}
