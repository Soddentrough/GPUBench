#version 460
#extension GL_EXT_ray_query : enable
#extension GL_EXT_ray_flags_primitive_culling : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1) buffer Results {
    uint totalRays;
    uint totalHits;
    uint accumulatedLuminance;
} results;

#include "rt_scheduling_common.glsl"

layout(set = 0, binding = 2) buffer WorkListBuffer {
    uint queueCounters[Q_HEADER_UINT_CAP];
    vec4 rayRecords[];
} worklist;

layout(set = 0, binding = 3) buffer Framebuffer {
    vec4 pixels[];
} fb;

layout(set = 0, binding = 4) readonly buffer VertexBuffer {
    float vertices[];
} vbuf;

#define BINDING_MAT_BUF 5
#define BINDING_TRI_MAT_BUF 6
#define BINDING_TEX_HDR_BUF 7
#define BINDING_TEX_PIX_BUF 8
#define ENABLE_SPECIALIZED_ARCHETYPE 1
#define PBR_NO_RAY_QUERY 1
#include "pbr_common.glsl"

layout(push_constant) uniform PushConstants {
    uint materialId;
    uint queueCapacity;
    uint dumpRenders;
    uint width;
    uint height;
    uint sceneType;       // 0: Showroom Studio, 1: Outdoor Terrain, 2: Indoor Atrium, 3: AAA Forest
    uint isGltf;          // 1 if glTF PBR scene, 0 if procedural
    uint mode;            // 0: Full Render, 1: Pure Shading microbenchmark, 2: Primary Surface Normals / G-Buffer
} pc;

// Scene Type Constants
const uint SCENE_SHOWROOM_STUDIO = 0u;
const uint SCENE_OUTDOOR_TERRAIN = 1u;
const uint SCENE_INDOOR_ATRIUM   = 2u;
const uint SCENE_REACTOR_BAY     = 3u;

// Procedural Showroom Studio & Indoor Atrium Primitives
const uint PRIM_KNOT_PAINT_END  = 1536u;
const uint PRIM_KNOT_JADE_END   = 3072u;
const uint PRIM_KNOT_CHROME_END = 4608u;
const uint PRIM_KNOT_VELVET_END = 6144u;
const uint PRIM_KNOT_RUST_END   = 7680u;
const uint PRIM_SPHERE_END      = 9600u;
const uint PRIM_PEDESTAL_END    = 9728u;
const uint PRIM_SUZANNE_END     = 10696u;
const uint PRIM_FLOOR_END       = 27080u;
const uint PRIM_WALLS_END       = 28104u;
const uint PRIM_CEILING_END     = 29128u;
const uint PRIM_COLUMNS_END     = 35272u;

// Outdoor Landscape Primitives
const uint PRIM_TERRAIN_END     = 32768u;
const uint PRIM_WATER_END       = 34816u;
const uint PRIM_TREES_END       = 57216u;

uint pcg_hash(inout uint state) {
    uint oldstate = state;
    state = oldstate * 747796405u + 2891336453u;
    uint word = ((oldstate >> ((oldstate >> 28u) + 4u)) ^ oldstate) * 277803737u;
    return (word >> 22u) ^ word;
}

float rand_float(inout uint state) {
    return float(pcg_hash(state) & 0x00FFFFFFu) / 16777216.0;
}

vec2 signNotZero(vec2 v) {
    return vec2(v.x >= 0.0 ? 1.0 : -1.0, v.y >= 0.0 ? 1.0 : -1.0);
}

vec3 octDecode(vec2 f) {
    vec3 n = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    float t = clamp(-n.z, 0.0, 1.0);
    n.x += (n.x >= 0.0) ? -t : t;
    n.y += (n.y >= 0.0) ? -t : t;
    return normalize(n);
}

vec3 cosine_sample_hemisphere(float u1, float u2) {
    float r = sqrt(u1);
    float theta = 6.28318530718 * u2;
    float x = r * cos(theta);
    float y = r * sin(theta);
    float z = sqrt(max(0.0, 1.0 - u1));
    return vec3(x, y, z);
}

vec3 align_to_normal(vec3 sample_dir, vec3 normal) {
    vec3 up = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);
    return tangent * sample_dir.x + bitangent * sample_dir.y + normal * sample_dir.z;
}

float hash31(vec3 p) {
    p = fract(p * 0.1031);
    p += dot(p, p.yzx + 33.33);
    return fract((p.x + p.y) * p.z);
}

vec3 hash33(vec3 p) {
    vec3 p3 = fract(p * vec3(0.1031, 0.1030, 0.0973));
    p3 += dot(p3, p3.yxz + 33.33);
    return fract((p3.xxy + p3.yxx) * p3.zyx);
}

float noise3D(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float n000 = hash31(i + vec3(0, 0, 0));
    float n100 = hash31(i + vec3(1, 0, 0));
    float n010 = hash31(i + vec3(0, 1, 0));
    float n110 = hash31(i + vec3(1, 1, 0));
    float n011 = hash31(i + vec3(0, 0, 1));
    float n101 = hash31(i + vec3(1, 0, 1));
    float n011b = hash31(i + vec3(0, 1, 1));
    float n111 = hash31(i + vec3(1, 1, 1));
    return mix(
        mix(mix(n000, n100, f.x), mix(n010, n110, f.x), f.y),
        mix(mix(n011, n101, f.x), mix(n011b, n111, f.x), f.y),
        f.z
    );
}

float rustFBM3D(vec3 p) {
    float v = 0.0;
    float a = 0.5;
    mat3 rot = mat3(
         0.00,  0.80,  0.60,
        -0.80,  0.36, -0.48,
        -0.60, -0.48,  0.64
    );
    for (int i = 0; i < 4; ++i) {
        v += a * noise3D(p);
        p = rot * p * 2.02 + vec3(1.7, 9.2, 0.4);
        a *= 0.5;
    }
    return v;
}

void getCamera(uint sceneType, out vec3 camPos, out vec3 camForward, out vec3 camRight, out vec3 camUp, out float fov) {
    // Zero-Day Reactor Bay: Elevated observation catwalk overlooking magnetic confinement core (+Z Up)
    camPos = vec3(0.0, -21.0, 4.15);
    camForward = normalize(vec3(0.0, 5.2, 6.2) - camPos);
    camRight = normalize(cross(camForward, vec3(0.0, 0.0, 1.0)));
    camUp = cross(camRight, camForward);
    fov = 0.62;
}

vec3 tonemapACES(vec3 x) {
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

void main() {
    uint threadIdx = gl_GlobalInvocationID.x;
    bool isPureShading = (SPECIALIZED_ARCHETYPE != 9u) && (pc.mode == 1u);

    uint count = isPureShading ? pc.queueCapacity : worklist.queueCounters[Q_SNAPSHOT_IDX(pc.materialId)];
    if (threadIdx >= count || threadIdx >= pc.queueCapacity) return;

    if (isPureShading && threadIdx == 0u) {
        atomicAdd(results.totalRays, count);
        atomicAdd(results.totalHits, count);
    }

    uint recordIdx = pc.materialId * pc.queueCapacity + threadIdx;
    vec4 p = isPureShading ? vec4(0.0) : worklist.rayRecords[recordIdx];

    uint pixelIdx = isPureShading ? recordIdx : floatBitsToUint(p.y);
    uint rngState = pixelIdx;

    vec3 shadedColor;
    if (isPureShading) {
        uint uniformArch = (SPECIALIZED_ARCHETYPE < 8u) ? SPECIALIZED_ARCHETYPE : subgroupBroadcastFirst(pc.materialId & 7u);
        GltfMaterialGpu mat = matBuf.materials[uniformArch];
        mat.archetype = uniformArch;

        vec3 camPos, camForward, camRight, camUp;
        float fov;
        getCamera(pc.sceneType, camPos, camForward, camRight, camUp, fov);
        uint px_u = pixelIdx % pc.width;
        uint py_u = pixelIdx / pc.width;
        float halfH = float(pc.height) * 0.5;
        float px = float(px_u) - float(pc.width) * 0.5 + 0.5;
        float py = float(py_u) - halfH + 0.5;
        vec3 inDir = normalize(camForward + (px / halfH * fov) * camRight - (py / halfH * fov) * camUp);

        vec3 dummyPos = vec3(float(px_u) * 0.01, float(py_u) * 0.01, 1.5);
        vec3 dummyNorm = ((pixelIdx % 2) == 0) ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
        vec4 dummyTan = vec4(1.0, 0.0, 0.0, 1.0);
        vec2 dummyUv = vec2(float(px_u) / float(pc.width), float(py_u) / float(pc.height));
        shadedColor = evaluateGltfPbr(mat, dummyPos, dummyNorm, dummyNorm, dummyTan, dummyUv, inDir, 3u, false, rngState);
    } else {
        uint uniformArch = (SPECIALIZED_ARCHETYPE < 8u) ? SPECIALIZED_ARCHETYPE : subgroupBroadcastFirst(pc.materialId & 7u);
        uint primId = floatBitsToUint(p.z);
        if (subgroupAllEqual(primId)) {
            primId = subgroupBroadcastFirst(primId);
        }
        GltfMaterialGpu mat = matBuf.materials[uniformArch];
        mat.archetype = uniformArch;

        vec2 bary = unpackUnorm2x16(floatBitsToUint(p.w));
        uint base = primId * 36u;
        vec3 p0 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
        vec3 n0 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);
        vec2 uv0 = vec2(vbuf.vertices[base + 10], vbuf.vertices[base + 11]);

        uint base1 = base + 12u;
        vec3 p1v = vec3(vbuf.vertices[base1 + 0], vbuf.vertices[base1 + 1], vbuf.vertices[base1 + 2]);
        vec3 n1 = vec3(vbuf.vertices[base1 + 3], vbuf.vertices[base1 + 4], vbuf.vertices[base1 + 5]);
        vec2 uv1 = vec2(vbuf.vertices[base1 + 10], vbuf.vertices[base1 + 11]);

        uint base2 = base + 24u;
        vec3 p2v = vec3(vbuf.vertices[base2 + 0], vbuf.vertices[base2 + 1], vbuf.vertices[base2 + 2]);
        vec3 n2 = vec3(vbuf.vertices[base2 + 3], vbuf.vertices[base2 + 4], vbuf.vertices[base2 + 5]);
        vec2 uv2 = vec2(vbuf.vertices[base2 + 10], vbuf.vertices[base2 + 11]);

        float w = 1.0 - bary.x - bary.y;
        vec3 interpHitPos = w * p0 + bary.x * p1v + bary.y * p2v;
        vec3 geomNormal = normalize(cross(p1v - p0, p2v - p0));
        vec3 sn = w * n0 + bary.x * n1 + bary.y * n2;
        vec3 smoothNormal = (length(sn) > 1e-4) ? normalize(sn) : geomNormal;
        vec4 tangent = vec4(0.0);
        if (mat.normalTexIdx >= 0) {
            vec4 t0 = vec4(vbuf.vertices[base + 6], vbuf.vertices[base + 7], vbuf.vertices[base + 8], vbuf.vertices[base + 9]);
            vec4 t1 = vec4(vbuf.vertices[base1 + 6], vbuf.vertices[base1 + 7], vbuf.vertices[base1 + 8], vbuf.vertices[base1 + 9]);
            vec4 t2 = vec4(vbuf.vertices[base2 + 6], vbuf.vertices[base2 + 7], vbuf.vertices[base2 + 8], vbuf.vertices[base2 + 9]);
            tangent = w * t0 + bary.x * t1 + bary.y * t2;
        }
        vec2 uv = w * uv0 + bary.x * uv1 + bary.y * uv2;

        vec3 camPos, camForward, camRight, camUp;
        float fov;
        getCamera(pc.sceneType, camPos, camForward, camRight, camUp, fov);
        uint px_u = pixelIdx % pc.width;
        uint py_u = pixelIdx / pc.width;
        float halfH = float(pc.height) * 0.5;
        float px = float(px_u) - float(pc.width) * 0.5 + 0.5;
        float py = float(py_u) - halfH + 0.5;
        vec3 inDir = normalize(camForward + (px / halfH * fov) * camRight - (py / halfH * fov) * camUp);

        vec2 vis2 = unpackHalf2x16(floatBitsToUint(p.x));
        bool isGlass = (mat.transmissionFactor > 0.80);
        vec3 preVis = vec3(vis2.x, isGlass ? 1.0 : vis2.y, isGlass ? vis2.y : -1.0);
        shadedColor = evaluateGltfPbrPrecomputedVis(mat, interpHitPos, geomNormal, smoothNormal, tangent, uv, inDir, 3u, true, preVis, rngState);
    }

    if (pc.dumpRenders != 0) {
        fb.pixels[pixelIdx] = vec4(tonemapACES(shadedColor * 1.0), 1.0);
    } else {
        uint threadLum = uint(clamp(dot(shadedColor, vec3(0.2126, 0.7152, 0.0722)), 0.0, 100.0) * 256.0);
        uint waveLum = subgroupAdd(threadLum);
        if (subgroupElect() && waveLum > 0u) {
            atomicAdd(results.accumulatedLuminance, waveLum);
        }
    }
}
