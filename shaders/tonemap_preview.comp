#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer HdrBufferA {
    vec4 pixelsA[];
};

layout(set = 0, binding = 1, std430) readonly buffer HdrBufferB {
    vec4 pixelsB[];
};

layout(set = 0, binding = 2, rgba8) writeonly uniform image2D outImage;

layout(push_constant) uniform PushConsts {
    uint width;
    uint height;
    uint mode; // 0 = tonemap A, 1 = 10x diff heatmap(A, B)
} pc;

float linearToSrgb(float c) {
    c = clamp(c, 0.0, 1.0);
    if (c <= 0.0031308) {
        return c * 12.92;
    }
    return 1.055 * pow(c, 1.0 / 2.4) - 0.055;
}

void main() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= pc.width || gid.y >= pc.height) {
        return;
    }
    uint idx = gid.y * pc.width + gid.x;
    vec3 a = pixelsA[idx].rgb;
    vec3 srgbA = vec3(linearToSrgb(a.r), linearToSrgb(a.g), linearToSrgb(a.b));

    if (pc.mode == 0u) {
        imageStore(outImage, ivec2(gid), vec4(srgbA, 1.0));
    } else {
        vec3 b = pixelsB[idx].rgb;
        vec3 srgbB = vec3(linearToSrgb(b.r), linearToSrgb(b.g), linearToSrgb(b.b));
        vec3 qA = floor(srgbA * 255.0 + 0.5);
        vec3 qB = floor(srgbB * 255.0 + 0.5);
        vec3 diff = abs(qA - qB) / 255.0;
        float maxD = max(diff.r, max(diff.g, diff.b));
        float heat = min(1.0, maxD * 10.0);
        vec3 outCol = vec3(0.0);
        if (heat > 0.0) {
            outCol = vec3(
                clamp(heat * 2.0, 0.0, 1.0),
                clamp(2.0 - heat * 2.0, 0.0, 1.0),
                1.0 - heat
            );
        }
        imageStore(outImage, ivec2(gid), vec4(outCol, 1.0));
    }
}
