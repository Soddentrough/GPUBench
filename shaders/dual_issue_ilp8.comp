#version 460
#extension GL_KHR_shader_subgroup_ballot : enable
// GPUBench Dual-Issue & Concurrency Benchmark Suite
// Config 1: Dual-Issue FP32 (Partial Co-Issue - 8 chains)
// Evaluates moderate ILP with 8 independent scalar accumulator chains.

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Data {
    float data[];
} InOutBuffer;

layout(push_constant) uniform PushConstants {
    float multiplier;
    uint num_elements;
} pushConstants;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pushConstants.num_elements) return;

    float base = uintBitsToFloat((floatBitsToUint(InOutBuffer.data[index]) & 0x007FFFFFu) | 0x3F800000u);
    float val0 = base;
    float val1 = base + 0.1;
    float val2 = base + 0.2;
    float val3 = base + 0.3;
    float val4 = base + 0.4;
    float val5 = base + 0.5;
    float val6 = base + 0.6;
    float val7 = base + 0.7;

    float m = pushConstants.multiplier;

    // 65536 iterations * 8 scalar FMAs = 65536 * 16 = 1,048,576 FP32 operations
    for (int i = 0; i < 65536; ++i) {
        val0 = fma(m, val0, val0);
        val1 = fma(m, val1, val1);
        val2 = fma(m, val2, val2);
        val3 = fma(m, val3, val3);
        val4 = fma(m, val4, val4);
        val5 = fma(m, val5, val5);
        val6 = fma(m, val6, val6);
        val7 = fma(m, val7, val7);
    }

    InOutBuffer.data[index] = (val0 + val1) + (val2 + val3) + (val4 + val5) + (val6 + val7);
}
