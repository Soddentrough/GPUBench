#version 460
// GPUBench Dual-Issue & Concurrency Benchmark Suite
// Config 2: ILP-8 (Dual-Issue Transition Threshold)
// Evaluates the transition point where 8 independent operations in flight
// allow superscalar/VOPD schedulers to begin co-issuing dual instructions.

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Data {
    float data[];
} InOutBuffer;

layout(push_constant) uniform PushConstants {
    float multiplier;
    uint num_elements;
} pushConstants;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pushConstants.num_elements) return;

    // 4 independent scalar accumulators:
    // Sits at the transition threshold where pairs of instructions can co-issue,
    // but the 4-instruction issue window contains latency bubbles, demonstrating partial co-issue.
    float base = InOutBuffer.data[index];
    float val0 = base;
    float val1 = base + 0.1;
    float val2 = base + 0.2;
    float val3 = base + 0.3;
    float m = pushConstants.multiplier;
    float c0 = 0.0001;
    float c1 = 0.0002;
    float c2 = 0.0003;
    float c3 = 0.0004;

    // 131072 iterations * 4 scalar FMAs = 131072 * 8 = 1,048,576 FP32 operations
    for (int i = 0; i < 131072; ++i) {
        val0 = fma(val0, m, c0);
        val1 = fma(val1, m, c1);
        val2 = fma(val2, m, c2);
        val3 = fma(val3, m, c3);
    }

    InOutBuffer.data[index] = val0 + val1 + val2 + val3;
}
