#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer WorkListBuffer {
    uint activeWorklist[];
};

layout(set = 0, binding = 1) buffer OutputBuffer {
    float results[];
};

struct VkDispatchIndirectCommand {
    uint x;
    uint y;
    uint z;
    uint activeCount;
    uint workgroupsFinished;
};

layout(set = 0, binding = 2) buffer IndirectCommandBuffer {
    VkDispatchIndirectCommand cmd;
};

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= cmd.activeCount) {
        return;
    }

    uint itemId = activeWorklist[gid];
    
    // Representative compute arithmetic loop
    float val = float(itemId) * 0.001f;
    for (int i = 0; i < 32; i++) {
        val = sin(val) * 1.05f + cos(val * 0.5f);
    }

    results[gid] = val;
}
