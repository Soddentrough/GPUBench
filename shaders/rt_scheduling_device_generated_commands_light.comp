#version 460
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(local_size_x = 32) in;

layout(set = 0, binding = 1) buffer Results {
    uint totalRays;
    uint totalHits;
    uint accumulatedLuminance;
} results;

#include "rt_scheduling_common.glsl"

layout(set = 0, binding = 2) buffer WorkListBuffer {
    uint queueCounters[Q_HEADER_UINT_CAP];
    vec4 rayRecords[];
} worklist;

layout(set = 0, binding = 3) buffer Framebuffer {
    vec4 pixels[];
} fb;

layout(set = 0, binding = 4) readonly buffer VertexBuffer {
    float vertices[];
} vbuf;

#define BINDING_MAT_BUF 5
#define BINDING_TRI_MAT_BUF 6
#define BINDING_TEX_HDR_BUF 7
#define BINDING_TEX_PIX_BUF 8
#define PBR_NO_RAY_QUERY 1
#include "pbr_common.glsl"

layout(push_constant) uniform PushConstants {
    uint queueId;         // 0 for Single Light, 0..7 for 128-Light Octant Binning
    uint queueCapacity;
    uint dumpRenders;
    uint width;
    uint height;
    uint sceneType;       // 0: Showroom Studio, 1: Outdoor Terrain, 2: Indoor Atrium, 3: AAA Forest
    uint isGltf;          // 1 if glTF PBR scene, 0 if procedural
    uint binIndex;        // <= 1u or 0xFFFFFFFFu: Single Light, > 1u (e.g. 128u): 128 Lights (8 bins x 16 lights)
} pc;

vec3 tonemapACES(vec3 x) {
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

const uint SCENE_SHOWROOM_STUDIO = 0u;
const uint SCENE_OUTDOOR_TERRAIN = 1u;
const uint SCENE_INDOOR_ATRIUM   = 2u;
const uint SCENE_AAA_FOREST       = 3u;

void getCamera(uint sceneType, out vec3 camPos, out vec3 camForward, out vec3 camRight, out vec3 camUp, out float fov) {
    if (pc.isGltf != 0u) {
        if (sceneType == SCENE_AAA_FOREST) {
            camPos = vec3(0.0, -18.0, 0.55);
            camForward = normalize(vec3(0.0, 33.0, 1.2));
            camRight = normalize(cross(camForward, vec3(0.0, 0.0, 1.0)));
            camUp = cross(camRight, camForward);
            fov = 0.65;
            return;
        } else if (sceneType == SCENE_INDOOR_ATRIUM) {
            camPos = vec3(-1150.0, 280.0, -40.0);
            camForward = normalize(vec3(1.0, 0.02, 0.0));
            camRight = vec3(0.0, 0.0, -1.0);
            camUp = vec3(0.0, 1.0, 0.0);
            fov = 0.55;
            return;
        } else if (sceneType == SCENE_SHOWROOM_STUDIO) {
            camPos = vec3(360.0, 160.0, 420.0);
            vec3 target = vec3(0.0, 30.0, 0.0);
            camForward = normalize(target - camPos);
            camRight = normalize(cross(camForward, vec3(0.0, 1.0, 0.0)));
            camUp = cross(camRight, camForward);
            fov = 0.45;
            return;
        }
    }
    if (sceneType == SCENE_OUTDOOR_TERRAIN) {
        camPos = vec3(0.0, -320.0, 75.0);
        camForward = vec3(0.0, 0.997375, -0.072412);
        camRight = vec3(1.0, 0.0, 0.0);
        camUp = vec3(0.0, 0.072412, 0.997375);
        fov = 0.45;
    } else if (sceneType == SCENE_INDOOR_ATRIUM) {
        camPos = vec3(0.0, -9.6, 1.2);
        camForward = normalize(vec3(0.0, 9.6, 0.6));
        camRight = vec3(1.0, 0.0, 0.0);
        camUp = normalize(cross(camRight, camForward));
        fov = 0.65;
    } else {
        camPos = vec3(-0.5081, -8.1276, 1.5591);
        camForward = vec3(0.0562, 0.9852, -0.1622);
        camRight = vec3(0.9984, -0.0570, 0.0000);
        camUp = vec3(0.0092, 0.1619, 0.9868);
        fov = 0.2155;
    }
}

vec3 octDecode(vec2 f) {
    vec3 n = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    float t = clamp(-n.z, 0.0, 1.0);
    n.x += (n.x >= 0.0) ? -t : t;
    n.y += (n.y >= 0.0) ? -t : t;
    return normalize(n);
}

void main() {
    uint threadIdx = gl_GlobalInvocationID.x;
    uint count = min(worklist.queueCounters[Q_SNAPSHOT_IDX(pc.queueId)], pc.queueCapacity);

    uint threadLum = 0u;

    if (threadIdx < count) {
        uint recordIdx = pc.queueId * pc.queueCapacity + threadIdx;
        uvec4 raw = floatBitsToUint(worklist.rayRecords[recordIdx]);
        vec3 smoothNormal = octDecode(unpackSnorm2x16(raw.x));
        uint pixelIdx = raw.y & 0x00FFFFFFu;
        float metallic = float(raw.y >> 24u) * (1.0 / 255.0);
        vec2 albRG = unpackHalf2x16(raw.z);
        vec2 albBR = unpackHalf2x16(raw.w);
        vec3 albedo = vec3(albRG, albBR.x);
        float roughness = albBR.y;

        vec3 camPos, camForward, camRight, camUp;
        float fov;
        getCamera(pc.sceneType, camPos, camForward, camRight, camUp, fov);

        uint px_u = pixelIdx % pc.width;
        uint py_u = pixelIdx / pc.width;
        float halfH = float(pc.height) * 0.5;
        float px = float(px_u) - float(pc.width) * 0.5 + 0.5;
        float py = float(py_u) - halfH + 0.5;
        vec3 inDir = normalize(camForward + (px / halfH * fov) * camRight - (py / halfH * fov) * camUp);
        vec3 viewDir = -inDir;

        vec3 outRadiance;
        if (pc.binIndex <= 1u || pc.binIndex == 0xFFFFFFFFu) {
            // Single Light (back-facing surfaces already culled in classify.comp)
            vec3 L, C;
            getMultiLight(0u, 1u, pc.sceneType, L, C);
            outRadiance = evalCookTorranceDirect(smoothNormal, viewDir, L, C, albedo, roughness, metallic);
        } else {
            // 128 Lights Octant-Binned Evaluation:
            // Surfaces in queue pc.queueId have smoothNormal in octant pc.queueId.
            // We cull entire 16-light octant bins at the wave level using the exact octant cone bound
            // before evaluating or broadcasting any individual light directions.
            vec3 totalRadiance = vec3(0.0);
            uint lane16 = gl_SubgroupInvocationID & 15u;
            uint qOct = subgroupBroadcastFirst(pc.queueId & 7u);
            uint oppositeOctant = (~qOct) & 7u;
            bool has16 = ((subgroupBallot(true).x & 0xFFFFu) == 0xFFFFu);

            for (uint b = 0u; b < 8u; ++b) {
                if (b == oppositeOctant) continue;
                vec3 octSign = vec3(
                    (b & 1u) != 0u ? 1.0 : -1.0,
                    (b & 2u) != 0u ? 1.0 : -1.0,
                    (b & 4u) != 0u ? 1.0 : -1.0
                );
                vec3 s = smoothNormal * octSign;
                float maxDot = length(max(s, vec3(0.0))) + min(s.x, 0.0) * 0.06 + min(s.y, 0.0) * 0.06 + min(s.z, 0.0) * 0.20;
                if (subgroupAll(maxDot <= 0.0)) continue;

                if (has16) {
                    vec3 binL, binC;
                    getMultiLight(b * 16u + lane16, 128u, pc.sceneType, binL, binC);
                    for (uint li = 0u; li < 16u; ++li) {
                        vec3 L = subgroupBroadcast(binL, li);
                        vec3 C = subgroupBroadcast(binC, li);
                        float NdotL = dot(smoothNormal, L);
                        if (subgroupAll(NdotL <= 0.0)) continue;
                        if (NdotL > 0.0) {
                            totalRadiance += evalCookTorranceDirect(smoothNormal, viewDir, L, C, albedo, roughness, metallic);
                        }
                    }
                } else {
                    for (uint li = 0u; li < 16u; ++li) {
                        vec3 L, C;
                        getMultiLight(b * 16u + li, 128u, pc.sceneType, L, C);
                        if (dot(smoothNormal, L) > 0.0) {
                            totalRadiance += evalCookTorranceDirect(smoothNormal, viewDir, L, C, albedo, roughness, metallic);
                        }
                    }
                }
            }
            outRadiance = totalRadiance;
        }

        if (pc.dumpRenders != 0u) {
            fb.pixels[pixelIdx] = vec4(tonemapACES(outRadiance), 1.0);
        } else {
            threadLum = uint(clamp(dot(outRadiance, vec3(0.2126, 0.7152, 0.0722)), 0.0, 100.0) * 256.0);
        }
    }

    uint waveLum = subgroupAdd(threadLum);
    if (subgroupElect() && waveLum > 0u) {
        atomicAdd(results.accumulatedLuminance, waveLum);
    }
}
