#version 460
#extension GL_EXT_ray_query : enable
#extension GL_EXT_ray_flags_primitive_culling : enable

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1) buffer Results {
    uint totalRays;
    uint totalHits;
    float accumulatedLuminance;
} results;

#include "rt_scheduling_common.glsl"

layout(set = 0, binding = 2) buffer WorkListBuffer {
    uint queueCounters[Q_HEADER_UINT_CAP];
    vec4 rayRecords[];
} worklist;

layout(set = 0, binding = 3) buffer Framebuffer {
    vec4 pixels[];
} fb;

layout(set = 0, binding = 4) readonly buffer VertexBuffer {
    float vertices[];
} vbuf;

#define BINDING_MAT_BUF 5
#define BINDING_TRI_MAT_BUF 6
#define BINDING_TEX_HDR_BUF 7
#define BINDING_TEX_PIX_BUF 8
#include "pbr_common.glsl"

layout(push_constant) uniform PushConstants {
    uint queueId;
    uint queueCapacity;
    uint dumpRenders;
    uint width;
    uint height;
    uint sceneType;       // 0: Showroom Studio, 1: Outdoor Terrain, 2: Indoor Atrium
    uint isGltf;          // 1 if glTF PBR scene, 0 if procedural
    uint lightIndex;      // 0: Key/Sun, 1: Fill, 2: Rim
} pc;

const uint SCENE_SHOWROOM_STUDIO = 0u;
const uint SCENE_OUTDOOR_TERRAIN = 1u;
const uint SCENE_INDOOR_ATRIUM   = 2u;
const uint SCENE_AAA_FOREST       = 3u;

void getCamera(uint sceneType, out vec3 camPos, out vec3 camForward, out vec3 camRight, out vec3 camUp, out float fov) {
    if (pc.isGltf != 0u) {
        if (sceneType == SCENE_AAA_FOREST) {
            camPos = vec3(-35.0, -50.0, 20.0);
            camForward = normalize(vec3(45.0, 180.0, -14.0));
            camRight = normalize(cross(camForward, vec3(0.0, 0.0, 1.0)));
            camUp = cross(camRight, camForward);
            fov = 0.52;
            return;
        } else if (sceneType == SCENE_INDOOR_ATRIUM) {
            camPos = vec3(-1150.0, 280.0, -40.0);
            camForward = normalize(vec3(1.0, 0.02, 0.0));
            camRight = vec3(0.0, 0.0, -1.0);
            camUp = vec3(0.0, 1.0, 0.0);
            fov = 0.55;
            return;
        } else if (sceneType == SCENE_SHOWROOM_STUDIO) {
            camPos = vec3(360.0, 160.0, 420.0);
            vec3 target = vec3(0.0, 30.0, 0.0);
            camForward = normalize(target - camPos);
            camRight = normalize(cross(camForward, vec3(0.0, 1.0, 0.0)));
            camUp = cross(camRight, camForward);
            fov = 0.45;
            return;
        }
    }
    // Procedural terrain / fallback
    camPos = vec3(0.0, 80.0, 280.0);
    vec3 target = vec3(0.0, 30.0, 0.0);
    camForward = normalize(target - camPos);
    camRight = normalize(cross(camForward, vec3(0.0, 1.0, 0.0)));
    camUp = cross(camRight, camForward);
    fov = 0.55;
}

vec3 computeSmoothNormal(uint sceneType, uint primId, vec3 hitPos, vec3 inDir, vec2 bary) {
    if (sceneType == SCENE_OUTDOOR_TERRAIN) {
        if (primId < 35000u) {
            float hL = sin((hitPos.x - 2.0) * 0.02) * cos(hitPos.z * 0.02) * 15.0;
            float hR = sin((hitPos.x + 2.0) * 0.02) * cos(hitPos.z * 0.02) * 15.0;
            float hD = sin(hitPos.x * 0.02) * cos((hitPos.z - 2.0) * 0.02) * 15.0;
            float hU = sin(hitPos.x * 0.02) * cos((hitPos.z + 2.0) * 0.02) * 15.0;
            return normalize(vec3(hL - hR, 4.0, hD - hU));
        } else if (primId < 36000u) {
            return vec3(0.0, 1.0, 0.0);
        } else {
            vec3 c = vec3(float((primId * 17u) % 200u) - 100.0, 20.0, float((primId * 31u) % 200u) - 100.0);
            return normalize(hitPos - c);
        }
    }
    return vec3(0.0, 1.0, 0.0);
}

void main() {
    uint threadIdx = gl_GlobalInvocationID.x;
    uint count = worklist.queueCounters[Q_SNAPSHOT_IDX(pc.queueId)];
    if (threadIdx >= count || threadIdx >= pc.queueCapacity) return;

    if (threadIdx == 0) {
        atomicAdd(results.totalRays, count);
    }

    uint recordIdx = pc.queueId * pc.queueCapacity + threadIdx;
    vec4 p = worklist.rayRecords[recordIdx];
    float t = p.x;
    uint pixelIdx = floatBitsToUint(p.y);
    uint primId = floatBitsToUint(p.z);
    vec2 bary = unpackUnorm2x16(floatBitsToUint(p.w));

    vec3 camPos, camForward, camRight, camUp;
    float fov;
    getCamera(pc.sceneType, camPos, camForward, camRight, camUp, fov);

    uint px_u = pixelIdx % pc.width;
    uint py_u = pixelIdx / pc.width;
    float halfH = float(pc.height) * 0.5;
    float px = float(px_u) - float(pc.width) * 0.5 + 0.5;
    float py = float(py_u) - halfH + 0.5;
    vec3 inDir = normalize(camForward + (px / halfH * fov) * camRight - (py / halfH * fov) * camUp);
    vec3 hitPos = camPos + inDir * t;

    vec3 geomNormal;
    if (pc.isGltf != 0u) {
        uint base = primId * 36u;
        vec3 p0 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
        vec3 p1 = vec3(vbuf.vertices[base + 12], vbuf.vertices[base + 13], vbuf.vertices[base + 14]);
        vec3 p2 = vec3(vbuf.vertices[base + 24], vbuf.vertices[base + 25], vbuf.vertices[base + 26]);
        geomNormal = normalize(cross(p1 - p0, p2 - p0));
    } else {
        geomNormal = computeSmoothNormal(pc.sceneType, primId, hitPos, inDir, bary);
    }

    vec3 lightDir;
    float maxDist;
    if (pc.sceneType == SCENE_INDOOR_ATRIUM) {
        lightDir = normalize(vec3(0.35, 0.90, -0.25));
        maxDist = 10000.0;
    } else if (pc.sceneType == SCENE_SHOWROOM_STUDIO) {
        if (pc.lightIndex == 1u) {
            lightDir = normalize(vec3(-0.7, 0.5, 0.4));
        } else if (pc.lightIndex == 2u) {
            lightDir = normalize(vec3(-0.2, 0.4, -0.9));
        } else {
            lightDir = normalize(vec3(0.6, 0.8, 0.5));
        }
        maxDist = 5000.0;
    } else {
        lightDir = normalize(vec3(0.45, 0.35, 0.82));
        maxDist = 2500.0;
    }

    bool occluded = false;
    if (dot(geomNormal, lightDir) > 0.0) {
        rayQueryEXT sQuery;
        vec3 rayOrig = hitPos + geomNormal * 0.12;
        rayQueryInitializeEXT(sQuery, topLevelAS,
            gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT | gl_RayFlagsOpaqueEXT,
            0xFF, rayOrig, 0.05, lightDir, maxDist);
        while (rayQueryProceedEXT(sQuery)) {}
        if (rayQueryGetIntersectionTypeEXT(sQuery, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
            occluded = true;
            atomicAdd(results.totalHits, 1);
        }
    }

    if (pc.dumpRenders != 0) {
        float shadowVal = occluded ? 0.08 : 0.95;
        fb.pixels[pixelIdx] = vec4(vec3(shadowVal), 1.0);
    }
}
