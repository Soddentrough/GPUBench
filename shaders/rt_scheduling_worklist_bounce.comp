#version 460
#extension GL_EXT_ray_query : enable
#extension GL_EXT_ray_flags_primitive_culling : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1) buffer Results {
    uint totalRays;
    uint totalHits;
    float accumulatedLuminance;
} results;

#include "rt_scheduling_common.glsl"

layout(set = 0, binding = 2) buffer WorkListBuffer {
    uint queueCounters[Q_HEADER_UINT_CAP];
    vec4 rayRecords[];
} worklist;

layout(set = 0, binding = 3) readonly buffer VertexBuffer {
    float vertices[];
} vbuf;

#define BINDING_MAT_BUF 4
#define BINDING_TRI_MAT_BUF 5
#define BINDING_TEX_HDR_BUF 6
#define BINDING_TEX_PIX_BUF 7
#include "pbr_common.glsl"

layout(set = 0, binding = 8) buffer Framebuffer {
    vec4 pixels[];
} fb;

layout(push_constant) uniform PushConstants {
    uint inQueue;
    uint outQueue;
    uint bounceIndex;
    uint seed;
    uint maxQueueSize;
    uint sceneType;       // 0: Showroom Studio, 1: Outdoor Terrain, 2: Indoor Atrium
    uint isGltf;          // 1 if glTF PBR scene, 0 if procedural
} pc;

layout(constant_id = 0) const uint BOUNCE_MODE = 0u; // 0: Non-terminal (path tracing), 1: Terminal (path tracing, octDecode), 2: Terminal (octants, Cartesian XY)

// Scene Type Constants
const uint SCENE_SHOWROOM_STUDIO = 0u;
const uint SCENE_OUTDOOR_TERRAIN = 1u;
const uint SCENE_INDOOR_ATRIUM   = 2u;

// Indoor Atrium Primitives
const uint PRIM_KNOT_PAINT_END  = 1536u;
const uint PRIM_KNOT_JADE_END   = 3072u;
const uint PRIM_KNOT_CHROME_END = 4608u;
const uint PRIM_KNOT_VELVET_END = 6144u;
const uint PRIM_KNOT_RUST_END   = 7680u;
const uint PRIM_SPHERE_END      = 9600u;
const uint PRIM_PEDESTAL_END    = 9728u;
const uint PRIM_SUZANNE_END     = 10696u;
const uint PRIM_FLOOR_END       = 27080u;
const uint PRIM_WALLS_END       = 28104u;
const uint PRIM_CEILING_END     = 29128u;
const uint PRIM_COLUMNS_END     = 35272u;

// Outdoor Landscape Primitives
const uint PRIM_TERRAIN_END     = 32768u;
const uint PRIM_WATER_END       = 34816u;
const uint PRIM_TREES_END       = 57216u;

uint pcg_hash(inout uint state) {
    uint oldstate = state;
    state = oldstate * 747796405u + 2891336453u;
    uint word = ((oldstate >> ((oldstate >> 28u) + 4u)) ^ oldstate) * 277803737u;
    return (word >> 22u) ^ word;
}

float rand_float(inout uint state) {
    return float(pcg_hash(state) & 0x00FFFFFFu) / 16777216.0;
}

vec2 signNotZero(vec2 v) {
    return vec2(v.x >= 0.0 ? 1.0 : -1.0, v.y >= 0.0 ? 1.0 : -1.0);
}

vec2 octEncode(vec3 n) {
    n /= (abs(n.x) + abs(n.y) + abs(n.z));
    return (n.z >= 0.0) ? n.xy : ((1.0 - abs(n.yx)) * signNotZero(n.xy));
}

vec3 octDecode(vec2 f) {
    vec3 n = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    float t = clamp(-n.z, 0.0, 1.0);
    n.x += (n.x >= 0.0) ? -t : t;
    n.y += (n.y >= 0.0) ? -t : t;
    return normalize(n);
}

vec3 cosine_sample_hemisphere(float u1, float u2) {
    float r = sqrt(u1);
    float theta = 6.28318530718 * u2;
    float x = r * cos(theta);
    float y = r * sin(theta);
    float z = sqrt(max(0.0, 1.0 - u1));
    return vec3(x, y, z);
}

vec3 align_to_normal(vec3 sample_dir, vec3 normal) {
    vec3 up = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);
    return tangent * sample_dir.x + bitangent * sample_dir.y + normal * sample_dir.z;
}

vec3 computeSmoothNormal(uint sceneType, uint primId, vec3 hitPos, vec3 rayDir, vec2 bary) {
    if (pc.isGltf != 0u) {
        uint base = primId * 36u;
        vec3 p0 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
        vec3 n0 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);
        base += 12u;
        vec3 p1 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
        vec3 n1 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);
        base += 12u;
        vec3 p2 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
        vec3 n2 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);

        float w = 1.0 - bary.x - bary.y;
        vec3 geomNorm = normalize(cross(p1 - p0, p2 - p0));
        vec3 smoothNorm = w * n0 + bary.x * n1 + bary.y * n2;
        vec3 n = (length(smoothNorm) > 1e-4) ? normalize(smoothNorm) : geomNorm;
        if (dot(n, rayDir) > 0.0) n = -n;
        return n;
    }
    vec3 normal;
    if (sceneType == SCENE_OUTDOOR_TERRAIN) {
        if (primId >= PRIM_TERRAIN_END && primId < PRIM_WATER_END) {
            normal = vec3(0.0, 0.0, 1.0);
        } else {
            uint base = primId * 9u;
            vec3 p0 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
            vec3 p1 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);
            vec3 p2 = vec3(vbuf.vertices[base + 6], vbuf.vertices[base + 7], vbuf.vertices[base + 8]);
            normal = normalize(cross(p1 - p0, p2 - p0));
        }
    } else {
        if (primId < PRIM_KNOT_RUST_END) {
            uint segI = (primId / 48u);
            float u0 = (float(segI) / 160.0) * 6.283185307;
            float u1 = (float((segI + 1u) % 160u) / 160.0) * 6.283185307;

            float r0 = (2.0 + 0.8 * cos(3.0 * u0)) * 0.835;
            vec3 unrot0 = vec3(r0 * cos(2.0 * u0), r0 * sin(2.0 * u0), -0.8 * 0.835 * sin(3.0 * u0));
            float r1 = (2.0 + 0.8 * cos(3.0 * u1)) * 0.835;
            vec3 unrot1 = vec3(r1 * cos(2.0 * u1), r1 * sin(2.0 * u1), -0.8 * 0.835 * sin(3.0 * u1));

            const mat3 R_knot = mat3(
                vec3( 0.929662, -0.239757, -0.279722),
                vec3( 0.326751,  0.887321,  0.325417),
                vec3( 0.170182, -0.393927,  0.903249)
            );
            vec3 c0 = R_knot * unrot0 + vec3(0.0, 0.0, 0.385);
            vec3 c1 = R_knot * unrot1 + vec3(0.0, 0.0, 0.385);

            vec3 seg = c1 - c0;
            float segLen2 = dot(seg, seg);
            float tSeg = clamp(dot(hitPos - c0, seg) / max(segLen2, 0.00001), 0.0, 1.0);
            vec3 centerPt = c0 + tSeg * seg;

            normal = normalize(hitPos - centerPt);
        } else if (primId < PRIM_SPHERE_END) {
            normal = normalize(hitPos - vec3(-3.242, 0.391, -0.509));
        } else if (primId < PRIM_PEDESTAL_END) {
            if (hitPos.z >= -0.658) {
                normal = vec3(0.0, 0.0, 1.0);
            } else if (hitPos.z <= -1.050) {
                normal = vec3(0.0, 0.0, -1.0);
            } else {
                normal = normalize(vec3(hitPos.x - (-0.460), hitPos.y - 0.060, 0.0));
            }
        } else if (primId < PRIM_SUZANNE_END) {
            uint base = primId * 9u;
            vec3 p0 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
            vec3 p1 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);
            vec3 p2 = vec3(vbuf.vertices[base + 6], vbuf.vertices[base + 7], vbuf.vertices[base + 8]);
            normal = normalize(cross(p1 - p0, p2 - p0));
        } else if (primId < PRIM_FLOOR_END) {
            float backCurve = (hitPos.y > 1.0) ? 0.044 * (hitPos.y - 1.0) : 0.0;
            normal = normalize(vec3(0.0, -backCurve, 1.0));
        } else {
            uint base = primId * 9u;
            vec3 p0 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
            vec3 p1 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);
            vec3 p2 = vec3(vbuf.vertices[base + 6], vbuf.vertices[base + 7], vbuf.vertices[base + 8]);
            normal = normalize(cross(p1 - p0, p2 - p0));
        }
    }
    if (dot(normal, rayDir) > 0.0) normal = -normal;
    return normal;
}

void main() {
    uint waveId = gl_WorkGroupID.x;
    uint oct = pc.inQueue;
    uint waveOffsetInOct = 0u;
    uint activeCount = 0u;

    if (BOUNCE_MODE == 2u) {
        if (gl_LocalInvocationID.x == 0u) {
            uint myOct = 0u;
            for (uint i = 1u; i < 8u; ++i) {
                if (waveId >= worklist.queueCounters[Q_PREFIX_IDX(i)]) {
                    myOct = i;
                }
            }
            oct = myOct;
            waveOffsetInOct = waveId - worklist.queueCounters[Q_PREFIX_IDX(myOct)];
            activeCount = min(worklist.queueCounters[Q_SNAPSHOT_IDX(myOct)], pc.maxQueueSize);
        }
        oct = subgroupBroadcastFirst(oct);
        waveOffsetInOct = subgroupBroadcastFirst(waveOffsetInOct);
        activeCount = subgroupBroadcastFirst(activeCount);
    } else {
        activeCount = min((pc.outQueue >= 32u) ? worklist.queueCounters[Q_SNAPSHOT_IDX(oct)] : worklist.queueCounters[Q_COUNTER_IDX(oct)], pc.maxQueueSize);
    }

    uint rayIdx = (BOUNCE_MODE == 2u) ? (waveOffsetInOct * 32u + gl_LocalInvocationID.x) : gl_GlobalInvocationID.x;

    bool activeRay = (rayIdx < activeCount);
    uint threadRays = activeRay ? 1u : 0u;
    uint threadHits = 0u;

    bool nextRayActive = false;
    vec4 nextRayPayload = vec4(0.0);

    if (activeRay) {
        uint recordIdx = oct * pc.maxQueueSize + rayIdx;
        vec4 p = worklist.rayRecords[recordIdx];
        vec3 origin = p.xyz;
        vec3 direction;
        if (BOUNCE_MODE == 2u) {
            vec2 xy = unpackSnorm2x16(floatBitsToUint(p.w));
            float z = sqrt(max(0.0, 1.0 - dot(xy, xy)));
            if ((oct & 4u) == 0u) z = -z;
            direction = vec3(xy, z);
        } else {
            direction = octDecode(unpackSnorm2x16(floatBitsToUint(p.w)));
        }

        float tMaxBounce = (pc.isGltf != 0u) ? 5000.0 : ((pc.sceneType == SCENE_OUTDOOR_TERRAIN) ? 500.0 : 20.0);
        float rayOffset = (pc.isGltf != 0u) ? 0.05 : 0.005;
        rayQueryEXT query;
        uint rayFlags = (gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT);
        rayQueryInitializeEXT(query, topLevelAS, rayFlags, 0xFF, origin, rayOffset, direction, tMaxBounce);
        while (rayQueryProceedEXT(query)) {}

        if (rayQueryGetIntersectionTypeEXT(query, true) != 0) {
            threadHits = 1u;
            if (BOUNCE_MODE == 0u && pc.outQueue < 32u) {
                float t = rayQueryGetIntersectionTEXT(query, true);
                vec3 hitPos = origin + direction * t;
                uint primId = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
                vec2 bary = rayQueryGetIntersectionBarycentricsEXT(query, true);
                vec3 normal = computeSmoothNormal(pc.sceneType, primId, hitPos, direction, bary);

                uint rngState = rayIdx + pc.seed + pc.bounceIndex * 1337u;
                // Russian roulette: 40% termination probability on bounce >= 2
                bool survives = (pc.bounceIndex < 2u) || (rand_float(rngState) >= 0.4);
                if (survives) {
                    float u1 = rand_float(rngState);
                    float u2 = rand_float(rngState);
                    vec3 nextDir = align_to_normal(cosine_sample_hemisphere(u1, u2), normal);
                    nextRayActive = true;
                    nextRayPayload = vec4(hitPos + normal * rayOffset, uintBitsToFloat(packSnorm2x16(octEncode(nextDir))));
                }
            }
        }
    }

    // Ping-Pong Subgroup Compaction into outQueue (Path Tracing)
    if (BOUNCE_MODE == 0u && pc.outQueue < 32u) {
        uvec4 ballot = subgroupBallot(nextRayActive);
        uint count = subgroupBallotBitCount(ballot);
        if (count > 0u) {
            uint slotInWave = subgroupBallotExclusiveBitCount(ballot);
            uint firstLane = subgroupBallotFindLSB(ballot);
            uint baseSlot = 0u;
            if (gl_SubgroupInvocationID == firstLane) {
                baseSlot = atomicAdd(worklist.queueCounters[Q_COUNTER_IDX(pc.outQueue)], count);
            }
            baseSlot = subgroupBroadcast(baseSlot, firstLane);
            if (nextRayActive) {
                uint slot = baseSlot + slotInWave;
                if (slot < pc.maxQueueSize) {
                    worklist.rayRecords[pc.outQueue * pc.maxQueueSize + slot] = nextRayPayload;
                }
            }
        }
    }

    uint waveRays = subgroupAdd(threadRays);
    uint waveHits = subgroupAdd(threadHits);
    if (subgroupElect()) {
        if (waveRays > 0u) atomicAdd(results.totalRays, waveRays);
        if (waveHits > 0u) atomicAdd(results.totalHits, waveHits);
    }
}
