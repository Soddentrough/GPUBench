#version 460
#extension GL_NV_cooperative_vector : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_buffer_reference : require

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer WeightBuffer {
    float16_t weights[];
} weightBuf;

layout(std430, set = 0, binding = 1) readonly buffer BiasBuffer {
    float16_t biases[];
} biasBuf;

layout(std430, set = 0, binding = 2) buffer OutputBuffer {
    float16_t outVals[];
} outBuf;

layout(push_constant) uniform PushConsts {
    uint numThreads;
    uint iterations;
} pc;

void main() {
    uint tid = gl_GlobalInvocationID.x;
    if (tid >= pc.numThreads) {
        return;
    }

    coopvecNV<float16_t, 16> v;
    for (uint c = 0u; c < 16u; ++c) {
        v[c] = float16_t(0.0625 * float((tid + c) & 15u) + 0.125);
    }

    // Repeated 16x16 per-invocation MLP layers (2*16*16 = 512 FLOPs per MatMulAdd)
    for (uint it = 0u; it < pc.iterations; ++it) {
        coopvecNV<float16_t, 16> nextV;
        coopVecMatMulAddNV(
            nextV,
            v,
            gl_ComponentTypeFloat16NV,
            weightBuf.weights, 0u,
            gl_ComponentTypeFloat16NV,
            biasBuf.biases, 0u,
            gl_ComponentTypeFloat16NV,
            16, 16,
            gl_CooperativeVectorMatrixLayoutRowMajorNV,
            false,
            32u);
        // Leaky ReLU activation
        v = max(nextV, nextV * float16_t(0.125));
    }

    uint baseOut = (tid & 4095u) * 16u;
    for (uint c = 0u; c < 16u; ++c) {
        outBuf.outVals[baseOut + c] = v[c];
    }
}
