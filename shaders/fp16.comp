#version 460
// Requires Vulkan 1.4+
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types : require

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Data {
    f16vec4 data[];
} InOutBuffer;

void main() {
    uint index = gl_GlobalInvocationID.x;

    // Use 16 f16vec4 accumulators (32 VGPRs) to guarantee <= 64 VGPRs and 100% occupancy.
    f16vec4 val1 = InOutBuffer.data[index % 1024];
    f16vec4 val2 = f16vec4(0.1, 0.2, 0.3, 0.4);
    f16vec4 val3 = f16vec4(0.5, 0.6, 0.7, 0.8);
    f16vec4 val4 = f16vec4(0.9, 1.0, 1.1, 1.2);
    f16vec4 val5 = f16vec4(1.3, 1.4, 1.5, 1.6);
    f16vec4 val6 = f16vec4(1.7, 1.8, 1.9, 2.0);
    f16vec4 val7 = f16vec4(2.1, 2.2, 2.3, 2.4);
    f16vec4 val8 = f16vec4(2.5, 2.6, 2.7, 2.8);
    f16vec4 val9 = f16vec4(2.9, 3.0, 3.1, 3.2);
    f16vec4 val10 = f16vec4(3.3, 3.4, 3.5, 3.6);
    f16vec4 val11 = f16vec4(3.7, 3.8, 3.9, 4.0);
    f16vec4 val12 = f16vec4(4.1, 4.2, 4.3, 4.4);
    f16vec4 val13 = f16vec4(4.5, 4.6, 4.7, 4.8);
    f16vec4 val14 = f16vec4(4.9, 5.0, 5.1, 5.2);
    f16vec4 val15 = f16vec4(5.3, 5.4, 5.5, 5.6);
    f16vec4 val16 = f16vec4(5.7, 5.8, 5.9, 6.0);

    f16vec4 m = f16vec4(float16_t(1.0009765625));
    
    // Each iteration performs 16 f16vec4 FMAs = 16 * 4 * 2 = 128 FP16 ops.
    // 65536 iters * 128 ops = 8,388,608 FP16 ops
    for (int i = 0; i < 65536; ++i) {
        val1 = fma(val1, m, val2);
        val2 = fma(val2, m, val3);
        val3 = fma(val3, m, val4);
        val4 = fma(val4, m, val5);
        val5 = fma(val5, m, val6);
        val6 = fma(val6, m, val7);
        val7 = fma(val7, m, val8);
        val8 = fma(val8, m, val9);
        val9 = fma(val9, m, val10);
        val10 = fma(val10, m, val11);
        val11 = fma(val11, m, val12);
        val12 = fma(val12, m, val13);
        val13 = fma(val13, m, val14);
        val14 = fma(val14, m, val15);
        val15 = fma(val15, m, val16);
        val16 = fma(val16, m, val1);
    }
    
    // Prevent optimization away
    InOutBuffer.data[index] = val1 + val2 + val3 + val4 + val5 + val6 + val7 + val8 +
                              val9 + val10 + val11 + val12 + val13 + val14 + val15 + val16;
}
