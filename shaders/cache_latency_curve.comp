#version 460
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Data {
    uint data[];
} Buffer;

layout(push_constant) uniform PushConstants {
    uint iterations;
    uint startIndex;
} pc;

void main() {
    uint index = pc.startIndex;
    uint iters = pc.iterations;
    uint i = 0u;
    
    // Serial pointer chasing loop across 128-byte cache lines
    do {
        index = Buffer.data[index];
        i++;
    } while (i < iters);

    // Eliminate DCE: store terminal index to unchased word (+1)
    Buffer.data[pc.startIndex + 1] = index;
}
