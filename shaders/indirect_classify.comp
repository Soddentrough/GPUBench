#version 460
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer InputBuffer {
    uint inputItems[];
};

layout(set = 0, binding = 1) buffer WorkListBuffer {
    uint activeWorklist[];
};

struct VkDispatchIndirectCommand {
    uint x;
    uint y;
    uint z;
    uint activeCount;
    uint workgroupsFinished;
};

layout(set = 0, binding = 2) buffer IndirectCommandBuffer {
    VkDispatchIndirectCommand cmd;
};

layout(push_constant) uniform PushConstants {
    uint selectivity;      // 0..100 (%)
    uint totalItems;       // Total items to classify
    uint totalWorkgroups;  // Total workgroups dispatched
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    bool activeItem = false;

    if (gid < pc.totalItems) {
        // Fast deterministic pseudo-random hash to determine selectivity
        uint hash = gid * 2654435761u;
        activeItem = (hash % 100u) < pc.selectivity;
    }

    // Subgroup-level compaction
    uvec4 ballot = subgroupBallot(activeItem);
    uint subgroupActive = subgroupBallotBitCount(ballot);
    uint laneOffset = subgroupBallotExclusiveBitCount(ballot);

    uint baseSlot = 0;
    if (subgroupElect() && subgroupActive > 0) {
        baseSlot = atomicAdd(cmd.activeCount, subgroupActive);
    }
    baseSlot = subgroupBroadcastFirst(baseSlot);

    if (activeItem) {
        activeWorklist[baseSlot + laneOffset] = gid;
    }

    // Last workgroup to complete writes the VkDispatchIndirectCommand
    if (subgroupElect()) {
        uint finished = atomicAdd(cmd.workgroupsFinished, 1u);
        if (finished == pc.totalWorkgroups - 1u) {
            uint totalActive = cmd.activeCount;
            cmd.x = (totalActive + 63u) / 64u;
            cmd.y = (totalActive > 0u) ? 1u : 0u;
            cmd.z = (totalActive > 0u) ? 1u : 0u;
        }
    }
}
