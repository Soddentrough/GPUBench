#version 460
layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

shared uint lds[1024];

layout(set = 0, binding = 0) buffer OutputBuffer {
    uint results[];
};

layout(push_constant) uniform PushConstants {
    uint stride;
    uint iterations;
} pc;

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint gid = gl_GlobalInvocationID.x;

    // Initialize shared memory with a uniform multiple of 32 (32 banks) so that
    // adding acc0 to base_addr keeps the loop-carried dependency live without
    // scrambling per-lane bank offsets (base_addr mod 32 remains (tid * stride) mod 32).
    for (uint i = tid; i < 1024u; i += 32u) {
        lds[i] = 32u;
    }
    barrier();

    uint stride = pc.stride;
    uint iters = pc.iterations;

    // Each lane accesses its bank stride
    uint base_addr = (tid * stride) & 1023u;
    uint acc0 = 0u;
    uint acc1 = 0u;
    uint acc2 = 0u;
    uint acc3 = 0u;
    uint acc4 = 0u;
    uint acc5 = 0u;
    uint acc6 = 0u;
    uint acc7 = 0u;

    for (uint i = 0u; i < iters; i++) {
        acc0 += lds[(base_addr + 0u * stride) & 1023u];
        acc1 += lds[(base_addr + 1u * stride) & 1023u];
        acc2 += lds[(base_addr + 2u * stride) & 1023u];
        acc3 += lds[(base_addr + 3u * stride) & 1023u];
        acc4 += lds[(base_addr + 4u * stride) & 1023u];
        acc5 += lds[(base_addr + 5u * stride) & 1023u];
        acc6 += lds[(base_addr + 6u * stride) & 1023u];
        acc7 += lds[(base_addr + 7u * stride) & 1023u];
        base_addr = (base_addr + acc0) & 1023u;
    }

    uint total = acc0 + acc1 + acc2 + acc3 + acc4 + acc5 + acc6 + acc7;
    if (total == 0xDEADBEEFu) {
        results[gid] = total;
    }
}
