#version 460
layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

shared uint lds[1280];

layout(set = 0, binding = 0) buffer OutputBuffer {
    uint results[];
};

layout(push_constant) uniform PushConstants {
    uint stride;
    uint iterations;
} pc;

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint gid = gl_GlobalInvocationID.x;

    // Initialize shared memory with a uniform multiple of 32 (32 banks) so that
    // adding acc0 to base_addr keeps the loop-carried dependency live without
    // scrambling per-lane bank offsets (base_addr mod 32 remains (tid * stride) mod 32).
    for (uint i = tid; i < 1280u; i += 32u) {
        lds[i] = 32u;
    }
    barrier();

    uint stride = pc.stride;
    uint iters = pc.iterations;

    // Each lane accesses its target bank stride: (tid * stride) mod 32.
    // The 8 loads per iteration use constant +32u dword (+128-byte) index offsets from base_addr,
    // which preserve the exact same LDS bank ((tid * stride) mod 32) and allow RADV/ACO
    // to fold all offsets directly into `ds_load_2addr_b32` immediate dword offsets with zero
    // per-load VALU address arithmetic while keeping base_addr + 224u < 1280u.
    uint base_addr = (tid * stride) & 1023u;
    uint acc0 = 0u;
    uint acc1 = 0u;
    uint acc2 = 0u;
    uint acc3 = 0u;
    uint acc4 = 0u;
    uint acc5 = 0u;
    uint acc6 = 0u;
    uint acc7 = 0u;

    for (uint i = 0u; i < iters; i++) {
        acc0 += lds[base_addr + 0u];
        acc1 += lds[base_addr + 32u];
        acc2 += lds[base_addr + 64u];
        acc3 += lds[base_addr + 96u];
        acc4 += lds[base_addr + 128u];
        acc5 += lds[base_addr + 160u];
        acc6 += lds[base_addr + 192u];
        acc7 += lds[base_addr + 224u];
        base_addr = (base_addr + acc0) & 1023u;
    }

    uint total = acc0 + acc1 + acc2 + acc3 + acc4 + acc5 + acc6 + acc7;
    results[gid] = total;
}
