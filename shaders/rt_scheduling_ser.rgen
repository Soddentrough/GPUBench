#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_shader_invocation_reorder : require
#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(location = 0) rayPayloadEXT vec3 payload;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1) buffer Results {
    uint totalRays;
    uint totalHits;
    uint accumulatedLuminance;
} results;

layout(set = 0, binding = 2) buffer Framebuffer {
    vec4 pixels[];
} fb;

layout(set = 0, binding = 3) readonly buffer VertexBuffer {
    float vertices[];
} vbuf;

#define BINDING_MAT_BUF 4
#define BINDING_TRI_MAT_BUF 5
#define BINDING_TEX_HDR_BUF 6
#define BINDING_TEX_PIX_BUF 7
#include "pbr_common.glsl"

layout(push_constant) uniform PushConstants {
    uint rayCount;
    uint mode;
    uint bounces;
    uint seed;
    uint dumpRenders;
    uint width;
    uint height;
    uint spatialPattern;
    uint sceneType;
    uint isGltf;
    uint spp;
    uint sampleIdx;
} pc;

const uint SCENE_SHOWROOM_STUDIO = 0u;
const uint SCENE_OUTDOOR_TERRAIN = 1u;
const uint SCENE_INDOOR_ATRIUM   = 2u;
const uint SCENE_REACTOR_BAY     = 3u;

uint hash(uint seed) {
    seed = (seed ^ 61) ^ (seed >> 16);
    seed *= 9;
    seed = seed ^ (seed >> 4);
    seed *= 0x27d4eb2d;
    seed = seed ^ (seed >> 15);
    return seed;
}

void getCamera(uint sceneType, out vec3 camPos, out vec3 camForward, out vec3 camRight, out vec3 camUp, out float fov) {
    if (pc.isGltf != 0u) {
        if (sceneType == SCENE_REACTOR_BAY) {
            camPos = vec3(0.0, -21.0, 4.15);
            camForward = normalize(vec3(0.0, 5.2, 6.2) - camPos);
            camRight = normalize(cross(camForward, vec3(0.0, 0.0, 1.0)));
            camUp = cross(camRight, camForward);
            fov = 0.62;
            return;
        } else if (sceneType == SCENE_INDOOR_ATRIUM) {
            camPos = vec3(-1150.0, 280.0, -40.0);
            camForward = normalize(vec3(1.0, 0.02, 0.0));
            camRight = vec3(0.0, 0.0, -1.0);
            camUp = vec3(0.0, 1.0, 0.0);
            fov = 0.55;
            return;
        } else if (sceneType == SCENE_SHOWROOM_STUDIO) {
            camPos = vec3(360.0, 160.0, 420.0);
            vec3 target = vec3(0.0, 30.0, 0.0);
            camForward = normalize(target - camPos);
            camRight = normalize(cross(camForward, vec3(0.0, 1.0, 0.0)));
            camUp = cross(camRight, camForward);
            fov = 0.45;
            return;
        }
    }
    if (sceneType == SCENE_OUTDOOR_TERRAIN) {
        camPos = vec3(0.0, -320.0, 75.0);
        camForward = vec3(0.0, 0.997375, -0.072412);
        camRight = vec3(1.0, 0.0, 0.0);
        camUp = vec3(0.0, 0.072412, 0.997375);
        fov = 0.45;
    } else if (sceneType == SCENE_INDOOR_ATRIUM) {
        camPos = vec3(0.0, -9.6, 1.2);
        camForward = normalize(vec3(0.0, 9.6, 0.6));
        camRight = vec3(1.0, 0.0, 0.0);
        camUp = normalize(cross(camRight, camForward));
        fov = 0.65;
    } else {
        camPos = vec3(-0.5081, -8.1276, 1.5591);
        camForward = vec3(0.0562, 0.9852, -0.1622);
        camRight = vec3(0.9984, -0.0570, 0.0000);
        camUp = vec3(0.0092, 0.1619, 0.9868);
        fov = 0.2155;
    }
}

vec3 tonemapACES(vec3 x) {
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    vec3 mapped = clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
    return pow(mapped, vec3(1.0 / 2.2));
}

void computePixelCoords(uint idx, uint pattern, uint width, uint height, out uint px_u, out uint py_u) {
    if (pattern == 1) {
        uint tilesX = (width + 7) / 8;
        uint tileIdx = idx / 32;
        uint inTile = idx % 32;
        uint tileX = tileIdx % tilesX;
        uint tileY = tileIdx / tilesX;
        px_u = tileX * 8 + (inTile % 8);
        py_u = tileY * 4 + (inTile / 8);
    } else if (pattern == 2) {
        uint tilesX = (width + 7u) >> 3u;
        uint tilesY = (height + 3u) >> 2u;
        uint tileIdx = idx >> 5u;
        uint inTile = idx & 31u;
        uint tileX, tileY;
        if (pc.isGltf != 0u && (tilesX & 7u) == 0u && (tilesY & 3u) == 0u) {
            uint macroX = tilesX >> 3u;
            uint macroIdx = tileIdx >> 5u;
            uint inMacro = tileIdx & 31u;
            uint subX = ((inMacro >> 0u) & 1u) | (((inMacro >> 2u) & 1u) << 1u) | (((inMacro >> 4u) & 1u) << 2u);
            uint subY = ((inMacro >> 1u) & 1u) | (((inMacro >> 3u) & 1u) << 1u);
            tileX = (macroIdx % macroX) * 8u + subX;
            tileY = (macroIdx / macroX) * 4u + subY;
        } else if ((tilesX & 3u) == 0u && (tilesY & 1u) == 0u) {
            uint macroX = tilesX >> 2u;
            uint macroIdx = tileIdx >> 3u;
            uint inMacro = tileIdx & 7u;
            tileX = (macroIdx % macroX) * 4u + (inMacro & 3u);
            tileY = (macroIdx / macroX) * 2u + (inMacro >> 2u);
        } else {
            tileX = tileIdx % tilesX;
            tileY = tileIdx / tilesX;
        }
        uint mx = ((inTile >> 0u) & 1u) | (((inTile >> 2u) & 1u) << 1u) | (((inTile >> 4u) & 1u) << 2u);
        uint my = ((inTile >> 1u) & 1u) | (((inTile >> 3u) & 1u) << 1u);
        px_u = tileX * 8u + mx;
        py_u = tileY * 4u + my;
    } else if (pattern == 3) {
        uint tilesX = (width + 3) / 4;
        uint tileIdx = idx / 32;
        uint inTile = idx % 32;
        uint tileX = tileIdx % tilesX;
        uint tileY = tileIdx / tilesX;
        uint mx = ((inTile >> 0) & 1) | (((inTile >> 2) & 1) << 1);
        uint my = ((inTile >> 1) & 1) | (((inTile >> 3) & 1) << 1) | (((inTile >> 4) & 1) << 2);
        px_u = tileX * 4 + mx;
        py_u = tileY * 8 + my;
    } else {
        px_u = idx % width;
        py_u = idx / width;
    }
}

vec3 alignToNormalSer(vec3 localDir, vec3 n) {
    vec3 up = abs(n.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, n));
    vec3 bitangent = cross(n, tangent);
    return normalize(tangent * localDir.x + bitangent * localDir.y + n * localDir.z);
}

void main() {
    uint idx = gl_LaunchIDEXT.x;
    if (idx >= pc.rayCount) return;

    vec3 camPos, camForward, camRight, camUp;
    float fov;
    getCamera(pc.sceneType, camPos, camForward, camRight, camUp, fov);

    uint px_u, py_u;
    computePixelCoords(idx, pc.spatialPattern, pc.width, pc.height, px_u, py_u);
    uint pixelIdx = py_u * pc.width + px_u;

    float halfH = float(pc.height) * 0.5;
    float px = float(px_u) - float(pc.width) * 0.5 + 0.5;
    float py = float(py_u) - halfH + 0.5;
    vec3 rayDir = normalize(camForward + (px / halfH * fov) * camRight - (py / halfH * fov) * camUp);
    vec3 rayOrigin = camPos;
    float tMaxPrimary = (pc.isGltf != 0u) ? 5000.0 : ((pc.sceneType == SCENE_OUTDOOR_TERRAIN) ? 2500.0 : 50.0);
    float tMinPrimary = (pc.isGltf != 0u) ? 0.1 : ((pc.sceneType == SCENE_OUTDOOR_TERRAIN) ? 0.05 : 0.01);

    uint myRays = 0u;
    uint myHits = 0u;
    vec3 pixelColor = vec3(0.0);

    if (pc.mode == 4u) {
        // Mode 4: Pure Material Shading (SER coherence hint, zero BVH trace matching MK/DGC)
        myRays = 1u;
        myHits = 1u;
        uint matHint = idx % 8u;
        hitObjectEXT emptyObj;
        hitObjectRecordEmptyEXT(emptyObj);
        reorderThreadEXT(emptyObj, matHint, 3u);

        uint rngState = idx + pc.seed;
        vec3 dummyPos = vec3(float(px_u) * 0.01, float(py_u) * 0.01, 1.5);
        vec3 dummyNorm = ((idx % 2u) == 0u) ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
        if (pc.isGltf != 0u) {
            GltfMaterialGpu mat = matBuf.materials[matHint];
            mat.archetype = matHint;
            vec4 dummyTan = vec4(1.0, 0.0, 0.0, 1.0);
            vec2 dummyUv = vec2(float(px_u) / float(pc.width), float(py_u) / float(pc.height));
            pixelColor = evaluateGltfPbr(mat, dummyPos, dummyNorm, dummyNorm, dummyTan, dummyUv, rayDir, pc.sceneType, false, rngState);
        } else {
            vec3 sunDir, sunColor;
            getSceneSunParams(pc.sceneType, sunDir, sunColor);
            vec3 baseColor = getSceneArchetypeAlbedo(pc.sceneType, matHint);
            pixelColor = evaluateMaterialArchetypeDirect(matHint, dummyPos, baseColor, 0.5, 0.0, 1.5, dummyNorm, -rayDir, sunDir, sunColor, 1.0);
        }
    } else if (pc.mode == 1u) {
        // Mode 1: Multi-Bounce Path Tracing with SER (NEE + BSDF bounce matching MK/DGC)
        uint totalSpp = max(1u, pc.spp);
        uint rngState = pixelIdx + pc.seed;
        float jx = (totalSpp == 1u) ? 0.0 : (rand_float_pbr(rngState) - 0.5);
        float jy = (totalSpp == 1u) ? 0.0 : (rand_float_pbr(rngState) - 0.5);
        vec3 curOrigin = rayOrigin;
        vec3 curDir = normalize(camForward + ((px + jx) / halfH * fov) * camRight - ((py + jy) / halfH * fov) * camUp);
        vec3 throughput = vec3(1.0);
        uint totalBounces = max(1u, pc.bounces);
        float surfEps = (pc.isGltf != 0u) ? 0.05 : 0.005;

        for (uint b = 0u; b < totalBounces; ++b) {
            myRays++;
            payload = vec3(0.0);
            hitObjectEXT hObj;
            hitObjectTraceRayEXT(hObj, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0,
                                 curOrigin, (b == 0u ? tMinPrimary : surfEps), curDir, tMaxPrimary, 0);
            reorderThreadEXT(hObj);
            hitObjectExecuteShaderEXT(hObj, 0);

            if (hitObjectIsHitEXT(hObj)) {
                myHits++;
                pixelColor += throughput * max(payload, vec3(0.0));

                float tHit = hitObjectGetRayTMaxEXT(hObj);
                uint primId = uint(hitObjectGetPrimitiveIndexEXT(hObj));
                vec3 hitPos = curOrigin + curDir * tHit;

                vec3 surfNormal = -curDir;
                vec3 surfAlbedo = vec3(0.72);
                float surfMetal = 0.0;
                float surfRough = 0.5;
                float surfTrans = 0.0;

                if (pc.isGltf != 0u) {
                    uint base = primId * 36u;
                    vec3 p0 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
                    vec3 p1 = vec3(vbuf.vertices[base + 12], vbuf.vertices[base + 13], vbuf.vertices[base + 14]);
                    vec3 p2 = vec3(vbuf.vertices[base + 24], vbuf.vertices[base + 25], vbuf.vertices[base + 26]);
                    surfNormal = normalize(cross(p1 - p0, p2 - p0));
                    if (dot(surfNormal, curDir) > 0.0) surfNormal = -surfNormal;

                    uint matId = triMatBuf.triangleMats[primId];
                    GltfMaterialGpu mat = matBuf.materials[matId];
                    surfAlbedo = mat.baseColorFactor.rgb;
                    surfMetal = clamp(mat.metallicFactor, 0.0, 1.0);
                    surfRough = clamp(mat.roughnessFactor, 0.04, 1.0);
                    surfTrans = mat.transmissionFactor;
                    if (surfTrans > 0.5 || mat.archetype == 2u) break;
                } else {
                    uint base = primId * 9u;
                    vec3 p0 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
                    vec3 p1 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);
                    vec3 p2 = vec3(vbuf.vertices[base + 6], vbuf.vertices[base + 7], vbuf.vertices[base + 8]);
                    surfNormal = normalize(cross(p1 - p0, p2 - p0));
                    if (dot(surfNormal, curDir) > 0.0) surfNormal = -surfNormal;
                    uint arch = (pc.sceneType == 1u) ? ((primId < 32768u) ? 4u : ((primId < 34816u) ? 2u : 1u)) : (primId % 8u);
                    surfAlbedo = getSceneArchetypeAlbedo(pc.sceneType, arch);
                }

                if (b >= 2u) {
                    float p = clamp(max(throughput.r, max(throughput.g, throughput.b)), 0.05, 0.95);
                    if (rand_float_pbr(rngState) > p) break;
                    throughput /= p;
                }

                float u1 = rand_float_pbr(rngState);
                float u2 = rand_float_pbr(rngState);
                if (surfMetal > 0.1 && u2 < surfMetal) {
                    vec3 refl = reflect(curDir, surfNormal);
                    vec3 jitter = (vec3(u1, u2, fract(u1 * 31.7)) * 2.0 - 1.0) * (surfRough * 0.4);
                    curDir = normalize(refl + jitter);
                    if (dot(curDir, surfNormal) <= 0.0) curDir = refl;
                    throughput *= mix(vec3(0.04), surfAlbedo, surfMetal);
                } else {
                    float r = sqrt(u1);
                    float theta = 6.28318530718 * u2;
                    vec3 localDir = vec3(r * cos(theta), r * sin(theta), sqrt(max(0.0, 1.0 - u1)));
                    curDir = alignToNormalSer(localDir, surfNormal);
                    throughput *= (1.0 - surfMetal) * surfAlbedo;
                }
                curOrigin = hitPos + surfNormal * surfEps;
            } else {
                pixelColor += throughput * abs(payload);
                break;
            }
        }

        if (pc.dumpRenders != 0u) {
            float expGain = (pc.sceneType == SCENE_INDOOR_ATRIUM) ? 1.6 : 1.0;
            uint sampleIdx = pc.sampleIdx;
            if (totalSpp <= 1u) {
                fb.pixels[pixelIdx] = vec4(tonemapACES(pixelColor * expGain), 1.0);
            } else if (sampleIdx == 0u) {
                fb.pixels[pixelIdx] = vec4(pixelColor, 1.0);
            } else if (sampleIdx < totalSpp - 1u) {
                fb.pixels[pixelIdx] += vec4(pixelColor, 0.0);
            } else {
                vec3 total = fb.pixels[pixelIdx].rgb + pixelColor;
                fb.pixels[pixelIdx] = vec4(tonemapACES((total / float(totalSpp)) * expGain), 1.0);
            }
            uint waveRays = subgroupAdd(myRays);
            uint waveHits = subgroupAdd(myHits);
            uint waveLum = subgroupAdd(uint(clamp(dot(pixelColor, vec3(0.2126, 0.7152, 0.0722)), 0.0, 1000.0) * 256.0) + 1u);
            if (subgroupElect()) {
                if (waveRays > 0u) atomicAdd(results.totalRays, waveRays);
                if (waveHits > 0u) atomicAdd(results.totalHits, waveHits);
                if (pc.dumpRenders == 0u && waveLum > 0u) atomicAdd(results.accumulatedLuminance, waveLum);
            }
            return;
        }
    } else if (pc.mode == 5u) {
        // Mode 5: Ray-Traced Shadow Rays with SER
        myRays++;
        payload = vec3(0.0);
        hitObjectEXT hObj;
        hitObjectTraceRayEXT(hObj, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, rayOrigin, tMinPrimary, rayDir, tMaxPrimary, 0);
        reorderThreadEXT(hObj);

        if (hitObjectIsHitEXT(hObj)) {
            myHits++;
            hitObjectExecuteShaderEXT(hObj, 0);
            float tHit = hitObjectGetRayTMaxEXT(hObj);
            vec3 hitPos = rayOrigin + rayDir * tHit;
            vec3 sunDir = normalize(vec3(0.45, 0.35, 0.82));
            if (pc.sceneType == SCENE_INDOOR_ATRIUM) {
                sunDir = normalize(vec3(0.35, 0.90, -0.25));
            } else if (pc.sceneType == SCENE_SHOWROOM_STUDIO) {
                sunDir = normalize(vec3(0.6, 0.8, 0.5));
            } else if (pc.sceneType == SCENE_REACTOR_BAY) {
                sunDir = normalize(vec3(0.24, -0.22, 0.945));
            }

            myRays++;
            hitObjectEXT sObj;
            hitObjectTraceRayEXT(sObj, topLevelAS, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0xFF, 0, 0, 0, hitPos + sunDir * 0.05, 0.01, sunDir, 2500.0, 0);
            reorderThreadEXT(sObj);
            bool shadowed = hitObjectIsHitEXT(sObj);
            pixelColor = shadowed ? vec3(0.1) : payload;
        }
    } else if (pc.mode == 2u) {
        // Mode 2: Incoherent Secondary Diffuse GI with SER
        myRays++;
        payload = vec3(0.0);
        hitObjectEXT hObj;
        hitObjectTraceRayEXT(hObj, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, rayOrigin, tMinPrimary, rayDir, tMaxPrimary, 0);
        reorderThreadEXT(hObj);

        if (hitObjectIsHitEXT(hObj)) {
            myHits++;
            hitObjectExecuteShaderEXT(hObj, 0);
            float tHit = hitObjectGetRayTMaxEXT(hObj);
            vec3 hitPos = rayOrigin + rayDir * tHit;

            uint s1 = hash(pixelIdx + pc.seed);
            uint s2 = hash(s1);
            float u1 = float(s1 % 10000u) / 10000.0;
            float u2 = float(s2 % 10000u) / 10000.0;
            float theta = 6.28318530718 * u1;
            float phi = acos(clamp(1.0 - 2.0 * u2, -1.0, 1.0));
            vec3 scatterDir = normalize(vec3(sin(phi) * cos(theta), sin(phi) * sin(theta), cos(phi)));

            myRays++;
            hitObjectEXT gObj;
            hitObjectTraceRayEXT(gObj, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, hitPos + scatterDir * 0.05, 0.01, scatterDir, 100.0, 0);
            reorderThreadEXT(gObj);
            if (hitObjectIsHitEXT(gObj)) {
                myHits++;
                hitObjectExecuteShaderEXT(gObj, 0);
            }
            pixelColor = payload;
        }
    } else {
        // Mode 0 & 7: Full Frame (with secondary rays & SER coherence) or Primary Rays G-Buffer
        myRays++;
        payload = vec3(0.0);
        hitObjectEXT hObj;
        hitObjectTraceRayEXT(hObj, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, rayOrigin, tMinPrimary, rayDir, tMaxPrimary, 0);
        reorderThreadEXT(hObj);
        hitObjectExecuteShaderEXT(hObj, 0);
        if (hitObjectIsHitEXT(hObj)) myHits++;
        pixelColor = abs(payload);
    }

    if (pc.dumpRenders != 0) {
        if (pc.mode == 7u) {
            vec3 outCol = (myHits > 0u) ? pixelColor : vec3(0.04, 0.05, 0.08);
            fb.pixels[pixelIdx] = vec4(outCol, 1.0);
        } else {
            fb.pixels[pixelIdx] = vec4(tonemapACES(pixelColor * 1.0), 1.0);
        }
    }

    uint waveRays = subgroupAdd(myRays);
    uint waveHits = subgroupAdd(myHits);
    uint waveLum = subgroupAdd(uint(clamp(dot(pixelColor, vec3(0.2126, 0.7152, 0.0722)), 0.0, 1000.0) * 256.0) + 1u);
    if (subgroupElect()) {
        if (waveRays > 0u) atomicAdd(results.totalRays, waveRays);
        if (waveHits > 0u) atomicAdd(results.totalHits, waveHits);
        if (pc.dumpRenders == 0u && waveLum > 0u) atomicAdd(results.accumulatedLuminance, waveLum);
    }
}
