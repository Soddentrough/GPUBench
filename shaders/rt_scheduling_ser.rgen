#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_shader_invocation_reorder : require
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(location = 0) rayPayloadEXT vec3 payload;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1) buffer Results {
    uint totalRays;
    uint totalHits;
    float accumulatedLuminance;
} results;

layout(set = 0, binding = 2) buffer Framebuffer {
    vec4 pixels[];
} fb;

layout(push_constant) uniform PushConstants {
    uint rayCount;
    uint mode;
    uint bounces;
    uint seed;
    uint dumpRenders;
    uint width;
    uint height;
    uint spatialPattern;
    uint sceneType;
    uint isGltf;
    uint spp;
    uint sampleIdx;
} pc;

const uint SCENE_SHOWROOM_STUDIO = 0u;
const uint SCENE_OUTDOOR_TERRAIN = 1u;
const uint SCENE_INDOOR_ATRIUM   = 2u;
const uint SCENE_AAA_FOREST       = 3u;

uint hash(uint seed) {
    seed = (seed ^ 61) ^ (seed >> 16);
    seed *= 9;
    seed = seed ^ (seed >> 4);
    seed *= 0x27d4eb2d;
    seed = seed ^ (seed >> 15);
    return seed;
}

void getCamera(uint sceneType, out vec3 camPos, out vec3 camForward, out vec3 camRight, out vec3 camUp, out float fov) {
    if (pc.isGltf != 0u) {
        if (sceneType == SCENE_AAA_FOREST) {
            camPos = vec3(0.0, -18.0, 0.55);
            camForward = normalize(vec3(0.0, 33.0, 1.2));
            camRight = normalize(cross(camForward, vec3(0.0, 0.0, 1.0)));
            camUp = cross(camRight, camForward);
            fov = 0.65;
            return;
        } else if (sceneType == SCENE_INDOOR_ATRIUM) {
            camPos = vec3(-1150.0, 280.0, -40.0);
            camForward = normalize(vec3(1.0, 0.02, 0.0));
            camRight = vec3(0.0, 0.0, -1.0);
            camUp = vec3(0.0, 1.0, 0.0);
            fov = 0.55;
            return;
        } else if (sceneType == SCENE_SHOWROOM_STUDIO) {
            camPos = vec3(360.0, 160.0, 420.0);
            vec3 target = vec3(0.0, 30.0, 0.0);
            camForward = normalize(target - camPos);
            camRight = normalize(cross(camForward, vec3(0.0, 1.0, 0.0)));
            camUp = cross(camRight, camForward);
            fov = 0.45;
            return;
        }
    }
    if (sceneType == SCENE_OUTDOOR_TERRAIN) {
        camPos = vec3(0.0, -320.0, 75.0);
        camForward = vec3(0.0, 0.997375, -0.072412);
        camRight = vec3(1.0, 0.0, 0.0);
        camUp = vec3(0.0, 0.072412, 0.997375);
        fov = 0.45;
    } else if (sceneType == SCENE_INDOOR_ATRIUM) {
        camPos = vec3(0.0, -9.6, 1.2);
        camForward = normalize(vec3(0.0, 9.6, 0.6));
        camRight = vec3(1.0, 0.0, 0.0);
        camUp = normalize(cross(camRight, camForward));
        fov = 0.65;
    } else {
        camPos = vec3(-0.5081, -8.1276, 1.5591);
        camForward = vec3(0.0562, 0.9852, -0.1622);
        camRight = vec3(0.9984, -0.0570, 0.0000);
        camUp = vec3(0.0092, 0.1619, 0.9868);
        fov = 0.2155;
    }
}

vec3 tonemapACES(vec3 x) {
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    vec3 mapped = clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
    return pow(mapped, vec3(1.0 / 2.2));
}

void computePixelCoords(uint idx, uint pattern, uint width, uint height, out uint px_u, out uint py_u) {
    if (pattern == 1) {
        uint tilesX = (width + 7) / 8;
        uint tileIdx = idx / 32;
        uint inTile = idx % 32;
        uint tileX = tileIdx % tilesX;
        uint tileY = tileIdx / tilesX;
        px_u = tileX * 8 + (inTile % 8);
        py_u = tileY * 4 + (inTile / 8);
    } else if (pattern == 2) {
        uint tilesX = (width + 7) / 8;
        uint tileIdx = idx / 32;
        uint inTile = idx % 32;
        uint tileX = tileIdx % tilesX;
        uint tileY = tileIdx / tilesX;
        uint mx = ((inTile >> 0) & 1) | (((inTile >> 2) & 1) << 1) | (((inTile >> 4) & 1) << 2);
        uint my = ((inTile >> 1) & 1) | (((inTile >> 3) & 1) << 1);
        px_u = tileX * 8 + mx;
        py_u = tileY * 4 + my;
    } else if (pattern == 3) {
        uint tilesX = (width + 3) / 4;
        uint tileIdx = idx / 32;
        uint inTile = idx % 32;
        uint tileX = tileIdx % tilesX;
        uint tileY = tileIdx / tilesX;
        uint mx = ((inTile >> 0) & 1) | (((inTile >> 2) & 1) << 1);
        uint my = ((inTile >> 1) & 1) | (((inTile >> 3) & 1) << 1) | (((inTile >> 4) & 1) << 2);
        px_u = tileX * 4 + mx;
        py_u = tileY * 8 + my;
    } else {
        px_u = idx % width;
        py_u = idx / width;
    }
}

void main() {
    uint idx = gl_LaunchIDEXT.x;
    if (idx >= pc.rayCount) return;

    vec3 camPos, camForward, camRight, camUp;
    float fov;
    getCamera(pc.sceneType, camPos, camForward, camRight, camUp, fov);

    uint px_u, py_u;
    computePixelCoords(idx, pc.spatialPattern, pc.width, pc.height, px_u, py_u);
    uint pixelIdx = py_u * pc.width + px_u;

    float halfH = float(pc.height) * 0.5;
    float px = float(px_u) - float(pc.width) * 0.5 + 0.5;
    float py = float(py_u) - halfH + 0.5;
    vec3 rayDir = normalize(camForward + (px / halfH * fov) * camRight - (py / halfH * fov) * camUp);
    vec3 rayOrigin = camPos;
    float tMaxPrimary = (pc.isGltf != 0u) ? 5000.0 : ((pc.sceneType == SCENE_OUTDOOR_TERRAIN) ? 2500.0 : 50.0);
    float tMinPrimary = (pc.isGltf != 0u) ? 0.1 : ((pc.sceneType == SCENE_OUTDOOR_TERRAIN) ? 0.05 : 0.01);

    uint myRays = 0u;
    uint myHits = 0u;
    vec3 pixelColor = vec3(0.0);

    if (pc.mode == 1u) {
        // Mode 1: Multi-Bounce Path Tracing with SER
        vec3 curOrigin = rayOrigin;
        vec3 curDir = rayDir;
        vec3 throughput = vec3(1.0);
        uint totalBounces = max(1u, pc.bounces);
        uint rngState = pixelIdx + pc.seed;

        for (uint b = 0u; b < totalBounces; ++b) {
            myRays++;
            payload = vec3(0.0);
            hitObjectEXT hObj;
            hitObjectTraceRayEXT(hObj, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, curOrigin, (b == 0u ? tMinPrimary : 0.05), curDir, tMaxPrimary, 0);
            reorderThreadEXT(hObj);
            
            if (hitObjectIsHitEXT(hObj)) {
                myHits++;
                hitObjectExecuteShaderEXT(hObj, 0);
                pixelColor += throughput * payload;

                if (b >= 2u) {
                    float p = max(throughput.r, max(throughput.g, throughput.b));
                    if (float(hash(rngState + b) % 1000u) / 1000.0 > p) break;
                    throughput /= max(p, 0.01);
                }

                float tHit = hitObjectGetRayTMaxEXT(hObj);
                curOrigin = curOrigin + curDir * tHit;
                uint s1 = hash(rngState + b * 2u);
                uint s2 = hash(s1);
                float u1 = float(s1 % 10000u) / 10000.0;
                float u2 = float(s2 % 10000u) / 10000.0;
                float theta = 6.28318530718 * u1;
                float phi = acos(clamp(1.0 - 2.0 * u2, -1.0, 1.0));
                curDir = normalize(vec3(sin(phi) * cos(theta), sin(phi) * sin(theta), cos(phi)));
                throughput *= 0.7;
            } else {
                break;
            }
        }
    } else if (pc.mode == 5u) {
        // Mode 5: Ray-Traced Shadow Rays with SER
        myRays++;
        payload = vec3(0.0);
        hitObjectEXT hObj;
        hitObjectTraceRayEXT(hObj, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, rayOrigin, tMinPrimary, rayDir, tMaxPrimary, 0);
        reorderThreadEXT(hObj);

        if (hitObjectIsHitEXT(hObj)) {
            myHits++;
            hitObjectExecuteShaderEXT(hObj, 0);
            float tHit = hitObjectGetRayTMaxEXT(hObj);
            vec3 hitPos = rayOrigin + rayDir * tHit;
            vec3 sunDir = normalize(vec3(0.45, 0.35, 0.82));
            if (pc.sceneType == SCENE_INDOOR_ATRIUM) {
                sunDir = normalize(vec3(0.35, 0.90, -0.25));
            } else if (pc.sceneType == SCENE_SHOWROOM_STUDIO) {
                sunDir = normalize(vec3(0.6, 0.8, 0.5));
            }

            myRays++;
            hitObjectEXT sObj;
            hitObjectTraceRayEXT(sObj, topLevelAS, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0xFF, 0, 0, 0, hitPos + sunDir * 0.05, 0.01, sunDir, 2500.0, 0);
            reorderThreadEXT(sObj);
            bool shadowed = hitObjectIsHitEXT(sObj);
            pixelColor = shadowed ? vec3(0.1) : payload;
        }
    } else if (pc.mode == 2u) {
        // Mode 2: Incoherent Secondary Diffuse GI with SER
        myRays++;
        payload = vec3(0.0);
        hitObjectEXT hObj;
        hitObjectTraceRayEXT(hObj, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, rayOrigin, tMinPrimary, rayDir, tMaxPrimary, 0);
        reorderThreadEXT(hObj);

        if (hitObjectIsHitEXT(hObj)) {
            myHits++;
            hitObjectExecuteShaderEXT(hObj, 0);
            float tHit = hitObjectGetRayTMaxEXT(hObj);
            vec3 hitPos = rayOrigin + rayDir * tHit;

            uint s1 = hash(pixelIdx + pc.seed);
            uint s2 = hash(s1);
            float u1 = float(s1 % 10000u) / 10000.0;
            float u2 = float(s2 % 10000u) / 10000.0;
            float theta = 6.28318530718 * u1;
            float phi = acos(clamp(1.0 - 2.0 * u2, -1.0, 1.0));
            vec3 scatterDir = normalize(vec3(sin(phi) * cos(theta), sin(phi) * sin(theta), cos(phi)));

            myRays++;
            hitObjectEXT gObj;
            hitObjectTraceRayEXT(gObj, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, hitPos + scatterDir * 0.05, 0.01, scatterDir, 100.0, 0);
            reorderThreadEXT(gObj);
            if (hitObjectIsHitEXT(gObj)) {
                myHits++;
                hitObjectExecuteShaderEXT(gObj, 0);
            }
            pixelColor = payload;
        }
    } else {
        // Mode 0 & 4: Primary Ray Tracing / Material Shading with SER
        myRays++;
        payload = vec3(0.0);
        hitObjectEXT hObj;
        hitObjectTraceRayEXT(hObj, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, rayOrigin, tMinPrimary, rayDir, tMaxPrimary, 0);
        reorderThreadEXT(hObj);
        hitObjectExecuteShaderEXT(hObj, 0);
        if (hitObjectIsHitEXT(hObj)) myHits++;
        pixelColor = payload;
    }

    if (pc.dumpRenders != 0) {
        fb.pixels[pixelIdx] = vec4(tonemapACES(pixelColor * 1.0), 1.0);
    }

    uint waveRays = subgroupAdd(myRays);
    uint waveHits = subgroupAdd(myHits);
    if (subgroupElect()) {
        if (waveRays > 0u) atomicAdd(results.totalRays, waveRays);
        if (waveHits > 0u) atomicAdd(results.totalHits, waveHits);
    }
}
