#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer WeightBuffer {
    float16_t weights[];
} weightBuf;

layout(std430, set = 0, binding = 1) readonly buffer BiasBuffer {
    float16_t biases[];
} biasBuf;

layout(std430, set = 0, binding = 2) buffer OutputBuffer {
    float16_t outVals[];
} outBuf;

layout(push_constant) uniform PushConsts {
    uint numThreads;
    uint iterations;
} pc;

void main() {
    uint tid = gl_GlobalInvocationID.x;
    if (tid >= pc.numThreads) {
        return;
    }

    float16_t v[16];
    for (uint c = 0u; c < 16u; ++c) {
        v[c] = float16_t(0.0625 * float((tid + c) & 15u) + 0.125);
    }

    // Standard per-invocation 16x16 FP16 MLP layers via packed f16vec2 FMA (2*16*16 = 512 FLOPs/layer)
    for (uint it = 0u; it < pc.iterations; ++it) {
        float16_t nextV[16];
        for (uint r = 0u; r < 16u; ++r) {
            uint rowBase = r * 16u;
            f16vec2 acc = f16vec2(float16_t(0.0), float16_t(0.0));
            for (uint c = 0u; c < 16u; c += 2u) {
                f16vec2 w = f16vec2(weightBuf.weights[rowBase + c], weightBuf.weights[rowBase + c + 1u]);
                f16vec2 x = f16vec2(v[c], v[c + 1u]);
                acc = fma(w, x, acc);
            }
            float16_t sum = (acc.x + acc.y) + biasBuf.biases[r];
            nextV[r] = max(sum, sum * float16_t(0.125));
        }
        for (uint r = 0u; r < 16u; ++r) {
            v[r] = nextV[r];
        }
    }

    uint baseOut = (tid & 4095u) * 16u;
    for (uint c = 0u; c < 16u; ++c) {
        outBuf.outVals[baseOut + c] = v[c];
    }
}
