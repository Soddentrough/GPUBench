#version 460
#extension GL_EXT_ray_query : require
#extension GL_KHR_shader_subgroup_ballot : enable

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1) writeonly buffer ResultBuffer {
    uint hits[];
} results;

layout(push_constant) uniform PushConstants {
    uint rayCount;
    uint mode;
    float tMin;
    float tMax;
} pc;

void main() {
    uint wgId = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    uint idx = wgId * 32u + gl_LocalInvocationID.x;
    if (idx >= pc.rayCount) return;

    // Conformal 2D mapping into geometry bounds [0.01, 0.99]
    uint rx = idx & 2047u;
    uint ry = (idx >> 11) & 2047u;
    float fx = float(rx) * (0.98 / 2047.0) + 0.01;
    float fy = float(ry) * (0.98 / 2047.0) + 0.01;

    vec3 origin = vec3(fx, fy, -1.0);
    vec3 direction = vec3(0.0, 0.0, 1.0);

    rayQueryEXT query;
    if (pc.mode == 0u) {
        // Coherent shallow traversal: opaque triangle fast path with immediate termination on Layer 0
        rayQueryInitializeEXT(query, topLevelAS,
                              gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
                              0xFF, origin, pc.tMin, direction, pc.tMax);
        while (rayQueryProceedEXT(query)) {}
    } else {
        // Deep multi-layer AABB BVH stress: traverse all 64 stratified VK_GEOMETRY_TYPE_AABBS_KHR layers
        // (z = 0.0 .. 6.3, t = 0.99 .. 7.31) and commit a generated procedural hit on Layer 63.
        rayQueryInitializeEXT(query, topLevelAS,
                              gl_RayFlagsNoneEXT,
                              0xFF, origin, pc.tMin, direction, pc.tMax);
        while (rayQueryProceedEXT(query)) {
            if (rayQueryGetIntersectionTypeEXT(query, false) == gl_RayQueryCandidateIntersectionAABBEXT &&
                (rayQueryGetIntersectionPrimitiveIndexEXT(query, false) >> 10u) == 63u &&
                rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
                rayQueryGenerateIntersectionEXT(query, 7.30);
            }
        }
    }

    bool hasHit = (rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT);
    uvec4 ballot = subgroupBallot(hasHit);
    if (subgroupElect()) {
        results.hits[wgId] = subgroupBallotBitCount(ballot);
    }
}
