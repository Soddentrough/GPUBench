#version 460
#extension GL_EXT_ray_query : require
#extension GL_KHR_shader_subgroup_ballot : enable

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1) writeonly buffer ResultBuffer {
    uint hits[];
} results;

layout(push_constant) uniform PushConstants {
    uint rayCount;
    uint mode;
    float tMin;
    float tMax;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.rayCount) return;

    // Conformal 2D mapping into geometry bounds [0.01, 0.99]
    uint rx = idx & 2047u;
    uint ry = (idx >> 11) & 2047u;
    float fx = float(rx) * (0.98 / 2047.0) + 0.01;
    float fy = float(ry) * (0.98 / 2047.0) + 0.01;

    vec3 origin = vec3(fx, fy, -1.0);
    vec3 direction = vec3(0.0, 0.0, 1.0);

    rayQueryEXT query;
    if (pc.mode == 0u) {
        // Coherent shallow traversal: opaque fast path with immediate termination on Layer 0
        rayQueryInitializeEXT(query, topLevelAS,
                              gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
                              0xFF, origin, pc.tMin, direction, pc.tMax);
        while (rayQueryProceedEXT(query)) {}
    } else {
        // Deep multi-layer BVH stress: traverse through all 128 stratified layers
        // (z = 0.0 .. 12.7, t = 1.0 .. 13.7) before committing the deepest layer hit
        rayQueryInitializeEXT(query, topLevelAS,
                              gl_RayFlagsNoOpaqueEXT,
                              0xFF, origin, pc.tMin, direction, pc.tMax);
        while (rayQueryProceedEXT(query)) {
            if (rayQueryGetIntersectionTEXT(query, false) >= 13.65) {
                rayQueryConfirmIntersectionEXT(query);
            }
        }
    }

    bool hasHit = (rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT);
    uvec4 ballot = subgroupBallot(hasHit);
    if (subgroupElect()) {
        results.hits[gl_WorkGroupID.x] = subgroupBallotBitCount(ballot);
    }
}
