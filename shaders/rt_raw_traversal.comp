#version 460
#extension GL_EXT_ray_query : require
#extension GL_KHR_shader_subgroup_ballot : enable

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(std430, set = 0, binding = 1) writeonly buffer ResultBuffer {
    uint hits[];
} results;
layout(std430, set = 0, binding = 2) readonly buffer SoftBvhBuffer {
    uvec4 nodes[];
} softBvh;

layout(push_constant) uniform PushConstants {
    uint rayCount;
    uint mode;
    float tMin;
    float tMax;
} pc;

void main() {
    uint wgId = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    uint idx = wgId * 32u + gl_LocalInvocationID.x;
    if (idx >= pc.rayCount) return;

    // Conformal 2D mapping into geometry bounds [0.01, 0.99]
    uint rx = idx & 2047u;
    uint ry = (idx >> 11) & 2047u;
    float fx = float(rx) * (0.98 / 2047.0) + 0.01;
    float fy = float(ry) * (0.98 / 2047.0) + 0.01;

    vec3 origin = vec3(fx, fy, -1.0);
    vec3 direction = vec3(0.0, 0.0, 1.0);

    bool hasHit = false;
    if (pc.mode == 0u) {
        // Coherent shallow traversal: opaque triangle fast path with immediate termination on Layer 0
        rayQueryEXT query;
        rayQueryInitializeEXT(query, topLevelAS,
                              gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
                              0xFF, origin, pc.tMin, direction, pc.tMax);
        while (rayQueryProceedEXT(query)) {}
        hasHit = (rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT);
    } else if (pc.mode == 1u) {
        // Deep multi-layer AABB BVH stress: traverse all 64 stratified VK_GEOMETRY_TYPE_AABBS_KHR layers
        // (z = 0.0 .. 6.3, t = 0.99 .. 7.31) and commit a generated procedural hit on Layer 63.
        rayQueryEXT query;
        rayQueryInitializeEXT(query, topLevelAS,
                              gl_RayFlagsNoneEXT,
                              0xFF, origin, pc.tMin, direction, pc.tMax);
        while (rayQueryProceedEXT(query)) {
            if (rayQueryGetIntersectionTypeEXT(query, false) == gl_RayQueryCandidateIntersectionAABBEXT &&
                (rayQueryGetIntersectionPrimitiveIndexEXT(query, false) >> 10u) == 63u &&
                rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
                rayQueryGenerateIntersectionEXT(query, 7.30);
            }
        }
        hasHit = (rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT);
    } else {
        // Software VALU binary BVH stack traversal over identical 65,536-box (32x32x64) hierarchy.
        vec3 swDir = vec3(pc.tMin * 1e-4, pc.tMin * 1e-4, 1.0);
        vec3 invDir = 1.0 / swDir;
        uint stack[24];
        int sp = 0;
        uint curr = 0u;
        uint visitedLeaves = 0u;
        bool hitLayer63 = false;
        float closestT = pc.tMax;
        while (curr != 0xFFFFFFFFu) {
            uvec4 n0 = softBvh.nodes[curr * 2u];
            uvec4 n1 = softBvh.nodes[curr * 2u + 1u];
            vec3 bmin = uintBitsToFloat(n0.xyz);
            vec3 bmax = uintBitsToFloat(n1.xyz);
            vec3 t0 = (bmin - origin) * invDir;
            vec3 t1 = (bmax - origin) * invDir;
            vec3 tsmall = min(t0, t1);
            vec3 tlarge = max(t0, t1);
            float tEnter = max(max(tsmall.x, tsmall.y), tsmall.z);
            float tExit = min(min(tlarge.x, tlarge.y), tlarge.z);
            if (tExit >= max(tEnter, pc.tMin) && tEnter <= closestT) {
                if ((n1.w & 0x80000000u) != 0u) {
                    visitedLeaves++;
                    if ((n0.w >> 10u) == 63u && !hitLayer63) {
                        closestT = 7.30;
                        hitLayer63 = true;
                    }
                    curr = (sp > 0) ? stack[--sp] : 0xFFFFFFFFu;
                } else {
                    if (sp < 24) {
                        stack[sp++] = n1.w;
                    }
                    curr = n0.w;
                }
            } else {
                curr = (sp > 0) ? stack[--sp] : 0xFFFFFFFFu;
            }
        }
        hasHit = (visitedLeaves == 64u && hitLayer63);
    }

    uvec4 ballot = subgroupBallot(hasHit);
    if (subgroupElect()) {
        results.hits[wgId] = subgroupBallotBitCount(ballot);
    }
}
