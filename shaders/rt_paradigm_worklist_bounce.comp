#version 460
#extension GL_EXT_ray_query : enable
#extension GL_EXT_ray_flags_primitive_culling : enable

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1) buffer Results {
    uint totalRays;
    uint totalHits;
    float accumulatedLuminance;
} results;

struct CompactRayPayload {
    vec4 originAndMatId;
    vec4 directionAndSeed;
    vec4 throughputAndMorton;
};

layout(set = 0, binding = 2) buffer WorkListBuffer {
    uint queueCounters[32];
    CompactRayPayload rayRecords[1048576];
} worklist;

layout(push_constant) uniform PushConstants {
    uint queueIndex;   // Queue index (0 for bounce compaction, or 0..7 for directional octants)
    uint maxQueueSize; // Base stride (e.g. 16384 for octants, or 0 for single queue)
} pc;

// Analytic Atmospheric Rayleigh-Mie Sky Model for Ray Miss Evaluation
vec3 evalAnalyticSky(vec3 dir) {
    vec3 sunDir = normalize(vec3(0.3, 0.6, 0.7));
    float cosTheta = clamp(dir.y, 0.0, 1.0);
    float cosGamma = dot(dir, sunDir);

    // Rayleigh scattering gradient (zenith deep blue -> horizon haze)
    vec3 zenithCol = vec3(0.08, 0.25, 0.65);
    vec3 horizonCol = vec3(0.65, 0.75, 0.88);
    float rayleighPhase = 0.75 * (1.0 + cosGamma * cosGamma);
    vec3 skyGrad = mix(horizonCol, zenithCol, pow(cosTheta, 0.45));

    // Mie scattering (forward solar aureole via Henyey-Greenstein)
    const float g = 0.78;
    const float g2 = g * g;
    float miePhase = (1.5 * (1.0 - g2) / (2.0 + g2)) * (1.0 + cosGamma * cosGamma) / pow(max(1.0 + g2 - 2.0 * g * cosGamma, 0.001), 1.5);
    vec3 sunColor = vec3(1.0, 0.9, 0.7) * 3.0;

    // Ground bounce reflection below horizon
    if (dir.y < 0.0) {
        vec3 groundCol = vec3(0.12, 0.10, 0.09);
        return mix(horizonCol * 0.5, groundCol, clamp(-dir.y * 2.0, 0.0, 1.0));
    }

    return skyGrad * rayleighPhase + sunColor * (miePhase * 0.05);
}

void main() {
    uint threadIdx = gl_GlobalInvocationID.x;
    uint activeCount = worklist.queueCounters[pc.queueIndex];
    if (threadIdx >= activeCount) return;

    uint recordIdx = pc.queueIndex * pc.maxQueueSize + threadIdx;
    CompactRayPayload payload = worklist.rayRecords[recordIdx];
    vec3 origin = payload.originAndMatId.xyz;
    vec3 direction = payload.directionAndSeed.xyz;

    rayQueryEXT query;
    rayQueryInitializeEXT(query, topLevelAS, gl_RayFlagsNoneEXT, 0xFF, origin, 0.001, direction, 20.0);
    while (rayQueryProceedEXT(query)) {}

    atomicAdd(results.totalRays, 1);

    if (rayQueryGetIntersectionTypeEXT(query, true) != 0) {
        atomicAdd(results.totalHits, 1);
    } else {
        vec3 sky = evalAnalyticSky(direction);
        uint lum = uint(dot(sky, vec3(299.0, 587.0, 114.0)));
        if (lum == 0xFFFFFFFFu) {
            atomicAdd(results.totalHits, 1);
        }
    }
}
