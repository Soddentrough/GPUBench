#version 460
// GPUBench Dual-Issue & Concurrency Benchmark Suite
// Config 5: Pure INT32 (Secondary Datapath Baseline)
// Evaluates integer ALU execution limits. On NVIDIA Ampere/Ada/Blackwell,
// INT32 arithmetic is constrained to Datapath 0 (halving peak issue rate relative to FP32).

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Data {
    float data[];
} InOutBuffer;

layout(push_constant) uniform PushConstants {
    float multiplier;
    uint num_elements;
} pushConstants;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pushConstants.num_elements) return;

    uint ubase = uint(InOutBuffer.data[index] * 1000.0) + index;

    // 16 independent INT32 accumulator chains
    uvec4 u0  = uvec4(ubase);
    uvec4 u1  = uvec4(ubase + 1u);
    uvec4 u2  = uvec4(ubase + 2u);
    uvec4 u3  = uvec4(ubase + 3u);
    uvec4 u4  = uvec4(ubase + 4u);
    uvec4 u5  = uvec4(ubase + 5u);
    uvec4 u6  = uvec4(ubase + 6u);
    uvec4 u7  = uvec4(ubase + 7u);
    uvec4 u8  = uvec4(ubase + 8u);
    uvec4 u9  = uvec4(ubase + 9u);
    uvec4 u10 = uvec4(ubase + 10u);
    uvec4 u11 = uvec4(ubase + 11u);
    uvec4 u12 = uvec4(ubase + 12u);
    uvec4 u13 = uvec4(ubase + 13u);
    uvec4 u14 = uvec4(ubase + 14u);
    uvec4 u15 = uvec4(ubase + 15u);

    uvec4 mu = uvec4(uint(pushConstants.multiplier));
    if (mu.x == 0u) mu = uvec4(1u);

    uvec4 cu0  = uvec4(13u, 17u, 19u, 23u);
    uvec4 cu1  = uvec4(29u, 31u, 37u, 41u);
    uvec4 cu2  = uvec4(43u, 47u, 53u, 59u);
    uvec4 cu3  = uvec4(61u, 67u, 71u, 73u);
    uvec4 cu4  = uvec4(79u, 83u, 89u, 97u);
    uvec4 cu5  = uvec4(101u, 103u, 107u, 109u);
    uvec4 cu6  = uvec4(113u, 127u, 131u, 137u);
    uvec4 cu7  = uvec4(139u, 149u, 151u, 157u);
    uvec4 cu8  = uvec4(163u, 167u, 173u, 179u);
    uvec4 cu9  = uvec4(181u, 191u, 193u, 197u);
    uvec4 cu10 = uvec4(199u, 211u, 223u, 227u);
    uvec4 cu11 = uvec4(229u, 233u, 239u, 241u);
    uvec4 cu12 = uvec4(251u, 257u, 263u, 269u);
    uvec4 cu13 = uvec4(271u, 277u, 281u, 283u);
    uvec4 cu14 = uvec4(293u, 307u, 311u, 313u);
    uvec4 cu15 = uvec4(317u, 331u, 337u, 347u);

    // 16384 iterations * 16 uvec4 full-rate INT32 ALU ops (2 adds = 2 ops each)
    // = 16384 * 128 = 2,097,152 INT32 ops
    for (int i = 0; i < 16384; ++i) {
        u0  = (u0  + cu0)  + 1u;
        u1  = (u1  + cu1)  + 1u;
        u2  = (u2  + cu2)  + 1u;
        u3  = (u3  + cu3)  + 1u;
        u4  = (u4  + cu4)  + 1u;
        u5  = (u5  + cu5)  + 1u;
        u6  = (u6  + cu6)  + 1u;
        u7  = (u7  + cu7)  + 1u;
        u8  = (u8  + cu8)  + 1u;
        u9  = (u9  + cu9)  + 1u;
        u10 = (u10 + cu10) + 1u;
        u11 = (u11 + cu11) + 1u;
        u12 = (u12 + cu12) + 1u;
        u13 = (u13 + cu13) + 1u;
        u14 = (u14 + cu14) + 1u;
        u15 = (u15 + cu15) + 1u;
    }

    uvec4 s0 = (u0 + u1) + (u2 + u3);
    uvec4 s1 = (u4 + u5) + (u6 + u7);
    uvec4 s2 = (u8 + u9) + (u10 + u11);
    uvec4 s3 = (u12 + u13) + (u14 + u15);
    uvec4 ures = (s0 + s1) + (s2 + s3);

    InOutBuffer.data[index] = float(ures.x ^ ures.y ^ ures.z ^ ures.w);
}
