#version 460

#include "showcase_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

SHOWCASE_DECLARE_SCENE_SET(0);
SHOWCASE_DECLARE_FRAME_SET(1);

shared uint s_overdraw;
shared uint s_subPixel;
shared uint s_shaded;
shared uint s_paritySqErr;
shared uint s_parityExact;
shared uint s_parityNear;
shared uint s_parityTotal;

void main() {
  uint lIdx = gl_LocalInvocationIndex;
  if (lIdx == 0u) {
    s_overdraw = 0u;
    s_subPixel = 0u;
    s_shaded = 0u;
    s_paritySqErr = 0u;
    s_parityExact = 0u;
    s_parityNear = 0u;
    s_parityTotal = 0u;
  }
  barrier();

  ivec2 px = ivec2(gl_GlobalInvocationID.xy);
  uint width = ubo.screenInfo.x;
  uint height = ubo.screenInfo.y;
  bool inBounds = (px.x < int(width) && px.y < int(height));

  if (inBounds) {
    uint ov = imageLoad(uOverdrawImg, px).r;
    float triArea = imageLoad(uTriAreaImg, px).r;
    uint tag = imageLoad(uDebugTagImg, px).r;
    vec3 beauty = texelFetch(uSceneColorTex, px, 0).rgb;

    if (ov > 0u) {
      atomicAdd(s_overdraw, ov);
      atomicAdd(s_shaded, 1u);
      if (triArea > 0.0 && triArea < 1.0) {
        atomicAdd(s_subPixel, 1u);
      }
    }

    vec3 outCol = beauty;
    uint overlay = ubo.screenInfo.w;
    bool splitActive = ubo.miscParams.y > 0.5;

    if (splitActive) {
      vec3 leftBeauty = texelFetch(uAltColorTex, px, 0).rgb;
      vec3 diff = abs(beauty - leftBeauty);
      float maxDiff = max(diff.r, max(diff.g, diff.b));
      float sqErr = dot(diff, diff) * (1.0 / 3.0);
      atomicAdd(s_paritySqErr, min(uint(sqErr * 65536.0), 65535u));
      if (maxDiff < (1.5 / 255.0)) {
        atomicAdd(s_parityExact, 1u);
      }
      if (maxDiff < (6.0 / 255.0)) {
        atomicAdd(s_parityNear, 1u);
      }
      atomicAdd(s_parityTotal, 1u);

      int splitPx = int(clamp(ubo.miscParams.x, 0.0, 1.0) * float(width));
      outCol = (px.x < splitPx) ? leftBeauty : beauty;
      if (abs(px.x - splitPx) <= 1) {
        outCol = vec3(1.0, 0.72, 0.14);
      }
    } else if (overlay == SHOWCASE_OVERLAY_OVERDRAW) {
      if (ov == 0u) {
        outCol = beauty * 0.25;
      } else {
        float normOv = clamp(float(ov - 1u) / 8.0, 0.0, 1.0);
        vec3 heat = showcaseTurboColormap(normOv);
        outCol = mix(beauty * 0.28, heat, 0.85);
      }
    } else if (overlay == SHOWCASE_OVERLAY_MICROTRI) {
      if (ov == 0u || triArea <= 0.0) {
        outCol = beauty * 0.25;
      } else {
        // Highlight tiny waste triangles cleanly: magenta (<1px2) -> red (1..3px2) -> yellow (3..12px2) -> cool cyan (>12px2)
        vec3 col;
        if (triArea < 1.0) {
          col = vec3(0.98, 0.12, 0.85);
        } else if (triArea < 3.0) {
          col = mix(vec3(0.98, 0.20, 0.14), vec3(0.98, 0.65, 0.12), (triArea - 1.0) * 0.5);
        } else if (triArea < 12.0) {
          col = mix(vec3(0.98, 0.72, 0.14), vec3(0.18, 0.85, 0.45), (triArea - 3.0) / 9.0);
        } else {
          col = vec3(0.12, 0.68, 0.86);
        }
        float edgeMask = float(tag & 0xFFu) / 255.0;
        col = mix(col, vec3(0.05), edgeMask * 0.65);
        outCol = mix(beauty * 0.22, col, 0.88);
      }
    } else if (overlay == SHOWCASE_OVERLAY_MESHLETS) {
      if (ov == 0u) {
        outCol = beauty * 0.30;
      } else {
        uint cid = tag >> 8u;
        float edgeMask = float(tag & 0xFFu) / 255.0;
        vec3 clusterCol = showcaseHashColor(cid + 1u);
        vec3 tinted = mix(beauty * 0.35 + clusterCol * 0.65, vec3(1.0, 0.92, 0.65), edgeMask * 0.45);
        outCol = tinted;
      }
    }

    imageStore(uDisplayImg, px, vec4(outCol, 1.0));
  }

  barrier();

  if (lIdx == 0u) {
    if (s_overdraw > 0u) atomicAdd(stats.overdrawSum, s_overdraw);
    if (s_subPixel > 0u) atomicAdd(stats.subPixelTriCount, s_subPixel);
    if (s_shaded > 0u) atomicAdd(stats.totalShadedPixels, s_shaded);
    if (s_parityTotal > 0u) {
      atomicAdd(stats.paritySqErrQuant, s_paritySqErr);
      atomicAdd(stats.parityExactPixels, s_parityExact);
      atomicAdd(stats.parityNearPixels, s_parityNear);
      atomicAdd(stats.parityTotalPixels, s_parityTotal);
    }
  }
}
