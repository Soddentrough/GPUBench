#version 460
#extension GL_EXT_ray_query : enable
#extension GL_EXT_ray_flags_primitive_culling : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1) buffer Results {
    uint totalRays;
    uint totalHits;
    uint accumulatedLuminance;
} results;

#include "rt_scheduling_common.glsl"

layout(set = 0, binding = 2) buffer WorkListBuffer {
    uint queueCounters[Q_HEADER_UINT_CAP];
    vec4 rayRecords[];
} worklist;

layout(set = 0, binding = 3) buffer Framebuffer {
    vec4 pixels[];
} fb;

layout(set = 0, binding = 4) readonly buffer VertexBuffer {
    float vertices[];
} vbuf;

#define BINDING_MAT_BUF 5
#define BINDING_TRI_MAT_BUF 6
#define BINDING_TEX_HDR_BUF 7
#define BINDING_TEX_PIX_BUF 8
#define PBR_NO_RAY_QUERY 1
#include "pbr_common.glsl"

layout(push_constant) uniform PushConstants {
    uint queueId;
    uint queueCapacity;
    uint dumpRenders;
    uint width;
    uint height;
    uint sceneType;       // 0: Showroom Studio, 1: Outdoor Terrain, 2: Indoor Atrium, 3: AAA Forest
    uint isGltf;          // 1 if glTF PBR scene, 0 if procedural
    uint lightIndex;      // 0: Key/Sun, 1: Fill, 2: Rim
} pc;

const uint SCENE_SHOWROOM_STUDIO = 0u;
const uint SCENE_OUTDOOR_TERRAIN = 1u;
const uint SCENE_INDOOR_ATRIUM   = 2u;
const uint SCENE_AAA_FOREST       = 3u;

void main() {
    uint threadIdx = gl_GlobalInvocationID.x;
    uint count = min(worklist.queueCounters[Q_SNAPSHOT_IDX(pc.queueId)], pc.queueCapacity);

    uint threadHits = 0u;
    uint threadLum = 0u;

    if (threadIdx < count) {
        uint recordIdx = pc.queueId * pc.queueCapacity + threadIdx;
        vec4 p = worklist.rayRecords[recordIdx];
        vec3 rayOrig = p.xyz;
        uint pixelIdx = floatBitsToUint(p.w);

        vec3 lightDir;
        float maxDist;
        if (pc.sceneType == SCENE_INDOOR_ATRIUM) {
            if (pc.lightIndex == 1u) {
                lightDir = normalize(vec3(0.32, 0.91, -0.22));
            } else if (pc.lightIndex == 2u) {
                lightDir = normalize(vec3(0.38, 0.89, -0.28));
            } else {
                lightDir = normalize(vec3(0.35, 0.90, -0.25));
            }
            maxDist = 10000.0;
        } else if (pc.sceneType == SCENE_SHOWROOM_STUDIO) {
            if (pc.lightIndex == 1u) {
                lightDir = normalize(vec3(0.57, 0.82, 0.47));
            } else if (pc.lightIndex == 2u) {
                lightDir = normalize(vec3(0.63, 0.78, 0.53));
            } else {
                lightDir = normalize(vec3(0.6, 0.8, 0.5));
            }
            maxDist = 5000.0;
        } else {
            if (pc.lightIndex == 1u) {
                lightDir = normalize(vec3(0.42, 0.38, 0.82));
            } else if (pc.lightIndex == 2u) {
                lightDir = normalize(vec3(0.48, 0.32, 0.82));
            } else {
                lightDir = normalize(vec3(0.45, 0.35, 0.82));
            }
            maxDist = 2500.0;
        }

        rayQueryEXT sQuery;
        rayQueryInitializeEXT(sQuery, topLevelAS,
            gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT | gl_RayFlagsOpaqueEXT,
            0xFF, rayOrig, 0.05, lightDir, maxDist);
        while (rayQueryProceedEXT(sQuery)) {}
        bool occluded = (rayQueryGetIntersectionTypeEXT(sQuery, true) != gl_RayQueryCommittedIntersectionNoneEXT);
        if (occluded) {
            threadHits = 1u;
        }

        if (pc.dumpRenders != 0) {
            float shadowVal = occluded ? 0.08 : 0.95;
            fb.pixels[pixelIdx] = vec4(vec3(shadowVal), 1.0);
        } else {
            threadLum = occluded ? 20u : 243u;
        }
    }

    uint waveHits = subgroupAdd(threadHits);
    uint waveLum = subgroupAdd(threadLum);
    if (subgroupElect()) {
        if (waveHits > 0u) atomicAdd(results.totalHits, waveHits);
        if (waveLum > 0u) atomicAdd(results.accumulatedLuminance, waveLum);
    }
}
