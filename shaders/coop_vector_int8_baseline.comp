#version 460
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer WeightBuffer {
    int8_t weights[];
} weightBuf;

layout(std430, set = 0, binding = 1) readonly buffer BiasBuffer {
    int32_t biases[];
} biasBuf;

layout(std430, set = 0, binding = 2) buffer OutputBuffer {
    int32_t outVals[];
} outBuf;

layout(push_constant) uniform PushConsts {
    uint numThreads;
    uint iterations;
} pc;

void main() {
    uint tid = gl_GlobalInvocationID.x;
    if (tid >= pc.numThreads) {
        return;
    }

    int8_t v[16];
    for (uint c = 0u; c < 16u; ++c) {
        v[c] = int8_t(int((tid + c) & 7u) + 1);
    }

    int32_t acc[16];
    for (uint r = 0u; r < 16u; ++r) {
        acc[r] = 0;
    }

    // Standard per-invocation 16x16 INT8 quantized MLP layers (2*16*16 = 512 OPs/layer)
    for (uint it = 0u; it < pc.iterations; ++it) {
        for (uint r = 0u; r < 16u; ++r) {
            uint rowBase = r * 16u;
            int32_t sum = biasBuf.biases[r];
            for (uint c = 0u; c < 16u; ++c) {
                sum += int32_t(weightBuf.weights[rowBase + c]) * int32_t(v[c]);
            }
            acc[r] = sum;
        }
        for (uint r = 0u; r < 16u; ++r) {
            v[r] = int8_t(clamp(acc[r] >> 4, -64, 64));
        }
    }

    uint baseOut = (tid & 4095u) * 16u;
    for (uint c = 0u; c < 16u; ++c) {
        outBuf.outVals[baseOut + c] = acc[c];
    }
}
