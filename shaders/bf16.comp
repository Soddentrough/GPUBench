#version 460
// Requires Vulkan 1.4+ / GL_EXT_bfloat16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_bfloat16 : require

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Data {
    bf16vec4 data[];
} InOutBuffer;

#define INIT(i) a[i] = bf16vec4(seed + vec4(0.01f * float((i) + 1)));
#define STEP(i) { bfloat16_t d = dot(a[i], m); a[i].x = d; }

#define APPLY4(OP, i)  OP(i) OP((i)+1) OP((i)+2) OP((i)+3)
#define APPLY16(OP, i) APPLY4(OP, i) APPLY4(OP, (i)+4) \
                       APPLY4(OP, (i)+8) APPLY4(OP, (i)+12)
#define APPLY32(OP)    APPLY16(OP, 0) APPLY16(OP, 16)

#define GROUP(i) ((float(a[(i)].x) + float(a[(i)+1].x)) + (float(a[(i)+2].x) + float(a[(i)+3].x)))

void main() {
    uint index = gl_GlobalInvocationID.x;

    uint seedIdx = (index * 4093u + 17u) & 1023u;
    vec4 seed = vec4(InOutBuffer.data[seedIdx]);

    bf16vec4 a[32];
    APPLY32(INIT)

    bf16vec4 m = bf16vec4(vec4(-0.248046875f, 0.125f, -0.1875f, 0.0625f));

    // Each iteration performs 32 bf16vec4 dot products (64 v_dot2_bf16_bf16 = 256 BF16 ops).
    // Stays purely in BF16 inside the loop — zero FP32 adds or BF16<->FP32 conversions.
    for (int i = 0; i < 32768; ++i) {
        APPLY32(STEP)
    }

    float total = GROUP(0)  + GROUP(4)  + GROUP(8)  + GROUP(12)
                + GROUP(16) + GROUP(20) + GROUP(24) + GROUP(28);
    InOutBuffer.data[index] = bf16vec4(vec4(total));
}
