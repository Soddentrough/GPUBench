#version 460
// Requires Vulkan 1.4+ / GL_EXT_bfloat16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_bfloat16 : require

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Data {
    bf16vec4 data[];
} InOutBuffer;

void main() {
    uint index = gl_GlobalInvocationID.x;

    // Seed 32 accumulators from runtime buffer to prevent constant folding.
    vec4 seed = vec4(InOutBuffer.data[index % 1024u]);
    bf16vec4 val1  = bf16vec4(seed + vec4(0.01));
    bf16vec4 val2  = bf16vec4(seed + vec4(0.02));
    bf16vec4 val3  = bf16vec4(seed + vec4(0.03));
    bf16vec4 val4  = bf16vec4(seed + vec4(0.04));
    bf16vec4 val5  = bf16vec4(seed + vec4(0.05));
    bf16vec4 val6  = bf16vec4(seed + vec4(0.06));
    bf16vec4 val7  = bf16vec4(seed + vec4(0.07));
    bf16vec4 val8  = bf16vec4(seed + vec4(0.08));
    bf16vec4 val9  = bf16vec4(seed + vec4(0.09));
    bf16vec4 val10 = bf16vec4(seed + vec4(0.10));
    bf16vec4 val11 = bf16vec4(seed + vec4(0.11));
    bf16vec4 val12 = bf16vec4(seed + vec4(0.12));
    bf16vec4 val13 = bf16vec4(seed + vec4(0.13));
    bf16vec4 val14 = bf16vec4(seed + vec4(0.14));
    bf16vec4 val15 = bf16vec4(seed + vec4(0.15));
    bf16vec4 val16 = bf16vec4(seed + vec4(0.16));
    bf16vec4 val17 = bf16vec4(seed + vec4(0.17));
    bf16vec4 val18 = bf16vec4(seed + vec4(0.18));
    bf16vec4 val19 = bf16vec4(seed + vec4(0.19));
    bf16vec4 val20 = bf16vec4(seed + vec4(0.20));
    bf16vec4 val21 = bf16vec4(seed + vec4(0.21));
    bf16vec4 val22 = bf16vec4(seed + vec4(0.22));
    bf16vec4 val23 = bf16vec4(seed + vec4(0.23));
    bf16vec4 val24 = bf16vec4(seed + vec4(0.24));
    bf16vec4 val25 = bf16vec4(seed + vec4(0.25));
    bf16vec4 val26 = bf16vec4(seed + vec4(0.26));
    bf16vec4 val27 = bf16vec4(seed + vec4(0.27));
    bf16vec4 val28 = bf16vec4(seed + vec4(0.28));
    bf16vec4 val29 = bf16vec4(seed + vec4(0.29));
    bf16vec4 val30 = bf16vec4(seed + vec4(0.30));
    bf16vec4 val31 = bf16vec4(seed + vec4(0.31));
    bf16vec4 val32 = bf16vec4(seed + vec4(0.32));

    bf16vec4 m = bf16vec4(vec4(-0.248046875));
    float acc1 = 0.5, acc2 = 0.5, acc3 = 0.5, acc4 = 0.5;
    float acc5 = 0.5, acc6 = 0.5, acc7 = 0.5, acc8 = 0.5;
    float acc9 = 0.5, acc10 = 0.5, acc11 = 0.5, acc12 = 0.5;
    float acc13 = 0.5, acc14 = 0.5, acc15 = 0.5, acc16 = 0.5;
    float acc17 = 0.5, acc18 = 0.5, acc19 = 0.5, acc20 = 0.5;
    float acc21 = 0.5, acc22 = 0.5, acc23 = 0.5, acc24 = 0.5;
    float acc25 = 0.5, acc26 = 0.5, acc27 = 0.5, acc28 = 0.5;
    float acc29 = 0.5, acc30 = 0.5, acc31 = 0.5, acc32 = 0.5;

    // Each iteration performs 32 bf16vec4 dot-accumulates = 32 * 8 = 256 BF16 ops.
    for (int i = 0; i < 32768; ++i) {
        acc1  += dot(val1,  m); val1.x  = bfloat16_t(acc1);
        acc2  += dot(val2,  m); val2.x  = bfloat16_t(acc2);
        acc3  += dot(val3,  m); val3.x  = bfloat16_t(acc3);
        acc4  += dot(val4,  m); val4.x  = bfloat16_t(acc4);
        acc5  += dot(val5,  m); val5.x  = bfloat16_t(acc5);
        acc6  += dot(val6,  m); val6.x  = bfloat16_t(acc6);
        acc7  += dot(val7,  m); val7.x  = bfloat16_t(acc7);
        acc8  += dot(val8,  m); val8.x  = bfloat16_t(acc8);
        acc9  += dot(val9,  m); val9.x  = bfloat16_t(acc9);
        acc10 += dot(val10, m); val10.x = bfloat16_t(acc10);
        acc11 += dot(val11, m); val11.x = bfloat16_t(acc11);
        acc12 += dot(val12, m); val12.x = bfloat16_t(acc12);
        acc13 += dot(val13, m); val13.x = bfloat16_t(acc13);
        acc14 += dot(val14, m); val14.x = bfloat16_t(acc14);
        acc15 += dot(val15, m); val15.x = bfloat16_t(acc15);
        acc16 += dot(val16, m); val16.x = bfloat16_t(acc16);
        acc17 += dot(val17, m); val17.x = bfloat16_t(acc17);
        acc18 += dot(val18, m); val18.x = bfloat16_t(acc18);
        acc19 += dot(val19, m); val19.x = bfloat16_t(acc19);
        acc20 += dot(val20, m); val20.x = bfloat16_t(acc20);
        acc21 += dot(val21, m); val21.x = bfloat16_t(acc21);
        acc22 += dot(val22, m); val22.x = bfloat16_t(acc22);
        acc23 += dot(val23, m); val23.x = bfloat16_t(acc23);
        acc24 += dot(val24, m); val24.x = bfloat16_t(acc24);
        acc25 += dot(val25, m); val25.x = bfloat16_t(acc25);
        acc26 += dot(val26, m); val26.x = bfloat16_t(acc26);
        acc27 += dot(val27, m); val27.x = bfloat16_t(acc27);
        acc28 += dot(val28, m); val28.x = bfloat16_t(acc28);
        acc29 += dot(val29, m); val29.x = bfloat16_t(acc29);
        acc30 += dot(val30, m); val30.x = bfloat16_t(acc30);
        acc31 += dot(val31, m); val31.x = bfloat16_t(acc31);
        acc32 += dot(val32, m); val32.x = bfloat16_t(acc32);
    }

    float total = acc1 + acc2 + acc3 + acc4 + acc5 + acc6 + acc7 + acc8 +
                  acc9 + acc10 + acc11 + acc12 + acc13 + acc14 + acc15 + acc16 +
                  acc17 + acc18 + acc19 + acc20 + acc21 + acc22 + acc23 + acc24 +
                  acc25 + acc26 + acc27 + acc28 + acc29 + acc30 + acc31 + acc32;
    InOutBuffer.data[index] = bf16vec4(vec4(total));
}
