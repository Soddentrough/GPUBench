#version 460
// GPUBench Dual-Issue & Concurrency Benchmark Suite
// Config 0: Standard FP32 (Single-Issue Baseline)
// Evaluates single-issue saturation where a strict sequential scalar dependency
// chain prevents superscalar/VOPD schedulers from co-issuing instructions.

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Data {
    float data[];
} InOutBuffer;

layout(push_constant) uniform PushConstants {
    float multiplier;
    uint num_elements;
} pushConstants;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pushConstants.num_elements) return;

    // Strict scalar ping-pong dependency chain:
    // val0 strictly depends on val1, and val1 strictly depends on val0.
    // There are no independent operations in flight, enforcing a single-issue baseline.
    float base = InOutBuffer.data[index];
    float val0 = base;
    float val1 = base + 0.1;
    float m = pushConstants.multiplier * 0.00001;

    // 131072 iterations * 2 scalar FMAs = 131072 * 4 = 524,288 FP32 operations
    for (int i = 0; i < 131072; ++i) {
        val0 = fma(val0, m, val1);
        val1 = fma(val1, m, val0);
    }

    InOutBuffer.data[index] = val0 + val1;
}
