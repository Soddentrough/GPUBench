#version 460
#extension GL_EXT_ray_query : enable
#extension GL_EXT_ray_flags_primitive_culling : enable

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1) buffer Results {
    uint totalRays;
    uint totalHits;
    float accumulatedLuminance;
} results;

// Compacted Ray Payload structure (spilled to VRAM/L2)
struct CompactRayPayload {
    vec4 originAndMatId; // xyz: origin, w: uintBitsToFloat(matId)
    vec4 directionAndSeed; // xyz: dir, w: uintBitsToFloat(rng)
    vec4 throughputAndMorton; // xyz: throughput, w: uintBitsToFloat(morton)
};

layout(set = 0, binding = 2) buffer WorkListBuffer {
    uint queueCounters[32]; // Per-material or per-bounce counters
    CompactRayPayload rayRecords[1048576]; // Compact queue buffer
} worklist;

// DispatchIndirectCommand structure matching VkDispatchIndirectCommand
struct VkDispatchIndirectCommand {
    uint x;
    uint y;
    uint z;
};

layout(set = 0, binding = 3) buffer IndirectCommandsBuffer {
    VkDispatchIndirectCommand commands[32];
} indirectCmds;

layout(push_constant) uniform PushConstants {
    uint rayCount;
    uint mode;     // 0: Material Divergence, 1: Multi-Bounce Path Tracing, 2: Incoherent GI
    uint bounce;   // Current bounce index
    uint seed;
} pc;

shared uint localRays;
shared uint localHits;

uint pcg_hash(inout uint state) {
    uint oldstate = state;
    state = oldstate * 747796405u + 2891336453u;
    uint word = ((oldstate >> ((oldstate >> 28u) + 4u)) ^ oldstate) * 277803737u;
    return (word >> 22u) ^ word;
}

float rand_float(inout uint state) {
    return float(pcg_hash(state) & 0x00FFFFFFu) / 16777216.0;
}

vec3 cosine_sample_hemisphere(float u1, float u2) {
    float r = sqrt(u1);
    float theta = 6.28318530718 * u2;
    float x = r * cos(theta);
    float y = r * sin(theta);
    float z = sqrt(max(0.0, 1.0 - u1));
    return vec3(x, y, z);
}

vec3 align_to_normal(vec3 sample_dir, vec3 normal) {
    vec3 up = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);
    return tangent * sample_dir.x + bitangent * sample_dir.y + normal * sample_dir.z;
}

// Bit interleaving for 3D Morton space-filling curve (spatial traversal coherence)
uint part1By2(uint x) {
    x &= 0x000003ff;
    x = (x ^ (x << 16)) & 0xff0000ff;
    x = (x ^ (x << 8))  & 0x0300f00f;
    x = (x ^ (x << 4))  & 0x030c30c3;
    x = (x ^ (x << 2))  & 0x09249249;
    return x;
}

uint morton3D(vec3 dir) {
    vec3 norm = (dir + vec3(1.0)) * 0.5; // map [-1,1] to [0,1]
    uvec3 u = uvec3(clamp(norm * 1023.0, vec3(0.0), vec3(1023.0)));
    return (part1By2(u.x) << 2) | (part1By2(u.y) << 1) | part1By2(u.z);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.rayCount) return;

    if (gl_LocalInvocationID.x == 0) {
        localRays = 0;
        localHits = 0;
    }
    barrier();

    uint rngState = idx + pc.seed;
    float fx = float(idx % 512) - 256.0 + 0.5;
    float fy = float((idx / 512) % 512) - 256.0 + 0.5;

    vec3 origin = vec3(fx * 0.02, fy * 0.02, -5.0);
    vec3 direction = vec3(0.0, 0.0, 1.0);
    uint threadRays = 1;
    uint threadHits = 0;

    rayQueryEXT query;
    rayQueryInitializeEXT(query, topLevelAS, gl_RayFlagsNoneEXT, 0xFF, origin, 0.001, direction, 20.0);
    while (rayQueryProceedEXT(query)) {}

    if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        threadHits = 1;
        float t = rayQueryGetIntersectionTEXT(query, true);
        vec3 hitPos = origin + direction * t;
        uint primId = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
        vec3 normal = (primId % 2 == 0) ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
        if (dot(normal, direction) > 0.0) normal = -normal;

        if (pc.mode == 0) {
            // Work Lists: Stream compaction into 32 material bins
            uint matId = (primId + idx) % 32;
            uint slot = atomicAdd(worklist.queueCounters[matId], 1);
            if (slot < 32768) {
                uint recordIdx = matId * 32768 + slot;
                worklist.rayRecords[recordIdx].originAndMatId = vec4(hitPos + normal * 0.002, uintBitsToFloat(matId));
                worklist.rayRecords[recordIdx].directionAndSeed = vec4(direction, uintBitsToFloat(rngState));
                worklist.rayRecords[recordIdx].throughputAndMorton = vec4(1.0, 1.0, 1.0, 0.0);
            }

            // Update indirect dispatch parameters for this material queue
            if ((slot % 64) == 0) {
                atomicMax(indirectCmds.commands[matId].x, (slot + 64) / 64);
                indirectCmds.commands[matId].y = 1;
                indirectCmds.commands[matId].z = 1;
            }
        } else if (pc.mode == 1) {
            // Work Lists: Wavefront path tracing compaction (Russian roulette filtering)
            bool survives = (pc.bounce < 2) || (rand_float(rngState) >= 0.4);
            if (survives) {
                // Generate next bounce ray direction
                float u1 = rand_float(rngState);
                float u2 = rand_float(rngState);
                vec3 nextDir = align_to_normal(cosine_sample_hemisphere(u1, u2), normal);

                uint slot = atomicAdd(worklist.queueCounters[0], 1);
                if (slot < 65536) {
                    worklist.rayRecords[slot].originAndMatId = vec4(hitPos + normal * 0.002, uintBitsToFloat(primId));
                    worklist.rayRecords[slot].directionAndSeed = vec4(nextDir, uintBitsToFloat(rngState));
                    worklist.rayRecords[slot].throughputAndMorton = vec4(0.8, 0.8, 0.8, 0.0);
                }

                if ((slot % 64) == 0) {
                    atomicMax(indirectCmds.commands[0].x, (slot + 64) / 64);
                    indirectCmds.commands[0].y = 1;
                    indirectCmds.commands[0].z = 1;
                }
            }
        } else {
            // Work Lists: Incoherent secondary rays with Directional Octant Binning
            // The GPU directly bins rays into 8 directional cones (+/-X, +/-Y, +/-Z) at birth,
            // producing pre-ordered, coherent work lists without needing SER or sorting passes.
            float u1 = rand_float(rngState);
            float u2 = rand_float(rngState);
            vec3 incohDir = align_to_normal(cosine_sample_hemisphere(u1, u2), normal);

            uint octant = (incohDir.x > 0.0 ? 1u : 0u) |
                          (incohDir.y > 0.0 ? 2u : 0u) |
                          (incohDir.z > 0.0 ? 4u : 0u);

            uint slot = atomicAdd(worklist.queueCounters[octant], 1);
            if (slot < 131072) {
                uint recordIdx = octant * 131072 + slot;
                worklist.rayRecords[recordIdx].originAndMatId = vec4(hitPos + normal * 0.002, float(octant));
                worklist.rayRecords[recordIdx].directionAndSeed = vec4(incohDir, uintBitsToFloat(rngState));
                worklist.rayRecords[recordIdx].throughputAndMorton = vec4(1.0, 1.0, 1.0, 0.0);
            }

            if ((slot % 64) == 0) {
                atomicMax(indirectCmds.commands[octant].x, (slot + 64) / 64);
                indirectCmds.commands[octant].y = 1;
                indirectCmds.commands[octant].z = 1;
            }
        }
    }

    if (threadRays > 0) atomicAdd(localRays, threadRays);
    if (threadHits > 0) atomicAdd(localHits, threadHits);
    barrier();

    if (gl_LocalInvocationID.x == 0) {
        atomicAdd(results.totalRays, localRays);
        atomicAdd(results.totalHits, localHits);
    }
}
