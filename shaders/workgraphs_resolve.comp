#version 460

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer BucketCounters {
    uint counts[2048];
} bucketCounters;

// Config 0 (Indirect): 2048 entries of 4 uints [x, y, z, cnt] (16B stride)
layout(std430, set = 0, binding = 1) writeonly buffer IndirectDispatchBuf {
    uint args[8192];
} indirectBuf;

// Config 1 (DGC): dynamic sequence count + compacted 24B-stride sequence items
layout(std430, set = 0, binding = 2) coherent buffer DgcCountBuf {
    uint seqCount;
} dgcCountBuf;

layout(std430, set = 0, binding = 3) writeonly buffer DgcSeqBuf {
    uint words[12288];
} dgcSeqBuf;

layout(push_constant) uniform PushConsts {
    uint bucketCapacity;
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= 2048u) {
        return;
    }
    uint cnt = bucketCounters.counts[gid];
    uint groupsX = (cnt + 63u) >> 6u;

    uint indBase = gid * 4u;
    indirectBuf.args[indBase + 0u] = groupsX;
    indirectBuf.args[indBase + 1u] = 1u;
    indirectBuf.args[indBase + 2u] = 1u;
    indirectBuf.args[indBase + 3u] = cnt;

    if (cnt > 0u) {
        uint seq = atomicAdd(dgcCountBuf.seqCount, 1u);
        uint base = seq * 6u;
        dgcSeqBuf.words[base + 0u] = gid;
        dgcSeqBuf.words[base + 1u] = pc.bucketCapacity;
        dgcSeqBuf.words[base + 2u] = groupsX;
        dgcSeqBuf.words[base + 3u] = 1u;
        dgcSeqBuf.words[base + 4u] = 1u;
        dgcSeqBuf.words[base + 5u] = 0u;
    }
}
