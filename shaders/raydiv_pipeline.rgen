#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(location = 0) rayPayloadEXT vec3 payload;

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 1, set = 0, std430) buffer ResultBuffer {
    uint hits;
};

layout(push_constant) uniform PushConstants {
    uint rayCount;
    float coherenceFactor;
    uint seed;
} pc;

uint hash(uint seed) {
    seed = (seed ^ 61) ^ (seed >> 16);
    seed *= 9;
    seed = seed ^ (seed >> 4);
    seed *= 0x27d4eb2d;
    seed = seed ^ (seed >> 15);
    return seed;
}

void main() {
    uint idx = gl_LaunchIDEXT.x;
    uint myHits = 0u;

    if (idx < pc.rayCount) {
        // 8x4 2D tile mapping so threads within a 32-wide wave originate from adjacent surface hit points
        const uint gridWidth = 2000u;
        const uint tilesX = gridWidth / 8u; // 250 tiles per row
        uint tileIdx = idx / 32u;
        uint laneIdx = idx % 32u;
        uint ix = (tileIdx % tilesX) * 8u + (laneIdx % 8u);
        uint iy = (tileIdx / tilesX) * 4u + (laneIdx / 8u);

        float fx = (float(ix) / float(gridWidth)) * 160.0 - 80.0;
        float fy = (float(iy) / float(gridWidth)) * 160.0 - 80.0;

        uint state = hash(idx + pc.seed);
        float jx = float(state % 100) / 100.0 * 0.05;
        state = hash(state);
        float jy = float(state % 100) / 100.0 * 0.05;

        // Secondary bounce rays reflecting upward (+Z) from the rough surface plane at Z = -95.0
        vec3 origin = vec3(fx + jx, fy + jy, -95.0);

        // Directional bounce cone controlled by surface roughness / coherenceFactor:
        // coherenceFactor = 1.0 -> maxTheta = 0 rad (0 deg mirror reflection, all rays parallel)
        // coherenceFactor = 0.0 -> maxTheta = pi/2 rad (+/-90 deg full 180-deg hemisphere diffuse bounce)
        float maxTheta = (1.0 - pc.coherenceFactor) * 1.57079632679;
        state = hash(state);
        float u1 = float(state % 10000) / 10000.0;
        state = hash(state);
        float u2 = float(state % 10000) / 10000.0;

        float cosTheta = 1.0 - u1 * (1.0 - cos(maxTheta));
        float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
        float phi = 6.28318530718 * u2;
        vec3 dir = normalize(vec3(sinTheta * cos(phi), sinTheta * sin(phi), max(0.005, cosTheta)));

        payload = vec3(0.0);

        // Single uniform hit shader (SBT offset 0) with tMax = 500.0 so 100% of rays intersect the enclosing chamber
        traceRayEXT(topLevelAS, gl_RayFlagsNoneEXT, 0xFF, 0, 1, 0, origin, 0.001, dir, 500.0, 0);

        myHits = uint(payload.x * 100.0) + uint(payload.y * 10.0) + uint(payload.z);
    }

    uint waveHits = subgroupAdd(myHits);
    if (subgroupElect() && waveHits > 0u) {
        atomicAdd(hits, waveHits);
    }
}
