#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) buffer OutputBuffer {
    double data[];
} outBuffer;

#define STEP(i) a[i] = fma(a[i], mult, a[((i) + 1) & 7]);

#define APPLY4(OP, i) OP(i) OP((i) + 1) OP((i) + 2) OP((i) + 3)
#define APPLY8(OP)    APPLY4(OP, 0) APPLY4(OP, 4)

void main() {
    uint index = gl_GlobalInvocationID.x;
    double add = double(index) * 0.00000001;
    double mult = 1.000001 + add;

    double a[8];
    a[0] = outBuffer.data[index] + 1.0;
    a[1] = a[0] + 0.1;
    a[2] = a[0] + 0.2;
    a[3] = a[0] + 0.3;
    a[4] = a[0] + 0.4;
    a[5] = a[0] + 0.5;
    a[6] = a[0] + 0.6;
    a[7] = a[0] + 0.7;

    // 256 × 8 FMAs × 2 = 4096 FP64 operations per invocation.
    for (int i = 0; i < 256; ++i) {
        APPLY8(STEP)
    }

    outBuffer.data[index] =
        a[0] + a[1] + a[2] + a[3] +
        a[4] + a[5] + a[6] + a[7];
}
