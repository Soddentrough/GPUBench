#version 460

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) buffer OutBuffer {
    vec4 data[];
} outBuf;

layout(push_constant) uniform PushConsts {
    uint count;
    uint iterations;
    float seed;
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.count) {
        return;
    }
    vec4 acc = vec4(pc.seed + float(gid & 255u) * 0.001953125,
                    pc.seed * 0.75 + 0.125,
                    pc.seed * 0.5 + 0.25,
                    1.0);
    vec4 mul = vec4(0.99993896, 0.99996948, 0.99990845, 0.99998474);
    vec4 add = vec4(0.00012207, 0.00006104, 0.00018311, 0.00003052);

    for (uint i = 0u; i < pc.iterations; ++i) {
        acc = fma(acc, mul, add);
        acc = fma(acc.yzwx, mul, add);
        acc = fma(acc.zwxy, mul, add);
        acc = fma(acc.wxyz, mul, add);
    }
    outBuf.data[gid] = acc;
}
