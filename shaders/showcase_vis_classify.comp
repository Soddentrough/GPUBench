#version 460
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_KHR_shader_subgroup_ballot : require

#include "showcase_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

SHOWCASE_DECLARE_SCENE_SET(0);
SHOWCASE_DECLARE_FRAME_SET(1);

void main() {
  ivec2 px = ivec2(gl_GlobalInvocationID.xy);
  uint width = ubo.screenInfo.x;
  uint height = ubo.screenInfo.y;
  bool inBounds = (px.x < int(width) && px.y < int(height));

  uint arch = 0xFFFFFFFFu;
  bool enqueueWork = false;

  if (inBounds) {
    uvec2 vis = imageLoad(uVisBufferImg, px).rg;
    if (vis.y == 0xFFFFFFFFu) {
      vec2 uv = (vec2(px) + 0.5) / vec2(width, height);
      vec2 ndc = uv * 2.0 - 1.0;
      mat4 invVP = inverse(ubo.viewProj);
      vec4 wpFar = invVP * vec4(ndc, 0.001, 1.0);
      vec3 rayDir = normalize(wpFar.xyz / wpFar.w - ubo.camPosFov.xyz);
      vec3 sky = showcaseLinearToSrgb(showcaseAcesTonemap(showcaseSkyColor(rayDir, ubo.sunDirIntensity.xyz)));
      imageStore(uSceneColorImg, px, vec4(sky, 1.0));
    } else {
      uint meshletIdx = vis.x >> 8u;
      uint matId = meshlets[meshletIdx].meta.x;
      arch = min(materials[matId].flags.y, 7u);
      enqueueWork = (ubo.countsInfo.w & SHOWCASE_OPT_DGC_BINNING) != 0u;
    }
  }

  // Coalesce worklist atomicAppend across uniform waves when possible
  if (enqueueWork && subgroupAllEqual(arch) && subgroupAll(enqueueWork)) {
    uint baseSlot = 0u;
    if (subgroupElect()) {
      baseSlot = atomicAdd(worklistCounters[arch], gl_SubgroupSize);
    }
    baseSlot = subgroupBroadcastFirst(baseSlot);
    uint slot = baseSlot + gl_SubgroupInvocationID;
    if (slot < ubo.frameMeta.z) {
      worklistData[arch * ubo.frameMeta.z + slot] = (uint(px.y) << 16u) | uint(px.x);
    }
  } else if (enqueueWork) {
    uint slot = atomicAdd(worklistCounters[arch], 1u);
    if (slot < ubo.frameMeta.z) {
      worklistData[arch * ubo.frameMeta.z + slot] = (uint(px.y) << 16u) | uint(px.x);
    }
  }
}
