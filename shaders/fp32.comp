#version 460
#extension GL_KHR_shader_subgroup_ballot : enable

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) buffer Data {
    float data[];
} InOutBuffer;

layout(push_constant) uniform PushConstants {
    float multiplier;
    uint num_elements;
} pushConstants;

#define INIT(i) a[i] = seed + 0.04 * vec4(4*(i)+1, 4*(i)+2, 4*(i)+3, 4*(i)+4);
#define STEP(i) a[i] = fma(vec4(m), a[i], a[i]);

#define APPLY4(OP, i) OP(i) OP((i)+1) OP((i)+2) OP((i)+3)
#define APPLY8(OP)    APPLY4(OP, 0) APPLY4(OP, 4)

#define GROUP(i) ((a[(i)] + a[(i)+1]) + (a[(i)+2] + a[(i)+3]))

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pushConstants.num_elements) return;

    vec4 seed = vec4(InOutBuffer.data[index & 0x1FFFu] * 0.0001);
    vec4 a[8];
    APPLY8(INIT)

    // Read pre-scaled multiplier directly from push-constant SGPR (no VALU float scaling,
    // which would force m into a VGPR on RDNA 3 and cause src0/vsrc1 bank conflicts),
    // unlocking v_dual_fmac_f32 VOPD dual-issue with 32 scalar accumulators (~34 VGPRs).
    float m = pushConstants.multiplier;
    for (int iteration = 0; iteration < 65536; ++iteration) {
        APPLY8(STEP)
    }

    vec4 sum = GROUP(0) + GROUP(4);

    InOutBuffer.data[index] = sum.x + sum.y + sum.z + sum.w;
}
