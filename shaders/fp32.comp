#version 460

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) buffer Data {
    float data[];
} InOutBuffer;

layout(push_constant) uniform PushConstants {
    float multiplier;
    uint num_elements;
} pushConstants;

#define INIT(i) a[i] = seed + 0.01 * vec4(4*(i)+1, 4*(i)+2, 4*(i)+3, 4*(i)+4);
#define STEP(i) a[i] = fma(m, a[((i)+1) & 31], a[i]);

#define APPLY4(OP, i)  OP(i) OP((i)+1) OP((i)+2) OP((i)+3)
#define APPLY16(OP, i) APPLY4(OP, i) APPLY4(OP, (i)+4) \
                       APPLY4(OP, (i)+8) APPLY4(OP, (i)+12)
#define APPLY32(OP)    APPLY16(OP, 0) APPLY16(OP, 16)

#define GROUP(i) ((a[(i)] + a[(i)+1]) + (a[(i)+2] + a[(i)+3]))

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pushConstants.num_elements) return;

    vec4 seed = vec4(InOutBuffer.data[index & 0x1FFFu] * 0.0001);
    vec4 a[32];
    APPLY32(INIT)

    // Spectral radius (1 + m)^16384 stays bounded in [0.2, 5.2] with |m| <= 1e-4,
    // avoiding IEEE-754 saturation to +inf while preserving dst == addend for v_dual_fmac_f32
    vec4 m = vec4(pushConstants.multiplier * 0.0001);
    for (int iteration = 0; iteration < 16384; ++iteration) {
        APPLY32(STEP)
    }

    vec4 sum = GROUP(0)  + GROUP(4)  + GROUP(8)  + GROUP(12)
             + GROUP(16) + GROUP(20) + GROUP(24) + GROUP(28);

    InOutBuffer.data[index] = sum.x + sum.y + sum.z + sum.w;
}
