float computeFloorOcclusion(vec3 hitPos) {
    float occ = 1.0;
    float dCenter = length(hitPos.xy - vec2(0.0, 0.2));
    occ *= clamp(0.20 + 0.80 * smoothstep(0.4, 2.5, dCenter), 0.0, 1.0);
    float dLeft = length(hitPos.xy - vec2(-1.8, -1.2));
    occ *= clamp(0.15 + 0.85 * smoothstep(0.3, 2.0, dLeft), 0.0, 1.0);
    float dFront = length(vec2(hitPos.x, (hitPos.y - (-1.5)) * 2.0));
    occ *= clamp(0.18 + 0.82 * smoothstep(0.4, 2.2, dFront), 0.0, 1.0);
    float dSphere = length(hitPos.xy - vec2(-3.24, 0.39));
    occ *= clamp(0.10 + 0.90 * smoothstep(0.3, 1.4, dSphere), 0.0, 1.0);
    float dPed = length(hitPos.xy - vec2(-0.46, 0.06));
    occ *= clamp(0.08 + 0.92 * smoothstep(0.3, 1.2, dPed), 0.0, 1.0);
    float dSuz = length(hitPos.xy - vec2(2.71, -0.57));
    occ *= clamp(0.12 + 0.88 * smoothstep(0.3, 1.4, dSuz), 0.0, 1.0);
    return occ;
}

uint computeMaterialId(uint sceneType, uint primId, vec3 hitPos, vec3 normal) {
    if (sceneType == SCENE_OUTDOOR_TERRAIN) {
        if (primId < PRIM_TERRAIN_END) {
            // Shoreline boulders and river gravel along water margin
            if (hitPos.z >= -0.2 && hitPos.z <= 2.2 && abs(hitPos.x) < 185.0 && hitPos.y >= -145.0 && hitPos.y <= 930.0) {
                return 7u; // Wet River Stones / Shoreline Boulders
            }
            // Multi-frequency harmonic snowline modulation
            float snowHarmonics = sin(hitPos.x * 0.032 + hitPos.y * 0.018) * 9.5
                                + cos(hitPos.x * 0.068 - hitPos.y * 0.045) * 4.5
                                + sin(hitPos.x * 0.130 + hitPos.y * 0.110) * 2.0;
            // Steep slopes and cliffs shed snow, while gullies and gentle slopes retain snow at lower altitudes
            float snowAltitude = 60.0 + (1.0 - normal.z) * 28.0 + snowHarmonics;
            if (hitPos.z > snowAltitude && normal.z >= 0.50) {
                return 3u; // High Mountain Snow & Glacial Ice
            }
            if (normal.z < 0.65) {
                return 4u; // Exposed Granite Cliff Face
            }
            if (normal.z < 0.82) {
                return 0u; // Weathered Sandstone & Scree Slope
            }
            return 5u;     // Valley Grassland / Alpine Meadow
        }
        if (primId < PRIM_WATER_END) {
            return 2u;     // Alpine Lake / River Water Plane
        }
        uint treeLocalTri = (primId - PRIM_WATER_END) % 224u;
        if (treeLocalTri < 32u) {
            return 6u;     // Pine Bark / Timber Trunk
        }
        return 1u;         // Translucent Conifer Pine Foliage / Needles
    } else {
        if (primId < PRIM_KNOT_PAINT_END)  return 0u; // Knot Band 0: Ruby Car Paint (Inner Arch)
        if (primId < PRIM_KNOT_JADE_END)   return 1u; // Knot Band 1: Jade Subsurface (Left Loop)
        if (primId < PRIM_KNOT_CHROME_END) return 7u; // Knot Band 2: Chrome Mirror (Top Right Arch)
        if (primId < PRIM_KNOT_VELVET_END) return 3u; // Knot Band 3: Magenta Velvet (Rear Arch)
        if (primId < PRIM_KNOT_RUST_END)   return 4u; // Knot Band 4: Weathered Rust (Front Tube)
        if (primId < PRIM_SPHERE_END)      return 1u; // Satellite Jade Sphere
        if (primId < PRIM_PEDESTAL_END)    return 6u; // Gold Turned Pedestal
        if (primId < PRIM_SUZANNE_END)     return 2u; // Suzanne Dispersive Glass Head
        if (primId < PRIM_FLOOR_END)       return 5u; // Showroom Cyclorama Floor
        if (primId < PRIM_WALLS_END)       return 4u; // Atrium Enclosing Walls (Bronze/Rust panels)
        if (primId < PRIM_CEILING_END)     return 6u; // Vaulted Ceiling (Gold Coffered)
        return 1u;                                    // Columns (Carrara Marble)
    }
}

uint getArchetype(uint matId) {
    return matId;
}

vec3 tonemapACES(vec3 x) {
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    vec3 mapped = clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
    return pow(mapped, vec3(1.0 / 2.2));
}

void computePixelCoords(uint idx, uint pattern, uint width, uint height, out uint px_u, out uint py_u) {
    if (pattern == 1) {
        uint tilesX = (width + 7) / 8;
        uint tileIdx = idx / 32;
        uint inTile = idx % 32;
        uint tileX = tileIdx % tilesX;
        uint tileY = tileIdx / tilesX;
        px_u = tileX * 8 + (inTile % 8);
        py_u = tileY * 4 + (inTile / 8);
    } else if (pattern == 2) {
        uint tilesX = (width + 7) / 8;
        uint tileIdx = idx / 32;
        uint inTile = idx % 32;
        uint tileX = tileIdx % tilesX;
        uint tileY = tileIdx / tilesX;
        uint mx = ((inTile >> 0) & 1) | (((inTile >> 2) & 1) << 1) | (((inTile >> 4) & 1) << 2);
        uint my = ((inTile >> 1) & 1) | (((inTile >> 3) & 1) << 1);
        px_u = tileX * 8 + mx;
        py_u = tileY * 4 + my;
    } else if (pattern == 3) {
        uint tilesX = (width + 3) / 4;
        uint tileIdx = idx / 32;
        uint inTile = idx % 32;
        uint tileX = tileIdx % tilesX;
        uint tileY = tileIdx / tilesX;
        uint mx = ((inTile >> 0) & 1) | (((inTile >> 2) & 1) << 1);
        uint my = ((inTile >> 1) & 1) | (((inTile >> 3) & 1) << 1) | (((inTile >> 4) & 1) << 2);
        px_u = tileX * 4 + mx;
        py_u = tileY * 8 + my;
    } else {
        px_u = idx % width;
        py_u = idx / width;
    }
}

vec3 computeSmoothNormal(uint sceneType, uint primId, vec3 hitPos, vec3 rayDir, vec2 bary) {
    if (pc.isGltf != 0u) {
        uint base = primId * 36u;
        vec3 p0 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
        vec3 n0 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);
        base += 12u;
        vec3 p1 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
        vec3 n1 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);
        base += 12u;
        vec3 p2 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
        vec3 n2 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);

        float w = 1.0 - bary.x - bary.y;
        vec3 geomNorm = normalize(cross(p1 - p0, p2 - p0));
        vec3 smoothNorm = w * n0 + bary.x * n1 + bary.y * n2;
        vec3 n = (length(smoothNorm) > 1e-4) ? normalize(smoothNorm) : geomNorm;
        if (dot(n, rayDir) > 0.0) n = -n;
        return n;
    }
    vec3 normal;
    if (sceneType == SCENE_OUTDOOR_TERRAIN) {
        if (primId >= PRIM_TERRAIN_END && primId < PRIM_WATER_END) {
            normal = vec3(0.0, 0.0, 1.0);
        } else {
            uint base = primId * 9u;
            vec3 p0 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
            vec3 p1 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);
            vec3 p2 = vec3(vbuf.vertices[base + 6], vbuf.vertices[base + 7], vbuf.vertices[base + 8]);
            normal = normalize(cross(p1 - p0, p2 - p0));
        }
    } else {
        if (primId < PRIM_KNOT_RUST_END) {
            uint segI = (primId / 48u);
            float u0 = (float(segI) / 160.0) * 6.283185307;
            float u1 = (float((segI + 1u) % 160u) / 160.0) * 6.283185307;

            float r0 = (2.0 + 0.8 * cos(3.0 * u0)) * 0.835;
            vec3 unrot0 = vec3(r0 * cos(2.0 * u0), r0 * sin(2.0 * u0), -0.8 * 0.835 * sin(3.0 * u0));
            float r1 = (2.0 + 0.8 * cos(3.0 * u1)) * 0.835;
            vec3 unrot1 = vec3(r1 * cos(2.0 * u1), r1 * sin(2.0 * u1), -0.8 * 0.835 * sin(3.0 * u1));

            const mat3 R_knot = mat3(
                vec3( 0.929662, -0.239757, -0.279722),
                vec3( 0.326751,  0.887321,  0.325417),
                vec3( 0.170182, -0.393927,  0.903249)
            );
            vec3 c0 = R_knot * unrot0 + vec3(0.0, 0.0, 0.385);
            vec3 c1 = R_knot * unrot1 + vec3(0.0, 0.0, 0.385);

            vec3 seg = c1 - c0;
            float segLen2 = dot(seg, seg);
            float tSeg = clamp(dot(hitPos - c0, seg) / max(segLen2, 0.00001), 0.0, 1.0);
            vec3 centerPt = c0 + tSeg * seg;

            normal = normalize(hitPos - centerPt);
        } else if (primId < PRIM_SPHERE_END) {
            normal = normalize(hitPos - vec3(-3.242, 0.391, -0.509));
        } else if (primId < PRIM_PEDESTAL_END) {
            if (hitPos.z >= -0.658) {
                normal = vec3(0.0, 0.0, 1.0);
            } else if (hitPos.z <= -1.050) {
                normal = vec3(0.0, 0.0, -1.0);
            } else {
                normal = normalize(vec3(hitPos.x - (-0.460), hitPos.y - 0.060, 0.0));
            }
        } else if (primId < PRIM_SUZANNE_END) {
            uint base = primId * 9u;
            vec3 p0 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
            vec3 p1 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);
            vec3 p2 = vec3(vbuf.vertices[base + 6], vbuf.vertices[base + 7], vbuf.vertices[base + 8]);
            normal = normalize(cross(p1 - p0, p2 - p0));
        } else if (primId < PRIM_FLOOR_END) {
            float backCurve = (hitPos.y > 1.0) ? 0.044 * (hitPos.y - 1.0) : 0.0;
            normal = normalize(vec3(0.0, -backCurve, 1.0));
        } else {
            uint base = primId * 9u;
            vec3 p0 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
            vec3 p1 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);
            vec3 p2 = vec3(vbuf.vertices[base + 6], vbuf.vertices[base + 7], vbuf.vertices[base + 8]);
            normal = normalize(cross(p1 - p0, p2 - p0));
        }
    }
    if (dot(normal, rayDir) > 0.0) normal = -normal;
    return normal;
}


vec3 evalMaterialBSDF(uint sceneType, uint matId, vec3 normal, vec3 inDir, vec3 hitPos, inout uint rng) {
    vec3 viewDir = -inDir;
    float NdotV = max(dot(normal, viewDir), 0.001);
    uint archetype = (SPECIALIZED_ARCHETYPE != 0xFFFFFFFFu) ? SPECIALIZED_ARCHETYPE : getArchetype(matId);

    if (sceneType == SCENE_OUTDOOR_TERRAIN) {
        // Outdoor Open-World Lighting
        vec3 sunDir = normalize(vec3(0.45, 0.35, 0.82));
        vec3 sunColor = vec3(1.0, 0.96, 0.88) * 2.2;
        vec3 skyColor = vec3(0.35, 0.55, 0.85) * 0.50;
        vec3 groundColor = vec3(0.20, 0.18, 0.12) * 0.25;

        float NdotL = max(dot(normal, sunDir), 0.0);
        vec3 halfVec = normalize(viewDir + sunDir);
        float NdotH = max(dot(normal, halfVec), 0.0);
        float VdotH = max(dot(viewDir, halfVec), 0.0);

        if (archetype == 2) {
            // Realistic alpine lake water surface ripples
            vec2 waveUV = hitPos.xy * 0.10;
            float w1 = sin(waveUV.x * 2.8 + waveUV.y * 1.9) * 0.030;
            float w2 = cos(waveUV.x * 5.4 - waveUV.y * 3.8) * 0.018;
            float w3 = sin(waveUV.x * 10.5 + waveUV.y * 8.7) * 0.009;
            normal = normalize(normal + vec3(w1 + w3, w2 + w3, 0.0));
            NdotL = max(dot(normal, sunDir), 0.0);
            NdotV = max(dot(normal, viewDir), 0.0);
            halfVec = normalize(viewDir + sunDir);
            NdotH = max(dot(normal, halfVec), 0.0);
            VdotH = max(dot(viewDir, halfVec), 0.0);
        }

        vec3 color = vec3(0.0);
        vec3 albedo = vec3(0.5);

        switch (archetype) {
            case 0: {
                // Weathered Sandstone & Scree Slope
                albedo = vec3(0.65, 0.52, 0.40);
                float D_r = pow(NdotH, 8.0) * 0.15;
                color = albedo * (NdotL * 0.75 + 0.15) + vec3(D_r);
                break;
            }
            case 1: {
                // Translucent Conifer Pine Foliage / Needles
                albedo = vec3(0.08, 0.32, 0.12);
                float wrappedNdotL = clamp((dot(normal, sunDir) + 0.45) / 1.45, 0.0, 1.0);
                vec3 transmission = vec3(0.18, 0.48, 0.10) * wrappedNdotL;
                float D_f = pow(NdotH, 30.0) * 0.4;
                color = albedo * (NdotL * 0.60 + 0.10) + transmission + vec3(D_f);
                break;
            }
            case 2: {
                // Alpine Lake / River Water Plane
                albedo = vec3(0.012, 0.042, 0.065);
                break;
            }
            case 3: {
                // High Mountain Snow & Glacial Ice
                albedo = vec3(0.92, 0.95, 0.98);
                float snowWrap = clamp((dot(normal, sunDir) + 0.3) / 1.3, 0.0, 1.0);
                float snowGlint = pow(NdotH, 60.0) * 0.8;
                color = albedo * (snowWrap * 0.85 + 0.20) + vec3(snowGlint);
                break;
            }
            case 4: {
                // Exposed Granite Cliff Face
                albedo = vec3(0.30, 0.31, 0.34);
                float cliffNdotL = NdotL * 0.80 + 0.12;
                color = albedo * cliffNdotL;
                break;
            }
            case 5: {
                // Valley Grassland / Alpine Meadow
                albedo = vec3(0.24, 0.44, 0.18);
                float sheen = pow(clamp(1.0 - VdotH, 0.0, 1.0), 3.0) * 0.30;
                color = albedo * (NdotL * 0.70 + 0.18) + vec3(sheen);
                break;
            }
            case 6: {
                // Pine Bark / Timber Trunk
                albedo = vec3(0.25, 0.17, 0.11);
                color = albedo * (NdotL * 0.65 + 0.10);
                break;
            }
            case 7: {
                // Wet River Stones / Shoreline Boulders
                albedo = vec3(0.18, 0.20, 0.22);
                float F_wet = 0.06 + 0.94 * pow(clamp(1.0 - VdotH, 0.0, 1.0), 5.0);
                float D_wet = pow(NdotH, 90.0) * 2.5;
                color = albedo * (NdotL * 0.50 + 0.10) + vec3(D_wet * F_wet);
                break;
            }
        }

        float sunShadow = 1.0;
        if (dot(normal, sunDir) > 0.0) {
            if (traceShadowRay(hitPos, normal, sunDir, 2500.0)) {
                sunShadow = 0.0;
            }
        }
        vec3 totalRadiance;
        if (archetype == 2) {
            // Physically-based water: Fresnel reflection of outdoor sky & mountains
            float F_w = 0.02 + 0.98 * pow(clamp(1.0 - NdotV, 0.0, 1.0), 5.0);
            vec3 reflDir = reflect(inDir, normal);
            vec3 reflSky = evalOutdoorSky(reflDir);
            float sunGlint = pow(NdotH, 180.0) * 10.0 * sunShadow;
            vec3 deepWater = vec3(0.012, 0.042, 0.065);
            totalRadiance = mix(deepWater, reflSky, F_w) + sunColor * sunGlint;
        } else {
            totalRadiance = color * sunColor * sunShadow + albedo * skyColor * max(normal.z, 0.0) + albedo * groundColor * max(-normal.z, 0.0);
        }

        // Atmospheric Aerial Perspective Haze with Horizon Matching
        vec3 camPos, camForward, camRight, camUp;
        float fov;
        getCamera(sceneType, camPos, camForward, camRight, camUp, fov);
        vec3 rayVec = hitPos - camPos;
        float camDist = length(rayVec);
        vec3 rayDirToHit = rayVec / max(camDist, 0.001);

        // Match directional sky color at the horizon
        vec3 skyHorizon = evalOutdoorSky(rayDirToHit);
        vec3 hazeColor = mix(vec3(0.65, 0.76, 0.90), skyHorizon, 0.75);

        // Exponential haze ramping seamlessly into 100% sky at terrain boundary
        float hazeFactor = clamp(1.0 - exp(-camDist * 0.00085), 0.0, 1.0);
        if (camDist > 1250.0) {
            float fadeToEnd = smoothstep(1250.0, 1750.0, camDist);
            hazeFactor = mix(hazeFactor, 1.0, fadeToEnd);
            hazeColor = skyHorizon;
        }
        return mix(totalRadiance, hazeColor, hazeFactor);

    } else {
        // Indoor Atrium / Showroom Lighting
        vec3 totalRadiance = vec3(0.0);

        for (int l = 0; l < 4; ++l) {
            vec3 lightDir = normalize(SCENE_LIGHTS[l].dir);
            vec3 lightCol = SCENE_LIGHTS[l].color * SCENE_LIGHTS[l].intensity;
            vec3 halfVec = normalize(viewDir + lightDir);
            float NdotL = max(dot(normal, lightDir), 0.0);
            float NdotH = max(dot(normal, halfVec), 0.0);
            float VdotH = max(dot(viewDir, halfVec), 0.0);

            if (NdotL <= 0.0 && archetype != 1 && archetype != 2 && archetype != 5) continue;

            vec3 color = vec3(0.0);

            switch (archetype) {
                case 0: {
                    // Red Metallic Car Paint (Deep Crimson with Gloss Clearcoat)
                    vec3 carColor = vec3(0.68, 0.01, 0.02);
                    float D_c = NdotH * NdotH * (0.0003 - 1.0) + 1.0;
                    float D_clear = 0.0003 / (3.14159 * D_c * D_c + 0.0001);
                    float F_clear = 0.04 + 0.96 * pow(clamp(1.0 - VdotH, 0.0, 1.0), 5.0);
                    vec3 specClear = vec3((D_clear * F_clear * 0.85) / (4.0 * NdotL * NdotV + 0.001) * NdotL);
                    float D_m = NdotH * NdotH * (0.035 - 1.0) + 1.0;
                    float D_base = 0.035 / (3.14159 * D_m * D_m + 0.0001);
                    vec3 specBase = carColor * (D_base * 0.70 / (4.0 * NdotL * NdotV + 0.001) * NdotL);
                    color = (carColor * (NdotL * 0.65 + 0.08)) + specBase + specClear;
                    break;
                }
                case 1: {
                    // Jade / Carrara Marble Subsurface Scattering
                    vec3 jadeBase = vec3(0.08, 0.88, 0.74);
                    float wrappedNdotL = clamp((dot(normal, lightDir) + 0.40) / 1.40, 0.0, 1.0);
                    vec3 sssCol = exp(-vec3(0.40, 0.08, 0.18) * (1.0 - wrappedNdotL) * 2.0) * jadeBase;
                    float d_j = NdotH * NdotH * (0.006 - 1.0) + 1.0;
                    float D_j = 0.006 / (3.14159 * d_j * d_j + 0.0001);
                    float F_j = 0.05 + 0.95 * pow(clamp(1.0 - VdotH, 0.0, 1.0), 5.0);
                    vec3 specJade = vec3(D_j * F_j * 0.65 / (4.0 * NdotL * NdotV + 0.001) * NdotL);
                    color = sssCol * wrappedNdotL * 0.95 + specJade;
                    break;
                }
                case 2: {
                    // Automotive Laminated Safety Glass (Dielectric specular transmission)
                    float d_g = NdotH * NdotH * (0.0004 - 1.0) + 1.0;
                    float D_glass = 0.0004 / (3.14159 * d_g * d_g + 0.0001);
                    float F_g = 0.04 + 0.96 * pow(clamp(1.0 - VdotH, 0.0, 1.0), 5.0);
                    vec3 specGlass = vec3(D_glass * F_g * 1.0 / (4.0 * NdotL * NdotV + 0.001) * NdotL);
                    color = specGlass;
                    break;
                }
                case 3: {
                    // Magenta Velvet (Rich Imperial Violet Grazing Sheen)
                    vec3 velvetBase = vec3(0.60, 0.02, 0.42);
                    float invAlpha = 1.0 / 0.35;
                    float sinThetaH = sqrt(max(0.0, 1.0 - NdotH * NdotH));
                    float D_charlie = (2.0 + invAlpha) * pow(sinThetaH, invAlpha) / (6.28318);
                    float F_velvet = pow(clamp(1.0 - VdotH, 0.0, 1.0), 4.0);
                    vec3 sheen = vec3(0.95, 0.35, 0.85) * (D_charlie * F_velvet * 0.75 * NdotL);
                    color = velvetBase * (NdotL * 0.40 + 0.06) + sheen;
                    break;
                }
                case 4: {
                    // Weathered Industrial Rust & Bronze (Terracotta Pitting & Gunmetal)
                    float rustNoise = rustFBM3D(hitPos * 5.5);
                    float rustFine = noise3D(hitPos * 24.0) * 0.5 + 0.5;
                    float rustVal = rustNoise * 0.80 + rustFine * 0.20;
                    float rustMask = smoothstep(0.46, 0.52, rustVal);
                    
                    vec3 steelCol = vec3(0.24, 0.26, 0.30);
                    vec3 rustCol = vec3(0.95, 0.42, 0.14);
                    vec3 darkRust = vec3(0.35, 0.16, 0.08);
                    vec3 patinaCol = vec3(0.20, 0.55, 0.48);
                    
                    float patinaMask = smoothstep(0.52, 0.56, rustNoise) * (1.0 - smoothstep(0.56, 0.62, rustNoise));
                    vec3 activeRust = mix(rustCol, darkRust, rustFine * 0.5);
                    activeRust = mix(activeRust, patinaCol, patinaMask * 0.50);

                    float d_s = NdotH * NdotH * (0.015 - 1.0) + 1.0;
                    float D_s = 0.015 / (3.14159 * d_s * d_s + 0.0001);
                    vec3 steelSpec = steelCol * (D_s * 0.90 / (4.0 * NdotL * NdotV + 0.001) * NdotL);
                    vec3 steelBase = steelCol * (NdotL * 0.55 + 0.08) + steelSpec;
                    
                    float d_r = NdotH * NdotH * (0.50 - 1.0) + 1.0;
                    float D_r = 0.50 / (3.14159 * d_r * d_r + 0.0001);
                    vec3 rustSpec = activeRust * (D_r * 0.10 / (4.0 * NdotL * NdotV + 0.001) * NdotL);
                    vec3 rustBase = activeRust * (NdotL * 0.75 + 0.12) + rustSpec;
                    
                    color = mix(steelBase, rustBase, rustMask);
                    break;
                }
                case 5: {
                    // Neutral Studio / Atrium Floor
                    vec3 floorBase = vec3(0.24, 0.25, 0.28);
                    float floorOcc = computeFloorOcclusion(hitPos);
                    float wallFactor = smoothstep(2.0, 6.0, hitPos.y);
                    float wallAtten = mix(1.0, 0.85, wallFactor);
                    float effectiveNdotL = NdotL * ((l == 0) ? floorOcc : clamp(floorOcc * 1.15, 0.0, 1.0)) * wallAtten;

                    vec3 floorSpec = vec3(0.0);
                    if (l == 0 && wallFactor < 0.5) {
                        float alpha2 = 0.015;
                        float d_f = NdotH * NdotH * (alpha2 - 1.0) + 1.0;
                        float D_f = alpha2 / (3.14159 * d_f * d_f + 0.0001);
                        float F_f = 0.08 + 0.92 * pow(clamp(1.0 - VdotH, 0.0, 1.0), 5.0);
                        floorSpec = vec3((D_f * F_f * 0.45) / (4.0 * NdotL * NdotV + 0.001) * effectiveNdotL);
                    }
                    color = floorBase * (effectiveNdotL * 0.70 + 0.18) + floorSpec;
                    break;
                }
                case 6: {
                    // Polished Gold Pedestal / Ornaments
                    vec3 goldBase = vec3(1.00, 0.78, 0.32);
                    float d_g = NdotH * NdotH * (0.003 - 1.0) + 1.0;
                    float D_gold = 0.003 / (3.14159 * d_g * d_g + 0.0001);
                    float F_gold = 0.88 + 0.12 * pow(clamp(1.0 - VdotH, 0.0, 1.0), 5.0);
                    vec3 specGold = goldBase * (D_gold * F_gold / (4.0 * NdotL * NdotV + 0.001) * NdotL);
                    color = goldBase * (NdotL * 0.40 + 0.05) + specGold * 1.2;
                    break;
                }
                case 7: {
                    // Polished Chrome Mirror Conductor
                    vec3 chromeBase = vec3(0.96, 0.96, 0.98);
                    float d_c = NdotH * NdotH * (0.0001 - 1.0) + 1.0;
                    float D_c = 0.0001 / (3.14159 * d_c * d_c + 0.0001);
                    vec3 specChrome = chromeBase * (D_c * 0.98 / (4.0 * NdotL * NdotV + 0.001) * NdotL);
                    color = specChrome;
                    break;
                }
            }
            totalRadiance += color * lightCol;
        }

        vec3 reflDir = reflect(inDir, normal);
        vec3 envRefl = evalStudioEnvironment(reflDir);
        if (archetype == 0) {
            totalRadiance += envRefl * 0.50 * pow(clamp(1.0 - NdotV, 0.0, 1.0), 4.0);
        } else if (archetype == 1) {
            totalRadiance += envRefl * 0.25 * pow(clamp(1.0 - NdotV, 0.0, 1.0), 5.0);
        } else if (archetype == 2) {
            vec3 cabinInterior = vec3(0.025, 0.028, 0.032);
            vec3 refrDir = refract(inDir, normal, 1.0 / 1.52);
            if (length(refrDir) < 0.01) refrDir = reflDir;
            vec3 envRefr = evalStudioEnvironment(refrDir);
            vec3 glassInterior = mix(cabinInterior, envRefr, 0.35) * vec3(0.90, 0.94, 0.96);
            float F_glass = 0.04 + 0.96 * pow(clamp(1.0 - NdotV, 0.0, 1.0), 5.0);
            totalRadiance = mix(glassInterior, envRefl, F_glass) + totalRadiance;
        } else if (archetype == 3) {
            totalRadiance += envRefl * 0.15 * pow(clamp(1.0 - NdotV, 0.0, 1.0), 3.0);
        } else if (archetype == 6) {
            vec3 goldBase = vec3(1.00, 0.78, 0.32);
            totalRadiance += envRefl * goldBase * (0.40 + 0.60 * pow(clamp(1.0 - NdotV, 0.0, 1.0), 5.0));
        } else if (archetype == 7) {
            rayQueryEXT chromeQuery;
            rayQueryInitializeEXT(chromeQuery, topLevelAS, gl_RayFlagsNoneEXT, 0xFF, hitPos + normal * 0.015, 0.001, reflDir, 25.0);
            while (rayQueryProceedEXT(chromeQuery)) {}

            vec3 reflColor;
            if (rayQueryGetIntersectionTypeEXT(chromeQuery, true) != 0) {
                uint rPrim = rayQueryGetIntersectionPrimitiveIndexEXT(chromeQuery, true);
                if (rPrim < PRIM_KNOT_PAINT_END) reflColor = vec3(0.68, 0.01, 0.02);
                else if (rPrim < PRIM_KNOT_JADE_END) reflColor = vec3(0.06, 0.75, 0.65);
                else if (rPrim < PRIM_KNOT_CHROME_END) reflColor = vec3(0.85, 0.85, 0.88);
                else if (rPrim < PRIM_KNOT_VELVET_END) reflColor = vec3(0.60, 0.02, 0.42);
                else if (rPrim < PRIM_KNOT_RUST_END) reflColor = vec3(0.80, 0.35, 0.12);
                else if (rPrim < PRIM_SPHERE_END) reflColor = vec3(0.06, 0.75, 0.65);
                else if (rPrim < PRIM_PEDESTAL_END) reflColor = vec3(0.90, 0.75, 0.30);
                else if (rPrim < PRIM_SUZANNE_END) reflColor = vec3(0.75, 0.80, 0.85);
                else reflColor = vec3(0.20, 0.21, 0.23);
            } else {
                reflColor = envRefl;
            }
            totalRadiance = mix(totalRadiance, reflColor, 0.96);
        } else if (archetype == 5) {
            if (hitPos.y <= 3.0) {
                rayQueryEXT reflQuery;
                rayQueryInitializeEXT(reflQuery, topLevelAS, gl_RayFlagsNoneEXT, 0xFF, hitPos + normal * 0.015, 0.001, reflDir, 25.0);
                while (rayQueryProceedEXT(reflQuery)) {}

                vec3 reflColor;
                if (rayQueryGetIntersectionTypeEXT(reflQuery, true) != 0) {
                    uint rPrim = rayQueryGetIntersectionPrimitiveIndexEXT(reflQuery, true);
                    if (rPrim < PRIM_KNOT_PAINT_END) reflColor = vec3(0.68, 0.01, 0.02);
                    else if (rPrim < PRIM_KNOT_JADE_END) reflColor = vec3(0.06, 0.75, 0.65);
                    else if (rPrim < PRIM_KNOT_CHROME_END) reflColor = vec3(0.85, 0.85, 0.88);
                    else if (rPrim < PRIM_KNOT_VELVET_END) reflColor = vec3(0.60, 0.02, 0.42);
                    else if (rPrim < PRIM_KNOT_RUST_END) reflColor = vec3(0.80, 0.35, 0.12);
                    else if (rPrim < PRIM_SPHERE_END) reflColor = vec3(0.06, 0.75, 0.65);
                    else if (rPrim < PRIM_PEDESTAL_END) reflColor = vec3(0.90, 0.75, 0.30);
                    else if (rPrim < PRIM_SUZANNE_END) reflColor = vec3(0.75, 0.80, 0.85);
                    else reflColor = vec3(0.20, 0.21, 0.23);
                } else {
                    reflColor = envRefl * 0.25 + vec3(0.04, 0.04, 0.05);
                }

                float fresnelFloor = pow(clamp(1.0 - NdotV, 0.0, 1.0), 5.0);
                totalRadiance += reflColor * (0.03 + 0.15 * fresnelFloor);
            }
        }

        return totalRadiance;
    }
}


void main() {
    uint idx = (gl_NumWorkGroups.y > 1u) ? (gl_GlobalInvocationID.y * pc.width + gl_GlobalInvocationID.x) : (gl_WorkGroupID.x * 32u + gl_LocalInvocationIndex);
    if (idx >= pc.rayCount) return;

    uint threadRays = 0u;
    uint threadHits = 0u;

    uint rngState = idx + pc.seed;

    vec3 camPos, camForward, camRight, camUp;
    float fov;
    getCamera(pc.sceneType, camPos, camForward, camRight, camUp, fov);

    uint px_u, py_u;
    computePixelCoords(idx, pc.spatialPattern, pc.width, pc.height, px_u, py_u);
    uint pixelIdx = py_u * pc.width + px_u;

    float halfH = float(pc.height) * 0.5;
    float px = float(px_u) - float(pc.width) * 0.5 + 0.5;
    float py = float(py_u) - halfH + 0.5;
    vec3 rayDir = normalize(camForward + (px / halfH * fov) * camRight - (py / halfH * fov) * camUp);
    vec3 rayOrigin = camPos;
    float tMaxPrimary = (pc.isGltf != 0u) ? 5000.0 : ((pc.sceneType == SCENE_OUTDOOR_TERRAIN) ? 2500.0 : 50.0);
    float tMinPrimary = (pc.isGltf != 0u) ? 0.1 : ((pc.sceneType == SCENE_OUTDOOR_TERRAIN) ? 0.05 : 0.01);

    if (pc.mode == 1) {
        // Mode 1: Multi-Bounce Path Tracing with Russian Roulette (Megakernel SIMD Lane Starvation)
        vec3 curOrigin = rayOrigin;
        vec3 curDir = rayDir;
        for (uint b = 0; b < pc.bounces; ++b) {
            threadRays++;
            rayQueryEXT query;
            rayQueryInitializeEXT(query, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, curOrigin, (b == 0 ? tMinPrimary : (pc.isGltf != 0u ? 0.05 : 0.005)), curDir, tMaxPrimary);
            while (rayQueryProceedEXT(query)) {}

            if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
                threadHits++;
                float t = rayQueryGetIntersectionTEXT(query, true);
                vec3 hitPos = curOrigin + curDir * t;
                uint primId = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
                vec2 bary = rayQueryGetIntersectionBarycentricsEXT(query, true);
                vec3 normal = computeSmoothNormal(pc.sceneType, primId, hitPos, curDir, bary);

                float u1 = rand_float(rngState);
                float u2 = rand_float(rngState);
                curDir = align_to_normal(cosine_sample_hemisphere(u1, u2), normal);
                curOrigin = hitPos + normal * (pc.isGltf != 0u ? 0.05 : 0.005);

                // Russian roulette: 40% termination probability on bounce >= 2
                // Inactive lanes stall while surviving lanes continue looping
                if (b >= 2 && rand_float(rngState) < 0.4) {
                    break;
                }
            } else {
                break;
            }
        }
    } else if (pc.mode == 2) {
        // Mode 2: Incoherent Secondary GI (Hemisphere Scattering without Spatial Binning)
        threadRays++;
        rayQueryEXT query1;
        rayQueryInitializeEXT(query1, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, rayOrigin, tMinPrimary, rayDir, tMaxPrimary);
        while (rayQueryProceedEXT(query1)) {}

        if (rayQueryGetIntersectionTypeEXT(query1, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
            threadHits++;
            float t = rayQueryGetIntersectionTEXT(query1, true);
            vec3 hitPos = rayOrigin + rayDir * t;
            uint primId = rayQueryGetIntersectionPrimitiveIndexEXT(query1, true);
            vec2 bary = rayQueryGetIntersectionBarycentricsEXT(query1, true);
            vec3 normal = computeSmoothNormal(pc.sceneType, primId, hitPos, rayDir, bary);

            float u1 = rand_float(rngState);
            float u2 = rand_float(rngState);
            vec3 incohDir = align_to_normal(cosine_sample_hemisphere(u1, u2), normal);

            threadRays++;
            rayQueryEXT query2;
            float tMaxSec = (pc.isGltf != 0u) ? 5000.0 : ((pc.sceneType == SCENE_OUTDOOR_TERRAIN) ? 500.0 : 20.0);
            rayQueryInitializeEXT(query2, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, hitPos + normal * (pc.isGltf != 0u ? 0.05 : 0.005), 0.001, incohDir, tMaxSec);
            while (rayQueryProceedEXT(query2)) {}

            if (rayQueryGetIntersectionTypeEXT(query2, true) != 0) {
                threadHits++;
            }
        }
    } else if (pc.mode == 3) {
        // Mode 3: Stage Breakdown - Pure BVH Traversal Only
        threadRays++;
        rayQueryEXT query;
        rayQueryInitializeEXT(query, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, rayOrigin, tMinPrimary, rayDir, tMaxPrimary);
        while (rayQueryProceedEXT(query)) {}

        if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
            threadHits++;
        }
    } else if (pc.mode == 4) {
        // Mode 4: Stage Breakdown - Pure Material Shading (Megakernel Divergent, No BVH)
        threadRays++;
        threadHits++;
        vec3 pixelColor;
        if (pc.isGltf != 0u) {
            uint matId = idx % 8u;
            GltfMaterialGpu mat = matBuf.materials[matId];
            vec3 dummyPos = vec3(float(px_u) * 0.01, float(py_u) * 0.01, 1.5);
            vec3 dummyNorm = ((idx % 2) == 0) ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
            vec4 dummyTan = vec4(1.0, 0.0, 0.0, 1.0);
            vec2 dummyUv = vec2(float(px_u) / float(pc.width), float(py_u) / float(pc.height));
            pixelColor = evaluateGltfPbr(mat, dummyPos, dummyNorm, dummyNorm, dummyTan, dummyUv, rayDir, pc.sceneType, false);
        } else {
            vec3 hitPos = vec3(float(px_u) * 0.01, float(py_u) * 0.01, 1.5);
            vec3 normal = ((idx % 2) == 0) ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
            uint matId = idx % 8; // Divergent materials across lanes in the wave
            pixelColor = evalMaterialBSDF(pc.sceneType, matId, normal, rayDir, hitPos, rngState);
        }
        if (pc.dumpRenders != 0) {
            fb.pixels[pixelIdx] = vec4(tonemapACES(pixelColor * 1.0), 1.0);
        }
    } else if (pc.mode == 5) {
        // Mode 5: Directional Shadow Ray Traversal (Traditional Megakernel)
        // Tests visibility from primary surface hits to key light / sun.
        // Heavy SIMD divergence: lanes with occluders terminate early, open-sky lanes traverse full BVH.
        rayQueryEXT query;
        rayQueryInitializeEXT(query, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, rayOrigin, tMinPrimary, rayDir, tMaxPrimary);
        while (rayQueryProceedEXT(query)) {}

        if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
            float t = rayQueryGetIntersectionTEXT(query, true);
            vec3 hitPos = rayOrigin + rayDir * t;
            uint primId = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
            vec2 rawBary = rayQueryGetIntersectionBarycentricsEXT(query, true);
            vec3 geomNormal;
            if (pc.isGltf != 0u) {
                uint base = primId * 36u;
                vec3 p0 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
                vec3 p1 = vec3(vbuf.vertices[base + 12], vbuf.vertices[base + 13], vbuf.vertices[base + 14]);
                vec3 p2 = vec3(vbuf.vertices[base + 24], vbuf.vertices[base + 25], vbuf.vertices[base + 26]);
                geomNormal = normalize(cross(p1 - p0, p2 - p0));
            } else {
                geomNormal = computeSmoothNormal(pc.sceneType, primId, hitPos, rayDir, rawBary);
            }

            vec3 lightDir;
            float maxDist;
            if (pc.sceneType == SCENE_INDOOR_ATRIUM) {
                lightDir = normalize(vec3(0.35, 0.90, -0.25));
                maxDist = 10000.0;
            } else if (pc.sceneType == SCENE_SHOWROOM_STUDIO) {
                lightDir = normalize(vec3(0.6, 0.8, 0.5));
                maxDist = 5000.0;
            } else {
                lightDir = normalize(vec3(0.45, 0.35, 0.82));
                maxDist = 2500.0;
            }

            threadRays++;
            bool occluded = false;
            if (dot(geomNormal, lightDir) > 0.0) {
                occluded = traceShadowRay(hitPos, geomNormal, lightDir, maxDist);
                if (occluded) {
                    threadHits++;
                }
            }

            if (pc.dumpRenders != 0) {
                float shadowVal = occluded ? 0.08 : 0.95;
                fb.pixels[pixelIdx] = vec4(vec3(shadowVal), 1.0);
            }
        } else {
            if (pc.dumpRenders != 0) {
                fb.pixels[pixelIdx] = vec4(0.02, 0.03, 0.05, 1.0);
            }
        }
    } else {
        // Mode 0: Primary Ray Tracing + Divergent Material Shading
        threadRays++;

        rayQueryEXT query;
        rayQueryInitializeEXT(query, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, rayOrigin, tMinPrimary, rayDir, tMaxPrimary);
        while (rayQueryProceedEXT(query)) {}

        vec3 pixelColor = vec3(0.0);

        if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
            threadHits++;
            float t = rayQueryGetIntersectionTEXT(query, true);
            vec3 hitPos = rayOrigin + rayDir * t;
            uint primId = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
            vec2 rawBary = rayQueryGetIntersectionBarycentricsEXT(query, true);

            if (pc.isGltf != 0u) {
                vec2 bary = unpackUnorm2x16(packUnorm2x16(rawBary));
                uint base = primId * 36u;
                vec3 p0 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
                vec3 n0 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);
                vec4 t0 = vec4(vbuf.vertices[base + 6], vbuf.vertices[base + 7], vbuf.vertices[base + 8], vbuf.vertices[base + 9]);
                vec2 uv0 = vec2(vbuf.vertices[base + 10], vbuf.vertices[base + 11]);

                base += 12u;
                vec3 p1 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
                vec3 n1 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);
                vec4 t1 = vec4(vbuf.vertices[base + 6], vbuf.vertices[base + 7], vbuf.vertices[base + 8], vbuf.vertices[base + 9]);
                vec2 uv1 = vec2(vbuf.vertices[base + 10], vbuf.vertices[base + 11]);

                base += 12u;
                vec3 p2 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
                vec3 n2 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);
                vec4 t2 = vec4(vbuf.vertices[base + 6], vbuf.vertices[base + 7], vbuf.vertices[base + 8], vbuf.vertices[base + 9]);
                vec2 uv2 = vec2(vbuf.vertices[base + 10], vbuf.vertices[base + 11]);

                float w = 1.0 - bary.x - bary.y;
                vec3 interpHitPos = w * p0 + bary.x * p1 + bary.y * p2;
                vec3 geomNormal = normalize(cross(p1 - p0, p2 - p0));
                vec3 sn = w * n0 + bary.x * n1 + bary.y * n2;
                vec3 smoothNormal = (length(sn) > 1e-4) ? normalize(sn) : geomNormal;
                vec4 tangent = w * t0 + bary.x * t1 + bary.y * t2;
                vec2 uv = w * uv0 + bary.x * uv1 + bary.y * uv2;

                uint matId = triMatBuf.triangleMats[primId];
                GltfMaterialGpu mat = matBuf.materials[matId];
                pixelColor = evaluateGltfPbr(mat, interpHitPos, geomNormal, smoothNormal, tangent, uv, rayDir, pc.sceneType);
            } else {
                vec3 normal = computeSmoothNormal(pc.sceneType, primId, hitPos, rayDir, rawBary);
                uint matId = computeMaterialId(pc.sceneType, primId, hitPos, normal);
                pixelColor = evalMaterialBSDF(pc.sceneType, matId, normal, rayDir, hitPos, rngState);
            }
        } else {
            pixelColor = evalSky(pc.sceneType, rayDir);
        }

        if (pc.dumpRenders != 0) {
            fb.pixels[pixelIdx] = vec4(tonemapACES(pixelColor * 1.0), 1.0);
        }
    }

    uint waveRays = subgroupAdd(threadRays);
    uint waveHits = subgroupAdd(threadHits);
    if (subgroupElect()) {
        if (waveRays > 0u) atomicAdd(results.totalRays, waveRays);
        if (waveHits > 0u) atomicAdd(results.totalHits, waveHits);
    }
}
