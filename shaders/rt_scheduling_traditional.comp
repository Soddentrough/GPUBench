layout(push_constant) uniform PushConstants {
    uint rayCount;
    uint mode;            // 0: Primary/Mat, 1: Multi-Bounce Path Tracing, 2: Incoherent GI, 3: BVH, 4: Shading
    uint bounces;         // Max bounces (for mode 1)
    uint seed;
    uint dumpRenders;     // 1: dump pixels to fb
    uint width;
    uint height;
    uint spatialPattern;  // 0: Linear 32x1, 1: Tiled 8x4, 2: Morton 8x4, 3: Morton 4x8
    uint sceneType;       // 0: Showroom Studio, 1: Outdoor Terrain, 2: Indoor Atrium
    uint isGltf;          // 1 if glTF PBR scene, 0 if procedural
} pc;


