#version 460
// GPUBench Dual-Issue & Concurrency Benchmark Suite
// Config 3: ILP-16 (Peak Dual-Issue Saturated FP32)
// Evaluates peak dual-issue throughput where 16 independent accumulator chains
// (64 scalar accumulators in flight) fully saturate the dual execution pipelines.

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Data {
    float data[];
} InOutBuffer;

layout(push_constant) uniform PushConstants {
    float multiplier;
    uint num_elements;
} pushConstants;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pushConstants.num_elements) return;

    // 16 independent accumulator chains
    float base = InOutBuffer.data[index];
    vec4 val0  = vec4(base);
    vec4 val1  = vec4(base + 0.1);
    vec4 val2  = vec4(base + 0.2);
    vec4 val3  = vec4(base + 0.3);
    vec4 val4  = vec4(base + 0.4);
    vec4 val5  = vec4(base + 0.5);
    vec4 val6  = vec4(base + 0.6);
    vec4 val7  = vec4(base + 0.7);
    vec4 val8  = vec4(base + 0.8);
    vec4 val9  = vec4(base + 0.9);
    vec4 val10 = vec4(base + 1.0);
    vec4 val11 = vec4(base + 1.1);
    vec4 val12 = vec4(base + 1.2);
    vec4 val13 = vec4(base + 1.3);
    vec4 val14 = vec4(base + 1.4);
    vec4 val15 = vec4(base + 1.5);

    vec4 m = vec4(pushConstants.multiplier);
    vec4 c0  = vec4(0.0001, 0.0002, 0.0003, 0.0004);
    vec4 c1  = vec4(0.0005, 0.0006, 0.0007, 0.0008);
    vec4 c2  = vec4(0.0009, 0.0010, 0.0011, 0.0012);
    vec4 c3  = vec4(0.0013, 0.0014, 0.0015, 0.0016);
    vec4 c4  = vec4(0.0017, 0.0018, 0.0019, 0.0020);
    vec4 c5  = vec4(0.0021, 0.0022, 0.0023, 0.0024);
    vec4 c6  = vec4(0.0025, 0.0026, 0.0027, 0.0028);
    vec4 c7  = vec4(0.0029, 0.0030, 0.0031, 0.0032);
    vec4 c8  = vec4(0.0033, 0.0034, 0.0035, 0.0036);
    vec4 c9  = vec4(0.0037, 0.0038, 0.0039, 0.0040);
    vec4 c10 = vec4(0.0041, 0.0042, 0.0043, 0.0044);
    vec4 c11 = vec4(0.0045, 0.0046, 0.0047, 0.0048);
    vec4 c12 = vec4(0.0049, 0.0050, 0.0051, 0.0052);
    vec4 c13 = vec4(0.0053, 0.0054, 0.0055, 0.0056);
    vec4 c14 = vec4(0.0057, 0.0058, 0.0059, 0.0060);
    vec4 c15 = vec4(0.0061, 0.0062, 0.0063, 0.0064);

    // 16384 iterations * 16 vec4 FMAs = 16384 * 128 = 2,097,152 FP32 operations
    for (int i = 0; i < 16384; ++i) {
        val0  = fma(val0,  m, c0);
        val1  = fma(val1,  m, c1);
        val2  = fma(val2,  m, c2);
        val3  = fma(val3,  m, c3);
        val4  = fma(val4,  m, c4);
        val5  = fma(val5,  m, c5);
        val6  = fma(val6,  m, c6);
        val7  = fma(val7,  m, c7);
        val8  = fma(val8,  m, c8);
        val9  = fma(val9,  m, c9);
        val10 = fma(val10, m, c10);
        val11 = fma(val11, m, c11);
        val12 = fma(val12, m, c12);
        val13 = fma(val13, m, c13);
        val14 = fma(val14, m, c14);
        val15 = fma(val15, m, c15);
    }

    vec4 s0 = (val0 + val1) + (val2 + val3);
    vec4 s1 = (val4 + val5) + (val6 + val7);
    vec4 s2 = (val8 + val9) + (val10 + val11);
    vec4 s3 = (val12 + val13) + (val14 + val15);
    vec4 res = (s0 + s1) + (s2 + s3);

    InOutBuffer.data[index] = res.x + res.y + res.z + res.w;
}
