#version 460
// GPUBench Dual-Issue & Concurrency Benchmark Suite
// Config 3: ILP-16 (Peak Dual-Issue Saturated FP32)
// Evaluates peak dual-issue throughput where 16 independent accumulator chains
// (64 scalar accumulators in flight) fully saturate the dual execution pipelines.

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Data {
    float data[];
} InOutBuffer;

layout(push_constant) uniform PushConstants {
    float multiplier;
    uint num_elements;
} pushConstants;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pushConstants.num_elements) return;

    // 8 independent vec4 accumulator chains (32 scalar accumulators in flight):
    // Perfectly sized to saturate dual-issue execution units while maintaining 100% wavefront occupancy.
    float base = InOutBuffer.data[index];
    vec4 val0 = vec4(base);
    vec4 val1 = vec4(base + 0.1);
    vec4 val2 = vec4(base + 0.2);
    vec4 val3 = vec4(base + 0.3);
    vec4 val4 = vec4(base + 0.4);
    vec4 val5 = vec4(base + 0.5);
    vec4 val6 = vec4(base + 0.6);
    vec4 val7 = vec4(base + 0.7);

    vec4 m = vec4(pushConstants.multiplier);
    vec4 c0 = vec4(0.0001, 0.0002, 0.0003, 0.0004);
    vec4 c1 = vec4(0.0005, 0.0006, 0.0007, 0.0008);
    vec4 c2 = vec4(0.0009, 0.0010, 0.0011, 0.0012);
    vec4 c3 = vec4(0.0013, 0.0014, 0.0015, 0.0016);
    vec4 c4 = vec4(0.0017, 0.0018, 0.0019, 0.0020);
    vec4 c5 = vec4(0.0021, 0.0022, 0.0023, 0.0024);
    vec4 c6 = vec4(0.0025, 0.0026, 0.0027, 0.0028);
    vec4 c7 = vec4(0.0029, 0.0030, 0.0031, 0.0032);

    // 32768 iterations * 8 vec4 FMAs = 32768 * 64 = 2,097,152 FP32 operations
    for (int i = 0; i < 32768; ++i) {
        val0 = fma(val0, m, c0);
        val1 = fma(val1, m, c1);
        val2 = fma(val2, m, c2);
        val3 = fma(val3, m, c3);
        val4 = fma(val4, m, c4);
        val5 = fma(val5, m, c5);
        val6 = fma(val6, m, c6);
        val7 = fma(val7, m, c7);
    }

    vec4 res = (val0 + val1) + (val2 + val3) + (val4 + val5) + (val6 + val7);
    InOutBuffer.data[index] = res.x + res.y + res.z + res.w;
}
