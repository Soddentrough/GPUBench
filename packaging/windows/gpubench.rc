#include <windows.h>

// Icon
1 ICON "icon.ico"

// Manifest (embedded directly for MinGW; MSVC linker handles via build system)
#ifdef EMBED_RC_MANIFEST
1 RT_MANIFEST "gpubench.manifest"
#endif

// Version Info
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,4,6,0
PRODUCTVERSION  1,4,6,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Soddentrough"
            VALUE "FileDescription",  "GPUBench GPU Compute and Ray Tracing Benchmark"
            VALUE "FileVersion",      "1.4.6.0"
            VALUE "InternalName",     "gpubench"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Soddentrough"
            VALUE "OriginalFilename", "gpubench.exe"
            VALUE "ProductName",      "GPUBench"
            VALUE "ProductVersion",   "1.4.6.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
