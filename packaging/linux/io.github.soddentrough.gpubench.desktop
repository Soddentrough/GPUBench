[Desktop Entry]
Type=Application
Version=1.5
Name=GPUBench
GenericName=GPU Compute Benchmark
Comment=Vulkan 1.4 GPU compute and hardware ray tracing benchmark (optional ROCm and OpenCL backends)
Exec=gpubench-gui
Icon=io.github.soddentrough.gpubench
Terminal=false
Categories=System;Monitor;X-Benchmark;
Keywords=GPU;Benchmark;Vulkan;ROCm;OpenCL;RayTracing;Compute;Hardware;
StartupNotify=true
StartupWMClass=gpubench-gui
MimeType=application/x-gpubench+json;
Actions=AutoRun;

[Desktop Action AutoRun]
Name=Auto-Run Benchmarks
Exec=gpubench-gui --auto-run
