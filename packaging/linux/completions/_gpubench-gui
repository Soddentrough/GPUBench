#compdef gpubench-gui

_gpubench_gui() {
    local -a opts
    local benchmarks='(fp64 fp32 dualissue lds indirect fp16 bf16 fp8 fp6 fp4 int8 int4 sparsematrix coopvector membw interconnect l0b l1b l2b l3b cachebw l0_cache cache_latency_curve asyncoverlap pixelfill rayrawtraversal rayasbuild rayintersect rayanyhit rayomm rayprocedural raypayload rayscheduling raydivergence sysmembw sysmemlatency all)'
    opts=(
        '(-h --help)'{-h,--help}'[Print help message and exit]'
        '(-v --version)'{-v,--version}'[Display program version information and exit]'
        '(-d --device)'{-d,--device}'[Target GPU device index(es)]:device:'
        '(-k --backend)'{-k,--backend}'[Pre-select compute backend]:backend:(auto vulkan opencl rocm)'
        "(-b --benchmark --benchmarks -t --test)"{-b,--benchmark,--benchmarks,-t,--test}"[Pre-select benchmark(s)]:benchmark:${benchmarks}"
        '(-g --group --groups)'{-g,--group,--groups}'[Pre-select benchmark category]:group:(compute memory scheduling graphics raster raytracing system all)'
        '(-s --scene)'{-s,--scene}'[Pre-select Ray Tracing scene]:scene:(all showroom indoor outdoor forest)'
        '(-r --res --resolution)'{-r,--res,--resolution}'[Pre-select render resolution]:resolution:(auto 720p 1080p 1440p 4k 8k 1024x1024)'
        '--spp[Samples per pixel for path tracing accumulation (1..256)]:spp:(1 2 4 8 16 32 64 128 256)'
        '(-i --import --input)'{-i,--import,--input}'[Import unified JSON session file on startup]:file:_files -g "*.json"'
        '--compare[Load baseline JSON file for comparison]:file:_files -g "*.json"'
        '(-o --output --output-json)'{-o,--output,--output-json}'[Export unified v2.0 JSON results upon completion]:file:_files -g "*.json"'
        '(--dump --dump-renders)'{--dump,--dump-renders}'[Enable saving rendered scene PNGs to disk]'
        '(--no-dump --no-dump-renders)'{--no-dump,--no-dump-renders}'[Disable saving rendered scene PNGs to disk]'
        '(--auto-run --auto-start --run)'{--auto-run,--auto-start,--run}'[Automatically start benchmarks upon launch]'
        '--roofline[Open the Empirical Roofline chart tab]'
        '--exit-on-complete[Exit automatically when benchmark run finishes]'
        '--frames[Run for specified number of frames and exit]:frames:'
        '--screenshot[Save rendered GUI window PNG before exit]:file:_files -g "*.png"'
        '(--ui-scale --scale)'{--ui-scale,--scale}'[Override UI DPI scaling factor]:scale:(1.0 1.25 1.5 1.75 2.0 2.5)'
        '--mode[Initial instrument mode]:mode:(f1 isa f2 charts perf roofline scorecard f3 rt viewport)'
        '--palette[Bring-up phosphor palette]:palette:(amber green paper)'
        '--verbose[Enable verbose logging output]'
        '--debug[Enable Vulkan Khronos Validation Layers]'
        '*:session_file:_files -g "*.json"'
    )
    _arguments -s $opts
}

_gpubench_gui "$@"
