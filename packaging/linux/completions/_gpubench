#compdef gpubench

_gpubench() {
    local -a opts
    opts=(
        '(-h --help)'{-h,--help}'[Print help message and exit]'
        '--version[Display version information and exit]'
        '(-b --benchmark --benchmarks)'{-b,--benchmark,--benchmarks}'[Benchmarks to run]:benchmark:(fp32 fp64 fp16 bf16 fp8 fp4 int8 int4 mem_bandwidth l1_cache pixel_fill ray_scheduling all)'
        '(-g --group --groups)'{-g,--group,--groups}'[Benchmark group(s) to run]:group:(compute memory raster graphics raytracing system all)'
        '--list-benchmarks[List available benchmarks]'
        '--list-groups[List available benchmark groups]'
        '(-d --device)'{-d,--device}'[Device(s) to use]:device:'
        '(-l --list-devices)'{-l,--list-devices}'[List available devices]'
        '--list-backends[List available backends]'
        '(-k --backend)'{-k,--backend}'[Backend to use]:backend:(auto vulkan opencl rocm)'
        '--verbose[Enable verbose logging]'
        '--debug[Enable debug logging]'
        '--dump-geometry[Dump ray tracing geometry to OBJ files]'
        '(--dump --dump-renders)'{--dump,--dump-renders}'[Dump and compare rendered frames]'
        '(-s --scene)'{-s,--scene}'[Ray tracing benchmark scenario]:scene:(showroom indoor outdoor all)'
        '(-r --resolution)'{-r,--resolution}'[Resolution preset]:resolution:(auto 720p 1080p 1440p 4k 1024x1024)'
        '--bounces[Number of light bounces for path tracing (1..8)]:bounces:(1 2 3 4 5 6 7 8)'
        '(-c --config)'{-c,--config}'[Configuration index]:config:'
        '--profile-snapshot[Run in profiling snapshot mode]'
        '--rra[Enable Radeon Raytracing Analyzer trace capture]'
        '--output[Machine-readable output format]:format:(json csv)'
        '--output-file[Write machine-readable output to file]:file:_files'
    )
    _arguments -s $opts
}

_gpubench "$@"
