#compdef gpubench

_gpubench() {
    local -a opts
    opts=(
        '(-h --help)'{-h,--help}'[Print help message and exit]'
        '--version[Display version information and exit]'
        '(-b --benchmark --benchmarks)'{-b,--benchmark,--benchmarks}'[Benchmarks to run]:benchmark:(fp64 fp32 dualissue lds indirect fp16 bf16 fp8 fp6 fp4 int8 int4 membw l0_cache cache_latency_curve pixelfill rayrawtraversal rayasbuild rayintersect rayanyhit rayprocedural rayscheduling raydivergence sysmembw sysmemlatency all)'
        '(-g --group --groups)'{-g,--group,--groups}'[Benchmark group(s) to run]:group:(compute memory raster graphics raytracing system all)'
        '(--list --list-benchmarks)'{--list,--list-benchmarks}'[List available benchmarks]'
        '--list-groups[List available benchmark groups]'
        '(-d --device)'{-d,--device}'[Device(s) to use]:device:'
        '(-l --list-devices)'{-l,--list-devices}'[List available devices]'
        '--list-backends[List available backends]'
        '(-k --backend)'{-k,--backend}'[Backend to use]:backend:(auto vulkan opencl rocm)'
        '--verbose[Enable verbose logging]'
        '--debug[Enable debug logging]'
        '(-q --quiet)'{-q,--quiet}'[Suppress informational banners and progress output]'
        '--strict[Return non-zero exit code if any requested benchmark fails or is unsupported]'
        '(-f --force)'{-f,--force}'[Force execution despite concurrent GPU activity]'
        '--verify-parity[Enforce strict Megakernel vs. DGC visual parity verification]'
        '--dump-geometry[Dump ray tracing geometry to OBJ files]'
        '(--dump --dump-renders)'{--dump,--dump-renders}'[Dump and compare rendered frames]'
        '(--no-dump --no-dump-renders)'{--no-dump,--no-dump-renders}'[Disable dumping rendered frames]'
        '(-s --scene)'{-s,--scene}'[Ray tracing benchmark scenario]:scene:(all showroom indoor outdoor forest)'
        '(-r --resolution)'{-r,--resolution}'[Resolution preset]:resolution:(auto 720p 1080p 1440p 4k 8k 1024x1024)'
        '--bounces[Number of light bounces for path tracing (1..8)]:bounces:(1 2 3 4 5 6 7 8)'
        '--spp[Number of samples per pixel for path tracing]:spp:(1 2 4 8 16 32 64)'
        '(-c --config)'{-c,--config}'[Configuration index]:config:'
        '--profile-snapshot[Run in profiling snapshot mode]'
        '--rra[Enable Radeon Raytracing Analyzer trace capture]'
        '(-o --output-json)'{-o,--output-json}'[Write benchmark results to JSON file]:file:_files -g "*.json"'
        '--json[Write pure JSON report to stdout]'
        '(-i --import --input)'{-i,--import,--input}'[Load and display results from JSON file(s)]:file:_files -g "*.json"'
        '--compare[Compare benchmark JSON report files]:file:_files -g "*.json"'
    )
    _arguments -s $opts
}

_gpubench "$@"
