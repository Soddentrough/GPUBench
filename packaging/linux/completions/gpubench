# bash completion for gpubench

_gpubench() {
    local cur prev words cword
    _init_completion || return

    local opts="-h --help -v --version -b --benchmark --benchmarks -g --group --groups --list --list-benchmarks --list-groups -d --device -l --list-devices --list-backends -k --backend --verbose --debug -q --quiet --power --telemetry --roofline --dump-geometry --dump-renders --dump --no-dump-renders --no-dump --verify-parity --strict -f --force -s --scene -r --res --resolution -c --config --bounces --spp --profile-snapshot --rra --dump-isa --asic --full-isa -o --output --output-json --json -i --import --input --compare"
    local benchmarks="fp64 fp32 dualissue lds indirect fp16 bf16 fp8 fp6 fp4 int8 int4 sparsematrix coopvector membw interconnect l0b l1b l2b l3b cachebw l0_cache cache_latency_curve asyncoverlap pixelfill rayrawtraversal rayasbuild rayintersect rayanyhit rayomm rayprocedural raypayload rayscheduling raydivergence sysmembw sysmemlatency all"

    case "$prev" in
        --bounces)
            COMPREPLY=( $(compgen -W "1 2 3 4 5 6 7 8" -- "$cur") )
            return 0
            ;;
        --spp)
            COMPREPLY=( $(compgen -W "1 2 4 8 16 32 64 128 256" -- "$cur") )
            return 0
            ;;
        -k|--backend)
            COMPREPLY=( $(compgen -W "auto vulkan opencl rocm" -- "$cur") )
            return 0
            ;;
        -g|--group|--groups)
            COMPREPLY=( $(compgen -W "compute memory scheduling graphics raster raytracing system all" -- "$cur") )
            return 0
            ;;
        -s|--scene)
            COMPREPLY=( $(compgen -W "all showroom indoor outdoor forest" -- "$cur") )
            return 0
            ;;
        -r|--res|--resolution)
            COMPREPLY=( $(compgen -W "auto 720p 1080p 1440p 4k 8k 1024x1024" -- "$cur") )
            return 0
            ;;
        -o|--output|--output-json|--json|-i|--import|--input|--compare)
            _filedir json
            return 0
            ;;
        -b|--benchmark|--benchmarks|--dump-isa)
            COMPREPLY=( $(compgen -W "$benchmarks" -- "$cur") )
            return 0
            ;;
    esac

    if [[ "$cur" == -* ]]; then
        COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
        return 0
    fi
}

complete -F _gpubench gpubench
