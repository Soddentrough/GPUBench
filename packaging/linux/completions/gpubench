# bash completion for gpubench

_gpubench() {
    local cur prev words cword
    _init_completion || return

    local opts="--help -h --version --benchmarks --benchmark -b --groups --group -g --list --list-benchmarks --list-groups --device -d --list-devices -l --list-backends --backend -k --verbose --debug -q --quiet --strict -f --force --verify-parity --dump-geometry --dump-renders --dump --no-dump-renders --no-dump -s --scene -r --resolution --bounces --spp -c --config --profile-snapshot --rra -o --output-json --json -i --import --input --compare"

    case "$prev" in
        --bounces)
            COMPREPLY=( $(compgen -W "1 2 3 4 5 6 7 8" -- "$cur") )
            return 0
            ;;
        --spp)
            COMPREPLY=( $(compgen -W "1 2 4 8 16 32 64" -- "$cur") )
            return 0
            ;;
        -k|--backend)
            COMPREPLY=( $(compgen -W "auto vulkan opencl rocm" -- "$cur") )
            return 0
            ;;
        -g|--group|--groups)
            COMPREPLY=( $(compgen -W "compute memory raster graphics raytracing system all" -- "$cur") )
            return 0
            ;;
        -s|--scene)
            COMPREPLY=( $(compgen -W "all showroom indoor outdoor forest" -- "$cur") )
            return 0
            ;;
        -r|--resolution)
            COMPREPLY=( $(compgen -W "auto 720p 1080p 1440p 4k 8k 1024x1024" -- "$cur") )
            return 0
            ;;
        -o|--output-json|-i|--import|--input|--compare)
            _filedir json
            return 0
            ;;
        -b|--benchmark|--benchmarks)
            COMPREPLY=( $(compgen -W "fp64 fp32 dualissue lds indirect fp16 bf16 fp8 fp6 fp4 int8 int4 membw l0_cache cache_latency_curve pixelfill rayrawtraversal rayasbuild rayintersect rayanyhit rayprocedural rayscheduling raydivergence sysmembw sysmemlatency all" -- "$cur") )
            return 0
            ;;
    esac

    if [[ "$cur" == -* ]]; then
        COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
        return 0
    fi
}

complete -F _gpubench gpubench
