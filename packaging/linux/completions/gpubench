# bash completion for gpubench

_gpubench() {
    local cur prev words cword
    _init_completion || return

    local opts="--help --version --benchmarks --benchmark -b --groups --group -g --list-benchmarks --list-groups --device -d --list-devices --list-backends --backend -k --verbose --debug --dump-geometry --dump-renders --dump -s --scene -r --resolution --bounces -c --config --profile-snapshot --rra -o --output-json --output-file -i --import --compare"

    case "$prev" in
        --bounces)
            COMPREPLY=( $(compgen -W "1 2 3 4 5 6 7 8" -- "$cur") )
            return 0
            ;;
        -k|--backend)
            COMPREPLY=( $(compgen -W "auto vulkan opencl rocm" -- "$cur") )
            return 0
            ;;
        -g|--group|--groups)
            COMPREPLY=( $(compgen -W "compute memory raster graphics raytracing system all" -- "$cur") )
            return 0
            ;;
        -s|--scene)
            COMPREPLY=( $(compgen -W "all showroom indoor outdoor forest" -- "$cur") )
            return 0
            ;;
        -r|--resolution)
            COMPREPLY=( $(compgen -W "auto 720p 1080p 1440p 4k 1024x1024" -- "$cur") )
            return 0
            ;;
        -o|--output-json|--output-file|-i|--import|--compare)
            _filedir json
            return 0
            ;;
        -b|--benchmark|--benchmarks)
            COMPREPLY=( $(compgen -W "fp32 fp64 fp16 bf16 fp8 fp4 int8 int4 mem_bandwidth l1_cache pixel_fill ray_scheduling all" -- "$cur") )
            return 0
            ;;
    esac

    if [[ "$cur" == -* ]]; then
        COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
        return 0
    fi
}

complete -F _gpubench gpubench
