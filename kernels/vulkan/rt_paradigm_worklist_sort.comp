#version 460
#extension GL_EXT_ray_query : enable

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1) buffer Results { uint dummy; } results;

struct CompactRayPayload {
    vec4 originAndMatId;
    vec4 directionAndSeed;
    vec4 throughputAndMorton;
};

layout(set = 0, binding = 2) buffer WorkListBuffer {
    uint queueCounters[32];
    CompactRayPayload rayRecords[131072];
} worklist;

layout(push_constant) uniform PushConstants {
    uint p; // Bitonic sort stage p
    uint q; // Bitonic sort step q
    uint count;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;

    // Bitonic sort step: compare and swap elements based on Morton code
    uint j = i ^ pc.q;
    if (j > i && j < pc.count) {
        uint mortonI = floatBitsToUint(worklist.rayRecords[i].throughputAndMorton.w);
        uint mortonJ = floatBitsToUint(worklist.rayRecords[j].throughputAndMorton.w);

        bool ascending = ((i & pc.p) == 0);
        if ((mortonI > mortonJ) == ascending) {
            // Swap records i and j
            CompactRayPayload tmp = worklist.rayRecords[i];
            worklist.rayRecords[i] = worklist.rayRecords[j];
            worklist.rayRecords[j] = tmp;
        }
    }
}
