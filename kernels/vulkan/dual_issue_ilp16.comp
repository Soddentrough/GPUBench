#version 460
// GPUBench Dual-Issue & Concurrency Benchmark Suite
// Config 2: Dual-Issue FP32 (Peak Co-Issue - 16 chains)
// Evaluates peak dual-issue throughput with 16 independent scalar accumulator chains.

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Data {
    float data[];
} InOutBuffer;

layout(push_constant) uniform PushConstants {
    float multiplier;
    uint num_elements;
} pushConstants;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pushConstants.num_elements) return;

    float base = InOutBuffer.data[index];
    float val0  = base;
    float val1  = base + 0.05;
    float val2  = base + 0.10;
    float val3  = base + 0.15;
    float val4  = base + 0.20;
    float val5  = base + 0.25;
    float val6  = base + 0.30;
    float val7  = base + 0.35;
    float val8  = base + 0.40;
    float val9  = base + 0.45;
    float val10 = base + 0.50;
    float val11 = base + 0.55;
    float val12 = base + 0.60;
    float val13 = base + 0.65;
    float val14 = base + 0.70;
    float val15 = base + 0.75;

    float m = pushConstants.multiplier;

    // 65536 iterations * 16 scalar FMAs = 65536 * 32 = 2,097,152 FP32 operations
    // Using register-register operands enables RDNA 3/4 dual-issue (v_dual_fmac_f32) pair scheduling
    for (int i = 0; i < 65536; ++i) {
        val0  = fma(val0,  m, val1);
        val1  = fma(val1,  m, val2);
        val2  = fma(val2,  m, val3);
        val3  = fma(val3,  m, val4);
        val4  = fma(val4,  m, val5);
        val5  = fma(val5,  m, val6);
        val6  = fma(val6,  m, val7);
        val7  = fma(val7,  m, val8);
        val8  = fma(val8,  m, val9);
        val9  = fma(val9,  m, val10);
        val10 = fma(val10, m, val11);
        val11 = fma(val11, m, val12);
        val12 = fma(val12, m, val13);
        val13 = fma(val13, m, val14);
        val14 = fma(val14, m, val15);
        val15 = fma(val15, m, val0);
    }

    InOutBuffer.data[index] = ((val0 + val1) + (val2 + val3)) +
                             ((val4 + val5) + (val6 + val7)) +
                             ((val8 + val9) + (val10 + val11)) +
                             ((val12 + val13) + (val14 + val15));
}
