#version 460
#extension GL_EXT_ray_query : enable
#extension GL_EXT_ray_flags_primitive_culling : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1) buffer Results {
    uint totalRays;
    uint totalHits;
    float accumulatedLuminance;
} results;

#include "rt_scheduling_common.glsl"

layout(set = 0, binding = 2) buffer WorkListBuffer {
    uint queueCounters[Q_HEADER_UINT_CAP];
    vec4 rayRecords[];
} worklist;

layout(set = 0, binding = 3) buffer Framebuffer {
    vec4 pixels[];
} fb;

layout(set = 0, binding = 4) readonly buffer VertexBuffer {
    float vertices[];
} vbuf;

#define BINDING_MAT_BUF 5
#define BINDING_TRI_MAT_BUF 6
#define BINDING_TEX_HDR_BUF 7
#define BINDING_TEX_PIX_BUF 8
#include "pbr_common.glsl"

layout(push_constant) uniform PushConstants {
    uint queueId;         // Always 0 (surface hit queue)
    uint queueCapacity;
    uint dumpRenders;
    uint width;
    uint height;
    uint sceneType;       // 0: Showroom Studio, 1: Outdoor Terrain, 2: Indoor Atrium, 3: AAA Forest
    uint isGltf;          // 1 if glTF PBR scene, 0 if procedural
    uint binIndex;        // 0xFFFFFFFFu: Single Light, 0..7: 128 Lights Bin
} pc;

vec3 tonemapACES(vec3 x) {
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    vec3 mapped = clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
    return pow(mapped, vec3(1.0 / 2.2));
}

const uint SCENE_SHOWROOM_STUDIO = 0u;
const uint SCENE_OUTDOOR_TERRAIN = 1u;
const uint SCENE_INDOOR_ATRIUM   = 2u;
const uint SCENE_AAA_FOREST       = 3u;

// Indoor Atrium Primitives
const uint PRIM_KNOT_PAINT_END  = 1536u;
const uint PRIM_KNOT_JADE_END   = 3072u;
const uint PRIM_KNOT_CHROME_END = 4608u;
const uint PRIM_KNOT_VELVET_END = 6144u;
const uint PRIM_KNOT_RUST_END   = 7680u;
const uint PRIM_SPHERE_END      = 9600u;
const uint PRIM_PEDESTAL_END    = 9728u;
const uint PRIM_SUZANNE_END     = 10696u;
const uint PRIM_FLOOR_END       = 27080u;
const uint PRIM_WALLS_END       = 28104u;
const uint PRIM_CEILING_END     = 29128u;
const uint PRIM_COLUMNS_END     = 35272u;

// Outdoor Landscape Primitives
const uint PRIM_TERRAIN_END     = 32768u;
const uint PRIM_WATER_END       = 34816u;
const uint PRIM_TREES_END       = 57216u;

void getCamera(uint sceneType, out vec3 camPos, out vec3 camForward, out vec3 camRight, out vec3 camUp, out float fov) {
    if (pc.isGltf != 0u) {
        if (sceneType == SCENE_AAA_FOREST) {
            camPos = vec3(0.0, -18.0, 0.55);
            camForward = normalize(vec3(0.0, 33.0, 1.2));
            camRight = normalize(cross(camForward, vec3(0.0, 0.0, 1.0)));
            camUp = cross(camRight, camForward);
            fov = 0.65;
            return;
        } else if (sceneType == SCENE_INDOOR_ATRIUM) {
            camPos = vec3(-1150.0, 280.0, -40.0);
            camForward = normalize(vec3(1.0, 0.02, 0.0));
            camRight = vec3(0.0, 0.0, -1.0);
            camUp = vec3(0.0, 1.0, 0.0);
            fov = 0.55;
            return;
        } else if (sceneType == SCENE_SHOWROOM_STUDIO) {
            camPos = vec3(360.0, 160.0, 420.0);
            vec3 target = vec3(0.0, 30.0, 0.0);
            camForward = normalize(target - camPos);
            camRight = normalize(cross(camForward, vec3(0.0, 1.0, 0.0)));
            camUp = cross(camRight, camForward);
            fov = 0.45;
            return;
        }
    }
    if (sceneType == SCENE_OUTDOOR_TERRAIN) {
        camPos = vec3(0.0, -320.0, 75.0);
        camForward = vec3(0.0, 0.997375, -0.072412);
        camRight = vec3(1.0, 0.0, 0.0);
        camUp = vec3(0.0, 0.072412, 0.997375);
        fov = 0.45;
    } else if (sceneType == SCENE_INDOOR_ATRIUM) {
        camPos = vec3(0.0, -9.6, 1.2);
        camForward = normalize(vec3(0.0, 9.6, 0.6));
        camRight = vec3(1.0, 0.0, 0.0);
        camUp = normalize(cross(camRight, camForward));
        fov = 0.65;
    } else {
        camPos = vec3(-0.5081, -8.1276, 1.5591);
        camForward = vec3(0.0562, 0.9852, -0.1622);
        camRight = vec3(0.9984, -0.0570, 0.0000);
        camUp = vec3(0.0092, 0.1619, 0.9868);
        fov = 0.2155;
    }
}

vec3 computeSmoothNormal(uint sceneType, uint primId, vec3 hitPos, vec3 rayDir) {
    vec3 normal;
    if (sceneType == SCENE_OUTDOOR_TERRAIN) {
        if (primId >= PRIM_TERRAIN_END && primId < PRIM_WATER_END) {
            normal = vec3(0.0, 0.0, 1.0);
        } else {
            uint base = primId * 9u;
            vec3 p0 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
            vec3 p1 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);
            vec3 p2 = vec3(vbuf.vertices[base + 6], vbuf.vertices[base + 7], vbuf.vertices[base + 8]);
            normal = normalize(cross(p1 - p0, p2 - p0));
        }
    } else {
        if (primId < PRIM_KNOT_RUST_END) {
            uint segI = (primId / 48u);
            float u0 = (float(segI) / 160.0) * 6.283185307;
            float u1 = (float((segI + 1u) % 160u) / 160.0) * 6.283185307;

            float r0 = (2.0 + 0.8 * cos(3.0 * u0)) * 0.835;
            vec3 unrot0 = vec3(r0 * cos(2.0 * u0), r0 * sin(2.0 * u0), -0.8 * 0.835 * sin(3.0 * u0));
            float r1 = (2.0 + 0.8 * cos(3.0 * u1)) * 0.835;
            vec3 unrot1 = vec3(r1 * cos(2.0 * u1), r1 * sin(2.0 * u1), -0.8 * 0.835 * sin(3.0 * u1));

            const mat3 R_knot = mat3(
                vec3( 0.929662, -0.239757, -0.279722),
                vec3( 0.326751,  0.887321,  0.325417),
                vec3( 0.170182, -0.393927,  0.903249)
            );
            vec3 c0 = R_knot * unrot0 + vec3(0.0, 0.0, 0.385);
            vec3 c1 = R_knot * unrot1 + vec3(0.0, 0.0, 0.385);

            vec3 seg = c1 - c0;
            float segLen2 = dot(seg, seg);
            float tSeg = clamp(dot(hitPos - c0, seg) / max(segLen2, 0.00001), 0.0, 1.0);
            vec3 centerPt = c0 + tSeg * seg;

            normal = normalize(hitPos - centerPt);
        } else if (primId < PRIM_SPHERE_END) {
            normal = normalize(hitPos - vec3(-3.242, 0.391, -0.509));
        } else if (primId < PRIM_PEDESTAL_END) {
            if (hitPos.z >= -0.658) {
                normal = vec3(0.0, 0.0, 1.0);
            } else if (hitPos.z <= -1.050) {
                normal = vec3(0.0, 0.0, -1.0);
            } else {
                normal = normalize(vec3(hitPos.x - (-0.460), hitPos.y - 0.060, 0.0));
            }
        } else if (primId < PRIM_SUZANNE_END) {
            uint base = primId * 9u;
            vec3 p0 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
            vec3 p1 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);
            vec3 p2 = vec3(vbuf.vertices[base + 6], vbuf.vertices[base + 7], vbuf.vertices[base + 8]);
            normal = normalize(cross(p1 - p0, p2 - p0));
        } else if (primId < PRIM_FLOOR_END) {
            float backCurve = (hitPos.y > 1.0) ? 0.044 * (hitPos.y - 1.0) : 0.0;
            normal = normalize(vec3(0.0, -backCurve, 1.0));
        } else {
            uint base = primId * 9u;
            vec3 p0 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
            vec3 p1 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);
            vec3 p2 = vec3(vbuf.vertices[base + 6], vbuf.vertices[base + 7], vbuf.vertices[base + 8]);
            normal = normalize(cross(p1 - p0, p2 - p0));
        }
    }
    if (dot(normal, rayDir) > 0.0) normal = -normal;
    return normal;
}

void main() {
    uint threadIdx = gl_GlobalInvocationID.x;
    uint count = worklist.queueCounters[Q_SNAPSHOT_IDX(0)];
    if (threadIdx >= count || threadIdx >= pc.queueCapacity) return;

    if (threadIdx == 0) {
        atomicAdd(results.totalRays, count);
    }

    uint recordIdx = threadIdx;
    vec4 p = worklist.rayRecords[recordIdx];
    float t = p.x;
    uint pixelIdx = floatBitsToUint(p.y);
    uint primId = floatBitsToUint(p.z);
    vec2 bary = unpackUnorm2x16(floatBitsToUint(p.w));

    vec3 camPos, camForward, camRight, camUp;
    float fov;
    getCamera(pc.sceneType, camPos, camForward, camRight, camUp, fov);

    uint px_u = pixelIdx % pc.width;
    uint py_u = pixelIdx / pc.width;
    float halfH = float(pc.height) * 0.5;
    float px = float(px_u) - float(pc.width) * 0.5 + 0.5;
    float py = float(py_u) - halfH + 0.5;
    vec3 inDir = normalize(camForward + (px / halfH * fov) * camRight - (py / halfH * fov) * camUp);
    vec3 hitPos = camPos + inDir * t;
    vec3 viewDir = -inDir;

    vec3 geomNormal;
    vec3 smoothNormal;
    vec3 albedo = vec3(0.72);
    float roughness = 0.5;
    float metallic = 0.0;

    if (pc.isGltf != 0u) {
        uint base = primId * 36u;
        vec3 p0 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
        vec3 n0 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);
        vec2 uv0 = vec2(vbuf.vertices[base + 10], vbuf.vertices[base + 11]);

        base += 12u;
        vec3 p1 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
        vec3 n1 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);
        vec2 uv1 = vec2(vbuf.vertices[base + 10], vbuf.vertices[base + 11]);

        base += 12u;
        vec3 p2 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
        vec3 n2 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);
        vec2 uv2 = vec2(vbuf.vertices[base + 10], vbuf.vertices[base + 11]);

        float w = 1.0 - bary.x - bary.y;
        geomNormal = normalize(cross(p1 - p0, p2 - p0));
        vec3 sn = w * n0 + bary.x * n1 + bary.y * n2;
        smoothNormal = (length(sn) > 1e-4) ? normalize(sn) : geomNormal;

        uint matId = triMatBuf.triangleMats[primId];
        GltfMaterialGpu mat = matBuf.materials[matId];
        albedo = mat.baseColorFactor.rgb;
        roughness = mat.roughnessFactor;
        metallic = mat.metallicFactor;
        if (mat.baseColorTexIdx >= 0) {
            vec2 uv = w * uv0 + bary.x * uv1 + bary.y * uv2;
            albedo *= pow(sampleTexture(uint(mat.baseColorTexIdx), uv).rgb, vec3(2.2));
        }
    } else {
        smoothNormal = computeSmoothNormal(pc.sceneType, primId, hitPos, inDir);
        geomNormal = smoothNormal;
    }

    if (pc.binIndex <= 1u || pc.binIndex == 0xFFFFFFFFu) {
        // Single Light
        vec3 L, C;
        getMultiLight(0u, 1u, pc.sceneType, L, C);
        vec3 radiance = evalCookTorranceDirect(smoothNormal, viewDir, L, C, albedo, roughness, metallic);
        if (pc.dumpRenders != 0u) {
            fb.pixels[pixelIdx] = vec4(tonemapACES(radiance), 1.0);
        }
    } else {
        // 128 Lights Light Binning: evaluate 128 lights partitioned into 8 coherent bins of 16 lights
        vec3 totalRadiance = vec3(0.0);
        for (uint b = 0u; b < 8u; ++b) {
            uint startLight = b * 16u;
            for (uint li = 0u; li < 16u; ++li) {
                vec3 L, C;
                getMultiLight(startLight + li, 128u, pc.sceneType, L, C);
                totalRadiance += evalCookTorranceDirect(smoothNormal, viewDir, L, C, albedo, roughness, metallic);
            }
        }

        if (pc.dumpRenders != 0u) {
            fb.pixels[pixelIdx] = vec4(tonemapACES(totalRadiance), 1.0);
        }
    }
}
