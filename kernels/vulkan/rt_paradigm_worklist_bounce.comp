#version 460
#extension GL_EXT_ray_query : enable
#extension GL_EXT_ray_flags_primitive_culling : enable

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1) buffer Results {
    uint totalRays;
    uint totalHits;
    float accumulatedLuminance;
} results;

struct CompactRayPayload {
    vec4 originAndMatId;
    vec4 directionAndSeed;
    vec4 throughputAndMorton;
};

layout(set = 0, binding = 2) buffer WorkListBuffer {
    uint queueCounters[32];
    CompactRayPayload rayRecords[131072];
} worklist;

layout(push_constant) uniform PushConstants {
    uint currentBounce;
    uint maxQueueSize;
} pc;

void main() {
    uint threadIdx = gl_GlobalInvocationID.x;
    uint activeCount = worklist.queueCounters[0];
    if (threadIdx >= activeCount) return;

    CompactRayPayload payload = worklist.rayRecords[threadIdx];
    vec3 origin = payload.originAndMatId.xyz;
    vec3 direction = payload.directionAndSeed.xyz;

    rayQueryEXT query;
    rayQueryInitializeEXT(query, topLevelAS, gl_RayFlagsNoneEXT, 0xFF, origin, 0.001, direction, 20.0);
    while (rayQueryProceedEXT(query)) {}

    atomicAdd(results.totalRays, 1);

    if (rayQueryGetIntersectionTypeEXT(query, true) != 0) {
        atomicAdd(results.totalHits, 1);
    }
}
