#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_shader_invocation_reorder : enable

layout(location = 0) rayPayloadEXT vec3 payload;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1) buffer Results {
    uint totalRays;
    uint totalHits;
    float accumulatedLuminance;
} results;

layout(set = 0, binding = 2) buffer Framebuffer {
    vec4 pixels[];
} fb;

layout(push_constant) uniform PushConstants {
    uint rayCount;
    uint mode;
    uint bounces;
    uint seed;
    uint dumpRenders;
    uint width;
    uint height;
    uint spatialPattern;
    uint sceneType;
    uint isGltf;
    uint spp;
} pc;

const uint SCENE_SHOWROOM_STUDIO = 0u;
const uint SCENE_OUTDOOR_TERRAIN = 1u;
const uint SCENE_INDOOR_ATRIUM   = 2u;
const uint SCENE_AAA_FOREST       = 3u;

void getCamera(uint sceneType, out vec3 camPos, out vec3 camForward, out vec3 camRight, out vec3 camUp, out float fov) {
    if (pc.isGltf != 0u) {
        if (sceneType == SCENE_AAA_FOREST) {
            camPos = vec3(-35.0, -50.0, 20.0);
            camForward = normalize(vec3(45.0, 180.0, -14.0));
            camRight = normalize(cross(camForward, vec3(0.0, 0.0, 1.0)));
            camUp = cross(camRight, camForward);
            fov = 0.52;
            return;
        } else if (sceneType == SCENE_INDOOR_ATRIUM) {
            camPos = vec3(-1150.0, 280.0, -40.0);
            camForward = normalize(vec3(1.0, 0.02, 0.0));
            camRight = vec3(0.0, 0.0, -1.0);
            camUp = vec3(0.0, 1.0, 0.0);
            fov = 0.55;
            return;
        } else if (sceneType == SCENE_SHOWROOM_STUDIO) {
            camPos = vec3(360.0, 160.0, 420.0);
            vec3 target = vec3(0.0, 30.0, 0.0);
            camForward = normalize(target - camPos);
            camRight = normalize(cross(camForward, vec3(0.0, 1.0, 0.0)));
            camUp = cross(camRight, camForward);
            fov = 0.45;
            return;
        }
    }
    if (sceneType == SCENE_OUTDOOR_TERRAIN) {
        camPos = vec3(0.0, -320.0, 75.0);
        camForward = vec3(0.0, 0.997375, -0.072412);
        camRight = vec3(1.0, 0.0, 0.0);
        camUp = vec3(0.0, 0.072412, 0.997375);
        fov = 0.45;
    } else if (sceneType == SCENE_INDOOR_ATRIUM) {
        camPos = vec3(0.0, -9.6, 1.2);
        camForward = normalize(vec3(0.0, 9.6, 0.6));
        camRight = vec3(1.0, 0.0, 0.0);
        camUp = normalize(cross(camRight, camForward));
        fov = 0.65;
    } else {
        camPos = vec3(-0.5081, -8.1276, 1.5591);
        camForward = vec3(0.0562, 0.9852, -0.1622);
        camRight = vec3(0.9984, -0.0570, 0.0000);
        camUp = vec3(0.0092, 0.1619, 0.9868);
        fov = 0.2155;
    }
}

vec3 tonemapACES(vec3 x) {
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    vec3 mapped = clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
    return pow(mapped, vec3(1.0 / 2.2));
}

void computePixelCoords(uint idx, uint pattern, uint width, uint height, out uint px_u, out uint py_u) {
    if (pattern == 1) {
        uint tilesX = (width + 7) / 8;
        uint tileIdx = idx / 32;
        uint inTile = idx % 32;
        uint tileX = tileIdx % tilesX;
        uint tileY = tileIdx / tilesX;
        px_u = tileX * 8 + (inTile % 8);
        py_u = tileY * 4 + (inTile / 8);
    } else if (pattern == 2) {
        uint tilesX = (width + 7) / 8;
        uint tileIdx = idx / 32;
        uint inTile = idx % 32;
        uint tileX = tileIdx % tilesX;
        uint tileY = tileIdx / tilesX;
        uint mx = ((inTile >> 0) & 1) | (((inTile >> 2) & 1) << 1) | (((inTile >> 4) & 1) << 2);
        uint my = ((inTile >> 1) & 1) | (((inTile >> 3) & 1) << 1);
        px_u = tileX * 8 + mx;
        py_u = tileY * 4 + my;
    } else if (pattern == 3) {
        uint tilesX = (width + 3) / 4;
        uint tileIdx = idx / 32;
        uint inTile = idx % 32;
        uint tileX = tileIdx % tilesX;
        uint tileY = tileIdx / tilesX;
        uint mx = ((inTile >> 0) & 1) | (((inTile >> 2) & 1) << 1);
        uint my = ((inTile >> 1) & 1) | (((inTile >> 3) & 1) << 1) | (((inTile >> 4) & 1) << 2);
        px_u = tileX * 4 + mx;
        py_u = tileY * 8 + my;
    } else {
        px_u = idx % width;
        py_u = idx / width;
    }
}

void main() {
    uint idx = gl_LaunchIDEXT.x;
    if (idx >= pc.rayCount) return;

    vec3 camPos, camForward, camRight, camUp;
    float fov;
    getCamera(pc.sceneType, camPos, camForward, camRight, camUp, fov);

    uint px_u, py_u;
    computePixelCoords(idx, pc.spatialPattern, pc.width, pc.height, px_u, py_u);
    uint pixelIdx = py_u * pc.width + px_u;

    float halfH = float(pc.height) * 0.5;
    float px = float(px_u) - float(pc.width) * 0.5 + 0.5;
    float py = float(py_u) - halfH + 0.5;
    vec3 rayDir = normalize(camForward + (px / halfH * fov) * camRight - (py / halfH * fov) * camUp);
    vec3 rayOrigin = camPos;
    float tMaxPrimary = (pc.isGltf != 0u) ? 5000.0 : ((pc.sceneType == SCENE_OUTDOOR_TERRAIN) ? 2500.0 : 50.0);
    float tMinPrimary = (pc.isGltf != 0u) ? 0.1 : ((pc.sceneType == SCENE_OUTDOOR_TERRAIN) ? 0.05 : 0.01);

    payload = vec3(0.0);
    hitObjectEXT hObj;
    hitObjectTraceRayEXT(hObj, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, rayOrigin, tMinPrimary, rayDir, tMaxPrimary, 0);
    reorderThreadEXT(hObj);
    hitObjectExecuteShaderEXT(hObj, 0);

    if (pc.dumpRenders != 0) {
        fb.pixels[pixelIdx] = vec4(tonemapACES(payload * 1.0), 1.0);
    }

    atomicAdd(results.totalRays, 1u);
    if (payload != vec3(0.0)) {
        atomicAdd(results.totalHits, 1u);
    }
}
