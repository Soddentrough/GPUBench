#version 460
#extension GL_EXT_ray_query : enable
#extension GL_EXT_ray_flags_primitive_culling : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(local_size_x = 8, local_size_y = 4) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1) buffer Results {
    uint totalRays;
    uint totalHits;
    float accumulatedLuminance;
} results;

layout(set = 0, binding = 2) buffer WorkQueueBuffer {
    uint currentWorkTileIndex;
    uint padding[3];
} workQueue;

layout(set = 0, binding = 3) buffer Framebuffer {
    vec4 pixels[];
} fb;

layout(set = 0, binding = 4) readonly buffer VertexBuffer {
    float vertices[];
} vbuf;

#define BINDING_MAT_BUF 5
#define BINDING_TRI_MAT_BUF 6
#define BINDING_TEX_HDR_BUF 7
#define BINDING_TEX_PIX_BUF 8
#include "pbr_common.glsl"

layout(push_constant) uniform PushConstants {
    uint rayCount;
    uint mode;            // 1: Multi-Bounce Path Tracing
    uint bounces;         // Max bounces (default: 2..4)
    uint seed;
    uint dumpRenders;     // 1: dump pixels to fb
    uint width;
    uint height;
    uint spatialPattern;  // 2: Morton 8x4
    uint sceneType;       // 0: Showroom Studio, 1: Outdoor Terrain, 2: Indoor Atrium, 3: AAA Forest
    uint isGltf;          // 1 if glTF PBR scene, 0 if procedural
    uint spp;             // Samples per pixel (default: 1)
} pc;

// Scene Type Constants
const uint SCENE_SHOWROOM_STUDIO = 0u;
const uint SCENE_OUTDOOR_TERRAIN = 1u;
const uint SCENE_INDOOR_ATRIUM   = 2u;
const uint SCENE_AAA_FOREST       = 3u;

// Indoor Atrium Primitives
const uint PRIM_KNOT_PAINT_END  = 1536u;
const uint PRIM_KNOT_JADE_END   = 3072u;
const uint PRIM_KNOT_CHROME_END = 4608u;
const uint PRIM_KNOT_VELVET_END = 6144u;
const uint PRIM_KNOT_RUST_END   = 7680u;
const uint PRIM_SPHERE_END      = 9600u;
const uint PRIM_PEDESTAL_END    = 9728u;
const uint PRIM_SUZANNE_END     = 10696u;
const uint PRIM_FLOOR_END       = 27080u;
const uint PRIM_WALLS_END       = 28104u;
const uint PRIM_CEILING_END     = 29128u;
const uint PRIM_COLUMNS_END     = 35272u;

// Outdoor Landscape Primitives
const uint PRIM_TERRAIN_END     = 32768u;
const uint PRIM_WATER_END       = 34816u;
const uint PRIM_TREES_END       = 57216u;

uint pcg_hash(inout uint state) {
    uint oldstate = state;
    state = oldstate * 747796405u + 2891336453u;
    uint word = ((oldstate >> ((oldstate >> 28u) + 4u)) ^ oldstate) * 277803737u;
    return (word >> 22u) ^ word;
}

float rand_float(inout uint state) {
    return float(pcg_hash(state) & 0x00FFFFFFu) / 16777216.0;
}

vec2 signNotZero(vec2 v) {
    return vec2(v.x >= 0.0 ? 1.0 : -1.0, v.y >= 0.0 ? 1.0 : -1.0);
}

vec2 octEncode(vec3 n) {
    n /= (abs(n.x) + abs(n.y) + abs(n.z));
    return (n.z >= 0.0) ? n.xy : ((1.0 - abs(n.yx)) * signNotZero(n.xy));
}

vec3 octDecode(vec2 f) {
    vec3 n = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    float t = clamp(-n.z, 0.0, 1.0);
    n.x += (n.x >= 0.0) ? -t : t;
    n.y += (n.y >= 0.0) ? -t : t;
    return normalize(n);
}

vec3 cosine_sample_hemisphere(float u1, float u2) {
    float r = sqrt(u1);
    float theta = 6.28318530718 * u2;
    float x = r * cos(theta);
    float y = r * sin(theta);
    float z = sqrt(max(0.0, 1.0 - u1));
    return vec3(x, y, z);
}

vec3 align_to_normal(vec3 sample_dir, vec3 normal) {
    vec3 up = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);
    return tangent * sample_dir.x + bitangent * sample_dir.y + normal * sample_dir.z;
}

vec3 computeSmoothNormal(uint sceneType, uint primId, vec3 hitPos, vec3 rayDir, vec2 bary) {
    if (pc.isGltf != 0u) {
        uint base = primId * 36u;
        vec3 p0 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
        vec3 n0 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);
        base += 12u;
        vec3 p1 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
        vec3 n1 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);
        base += 12u;
        vec3 p2 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
        vec3 n2 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);

        float w = 1.0 - bary.x - bary.y;
        vec3 geomNorm = normalize(cross(p1 - p0, p2 - p0));
        vec3 smoothNorm = w * n0 + bary.x * n1 + bary.y * n2;
        vec3 n = (length(smoothNorm) > 1e-4) ? normalize(smoothNorm) : geomNorm;
        if (dot(n, rayDir) > 0.0) n = -n;
        return n;
    }
    vec3 normal;
    if (sceneType == SCENE_OUTDOOR_TERRAIN) {
        if (primId >= PRIM_TERRAIN_END && primId < PRIM_WATER_END) {
            normal = vec3(0.0, 0.0, 1.0);
        } else {
            uint base = primId * 9u;
            vec3 p0 = vec3(vbuf.vertices[base + 0], vbuf.vertices[base + 1], vbuf.vertices[base + 2]);
            vec3 p1 = vec3(vbuf.vertices[base + 3], vbuf.vertices[base + 4], vbuf.vertices[base + 5]);
            vec3 p2 = vec3(vbuf.vertices[base + 6], vbuf.vertices[base + 7], vbuf.vertices[base + 8]);
            normal = normalize(cross(p1 - p0, p2 - p0));
        }
    } else {
        if (primId < PRIM_KNOT_RUST_END) {
            uint segI = (primId / 48u);
            float u = float(segI) / 160.0 * 6.28318530718 * 2.0;
            vec3 c = vec3(sin(u) + 2.0 * sin(2.0 * u), cos(u) - 2.0 * cos(2.0 * u), -sin(3.0 * u));
            normal = normalize(hitPos - c);
        } else if (primId < PRIM_SPHERE_END) {
            normal = normalize(hitPos - vec3(0.0, 0.0, 0.5));
        } else if (primId < PRIM_PEDESTAL_END) {
            normal = normalize(vec3(hitPos.xy, 0.0));
        } else if (primId < PRIM_SUZANNE_END) {
            normal = normalize(hitPos - vec3(0.0, 0.0, 1.0));
        } else if (primId < PRIM_FLOOR_END) {
            normal = vec3(0.0, 0.0, 1.0);
        } else if (primId < PRIM_WALLS_END) {
            normal = (abs(hitPos.x) > abs(hitPos.y)) ? vec3(-sign(hitPos.x), 0.0, 0.0) : vec3(0.0, -sign(hitPos.y), 0.0);
        } else if (primId < PRIM_CEILING_END) {
            normal = vec3(0.0, 0.0, -1.0);
        } else {
            normal = vec3(0.0, 0.0, 1.0);
        }
    }
    if (dot(normal, rayDir) > 0.0) normal = -normal;
    return normal;
}

uint computeMaterialId(uint sceneType, uint primId, vec3 hitPos, vec3 normal) {
    if (sceneType == SCENE_OUTDOOR_TERRAIN) {
        if (primId >= PRIM_WATER_END) {
            return 11u; // Pine Foliage
        } else if (primId >= PRIM_TERRAIN_END) {
            return 10u; // Water
        } else {
            float slope = 1.0 - max(0.0, normal.z);
            float elev = hitPos.z;
            if (elev > 380.0) return 12u; // Snow
            else if (slope > 0.55) return 13u; // Cliff
            else if (elev < 80.0 && slope < 0.15) return 15u; // River stones
            else return 14u; // Meadow Grass
        }
    } else {
        if (primId < PRIM_KNOT_PAINT_END) return 0u;
        else if (primId < PRIM_KNOT_JADE_END) return 1u;
        else if (primId < PRIM_KNOT_CHROME_END) return 2u;
        else if (primId < PRIM_KNOT_VELVET_END) return 3u;
        else if (primId < PRIM_KNOT_RUST_END) return 4u;
        else if (primId < PRIM_SPHERE_END) return 5u;
        else if (primId < PRIM_PEDESTAL_END) return 6u;
        else if (primId < PRIM_SUZANNE_END) return 7u;
        else if (primId < PRIM_FLOOR_END) return 8u;
        else if (primId < PRIM_WALLS_END) return 9u;
        else if (primId < PRIM_CEILING_END) return 9u;
        else return 6u;
    }
}

uint getArchetype(uint matId) {
    if (matId >= 10u) return (matId - 10u) % 8u;
    return matId % 8u;
}

void getCamera(uint sceneType, out vec3 camPos, out vec3 camForward, out vec3 camRight, out vec3 camUp, out float fov) {
    if (pc.isGltf != 0u) {
        if (sceneType == SCENE_AAA_FOREST) {
            camPos = vec3(-35.0, -50.0, 20.0);
            camForward = normalize(vec3(45.0, 180.0, -14.0));
            camRight = normalize(cross(camForward, vec3(0.0, 0.0, 1.0)));
            camUp = cross(camRight, camForward);
            fov = 0.52;
            return;
        } else if (sceneType == SCENE_INDOOR_ATRIUM) {
            camPos = vec3(-1150.0, 280.0, -40.0);
            camForward = normalize(vec3(1.0, 0.02, 0.0));
            camRight = vec3(0.0, 0.0, -1.0);
            camUp = vec3(0.0, 1.0, 0.0);
            fov = 0.55;
            return;
        } else if (sceneType == SCENE_SHOWROOM_STUDIO) {
            camPos = vec3(360.0, 160.0, 420.0);
            vec3 target = vec3(0.0, 30.0, 0.0);
            camForward = normalize(target - camPos);
            camRight = normalize(cross(camForward, vec3(0.0, 1.0, 0.0)));
            camUp = cross(camRight, camForward);
            fov = 0.48;
            return;
        } else {
            camPos = vec3(-400.0, 350.0, 280.0);
            vec3 target = vec3(0.0, 0.0, 80.0);
            camForward = normalize(target - camPos);
            camRight = normalize(cross(camForward, vec3(0.0, 0.0, 1.0)));
            camUp = cross(camRight, camForward);
            fov = 0.60;
            return;
        }
    }
    if (sceneType == SCENE_OUTDOOR_TERRAIN) {
        camPos = vec3(-450.0, -350.0, 280.0);
        vec3 target = vec3(0.0, 0.0, 80.0);
        camForward = normalize(target - camPos);
        camRight = normalize(cross(camForward, vec3(0.0, 0.0, 1.0)));
        camUp = cross(camRight, camForward);
        fov = 0.60;
    } else {
        camPos = vec3(0.0, -6.5, 1.8);
        camForward = normalize(vec3(0.0, 1.0, -0.15));
        camRight = vec3(1.0, 0.0, 0.0);
        camUp = cross(camRight, camForward);
        fov = 0.70;
    }
}



vec3 evalSky(uint sceneType, vec3 dir) {
    if (sceneType == SCENE_OUTDOOR_TERRAIN || sceneType == SCENE_AAA_FOREST) {
        float skyT = clamp(dir.z * 0.5 + 0.5, 0.0, 1.0);
        vec3 skyColor = mix(vec3(0.65, 0.75, 0.90), vec3(0.12, 0.35, 0.75), skyT);
        vec3 sunDir = normalize(vec3(0.4, 0.5, 0.75));
        float sunDot = max(0.0, dot(dir, sunDir));
        skyColor += vec3(1.0, 0.8, 0.5) * pow(sunDot, 120.0) * 8.0;
        return skyColor;
    } else if (sceneType == SCENE_INDOOR_ATRIUM) {
        float skyT = clamp(dir.z * 0.5 + 0.5, 0.0, 1.0);
        return mix(vec3(0.55, 0.65, 0.85), vec3(0.10, 0.25, 0.65), skyT) * 1.5;
    } else {
        float t = clamp(dir.y * 0.5 + 0.5, 0.0, 1.0);
        return mix(vec3(0.05, 0.05, 0.08), vec3(0.40, 0.45, 0.55), t);
    }
}

vec3 tonemapACES(vec3 x) {
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

ivec2 getPixelCoordsMorton8x4(uint linearIdx, uint width, uint height) {
    uint tilesX = (width + 7u) / 8u;
    uint tileIdx = linearIdx / 32u;
    uint inTile = linearIdx % 32u;
    uint tileX = tileIdx % tilesX;
    uint tileY = tileIdx / tilesX;

    uint mx = ((inTile >> 0u) & 1u) | (((inTile >> 2u) & 1u) << 1u) | (((inTile >> 4u) & 1u) << 2u);
    uint my = ((inTile >> 1u) & 1u) | (((inTile >> 3u) & 1u) << 1u);

    return ivec2(int(tileX * 8u + mx), int(tileY * 4u + my));
}



shared uint s_baseTileIndex;

void main() {
    uint totalTilesX = (pc.width + 7u) / 8u;
    uint totalTilesY = (pc.height + 3u) / 4u;
    uint totalTiles = totalTilesX * totalTilesY;
    const uint CHUNK_SIZE = 16u;

    uint threadRays = 0u;
    uint threadHits = 0u;

    vec3 camPos, camForward, camRight, camUp;
    float fov;
    getCamera(pc.sceneType, camPos, camForward, camRight, camUp, fov);
    float halfH = float(pc.height) * 0.5;
    float tMaxPrimary = (pc.isGltf != 0u) ? 5000.0 : ((pc.sceneType == SCENE_OUTDOOR_TERRAIN) ? 2500.0 : 50.0);
    float tMinPrimary = (pc.isGltf != 0u) ? 0.1 : ((pc.sceneType == SCENE_OUTDOOR_TERRAIN) ? 0.05 : 0.01);

    // Persistent Wavefront Work Queue: CUs claim chunks of 16 tiles to eliminate atomic contention
    while (true) {
        if (gl_LocalInvocationIndex == 0u) {
            s_baseTileIndex = atomicAdd(workQueue.currentWorkTileIndex, CHUNK_SIZE);
        }
        barrier();

        uint baseTileIdx = s_baseTileIndex;
        if (baseTileIdx >= totalTiles) {
            break;
        }

        for (uint c = 0u; c < CHUNK_SIZE; ++c) {
            uint tileIdx = baseTileIdx + c;
            if (tileIdx >= totalTiles) break;

            uint linearIdx = tileIdx * 32u + gl_LocalInvocationIndex;
            ivec2 pixelCoord = getPixelCoordsMorton8x4(linearIdx, pc.width, pc.height);
            if (pixelCoord.x >= int(pc.width) || pixelCoord.y >= int(pc.height)) continue;

            uint px_u = uint(pixelCoord.x);
            uint py_u = uint(pixelCoord.y);
            uint pixelIdx = px_u + py_u * pc.width;

            vec3 accumRadiance = vec3(0.0);
            uint sppToRun = max(1u, pc.spp);

            for (uint s = 0u; s < sppToRun; ++s) {
                uint rngState = pixelIdx + pc.seed + s * 7919u;
                float jx = (sppToRun == 1u) ? 0.0 : (rand_float(rngState) - 0.5);
                float jy = (sppToRun == 1u) ? 0.0 : (rand_float(rngState) - 0.5);
                float px_s = float(px_u) + jx - float(pc.width) * 0.5 + 0.5;
                float py_s = float(py_u) + jy - halfH + 0.5;
                vec3 curDir = normalize(camForward + (px_s / halfH * fov) * camRight - (py_s / halfH * fov) * camUp);
                vec3 curOrigin = camPos;

                threadRays++;
                rayQueryEXT query;
                rayQueryInitializeEXT(query, topLevelAS, gl_RayFlagsNoneEXT, 0xFF, curOrigin, tMinPrimary, curDir, tMaxPrimary);
                while (rayQueryProceedEXT(query)) {
                    if (rayQueryGetIntersectionTypeEXT(query, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
                        if (pc.isGltf != 0u) {
                            uint candTri = rayQueryGetIntersectionPrimitiveIndexEXT(query, false);
                            uint candMatId = triMatBuf.triangleMats[candTri];
                            GltfMaterialGpu candMat = matBuf.materials[candMatId];
                            if (candMat.alphaMode == 1u /* MASK */) {
                                vec2 candBary = rayQueryGetIntersectionBarycentricsEXT(query, false);
                                uint b = candTri * 36u;
                                vec2 uv0 = vec2(vbuf.vertices[b + 10], vbuf.vertices[b + 11]);
                                vec2 uv1 = vec2(vbuf.vertices[b + 22], vbuf.vertices[b + 23]);
                                vec2 uv2 = vec2(vbuf.vertices[b + 34], vbuf.vertices[b + 35]);
                                float cw = 1.0 - candBary.x - candBary.y;
                                vec2 cuv = cw * uv0 + candBary.x * uv1 + candBary.y * uv2;
                                float calpha = candMat.baseColorFactor.a;
                                if (candMat.baseColorTexIdx >= 0) {
                                    calpha *= sampleTexture(uint(candMat.baseColorTexIdx), cuv).a;
                                }
                                if (calpha < candMat.alphaCutoff) {
                                    continue; // Skip transparent pixel (pass-through)
                                }
                            }
                        }
                        rayQueryConfirmIntersectionEXT(query);
                    }
                }

                vec3 sampleRadiance = vec3(0.0);
                if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
                    threadHits++;
                    float t = rayQueryGetIntersectionTEXT(query, true);
                    vec3 hitPos = curOrigin + curDir * t;
                    uint primId = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
                    vec2 rawBary = rayQueryGetIntersectionBarycentricsEXT(query, true);
                    vec3 normal = computeSmoothNormal(pc.sceneType, primId, hitPos, curDir, rawBary);

                    float u1 = rand_float(rngState);
                    float u2 = rand_float(rngState);
                    vec3 nextDir = align_to_normal(cosine_sample_hemisphere(u1, u2), normal);

                    vec3 bOrigin = hitPos + normal * (pc.isGltf != 0u ? 0.05 : 0.005);
                    vec3 bDir = nextDir;

                    if (pc.dumpRenders != 0) {
                        vec3 albedo = vec3(0.72);
                        vec3 emissive = vec3(0.0);
                        if (pc.isGltf != 0u) {
                            vec2 bary = unpackUnorm2x16(packUnorm2x16(rawBary));
                            uint base = primId * 36u;
                            vec2 uv0 = vec2(vbuf.vertices[base + 10], vbuf.vertices[base + 11]);
                            vec2 uv1 = vec2(vbuf.vertices[base + 22], vbuf.vertices[base + 23]);
                            vec2 uv2 = vec2(vbuf.vertices[base + 34], vbuf.vertices[base + 35]);
                            float w = 1.0 - bary.x - bary.y;
                            vec2 uv = w * uv0 + bary.x * uv1 + bary.y * uv2;
                            uint matId = triMatBuf.triangleMats[primId];
                            GltfMaterialGpu mat = matBuf.materials[matId];
                            albedo = mat.baseColorFactor.rgb;
                            if (mat.baseColorTexIdx >= 0) {
                                albedo *= pow(sampleTexture(uint(mat.baseColorTexIdx), uv).rgb, vec3(2.2));
                            }
                            if (mat.emissiveTexIdx >= 0) {
                                emissive = pow(sampleTexture(uint(mat.emissiveTexIdx), uv).rgb, vec3(2.2)) * mat.emissiveFactor.rgb;
                            }
                        } else {
                            uint matId = computeMaterialId(pc.sceneType, primId, hitPos, normal);
                            uint archetype = getArchetype(matId);
                            if (archetype == 0) albedo = vec3(0.65, 0.52, 0.40);
                            else if (archetype == 1) albedo = vec3(0.18, 0.55, 0.34);
                            else if (archetype == 2) albedo = vec3(0.95, 0.95, 0.98);
                            else if (archetype == 3) albedo = vec3(0.85, 0.12, 0.22);
                            else if (archetype == 4) albedo = vec3(0.55, 0.45, 0.35);
                            else if (archetype == 5) albedo = vec3(0.80, 0.80, 0.82);
                            else if (archetype == 6) albedo = vec3(0.88, 0.20, 0.10);
                            else albedo = vec3(0.12, 0.45, 0.15);
                        }

                        vec3 sunDir;
                        vec3 sunColor;
                        getSceneSunParams(pc.sceneType, sunDir, sunColor);

                        float NdotL = max(0.0, dot(normal, sunDir));
                        vec3 directLight = vec3(0.0);
                        if (NdotL > 0.0) {
                            bool shadowed = traceShadowRay(hitPos, normal, sunDir, (pc.isGltf != 0u ? 5000.0 : 2000.0));
                            if (!shadowed) {
                                directLight = (albedo / 3.14159) * sunColor * NdotL;
                            }
                        }

                        if (pc.sceneType == 2u) {
                            const vec3 lanternPos[3] = vec3[3](
                                vec3(0.0, 450.0, 0.0),
                                vec3(-650.0, 250.0, 0.0),
                                vec3(650.0, 250.0, 0.0)
                            );
                            const vec3 lanternColor[3] = vec3[3](
                                vec3(1.0, 0.85, 0.60) * 2.2,
                                vec3(1.0, 0.80, 0.50) * 1.8,
                                vec3(1.0, 0.80, 0.50) * 1.8
                            );
                            for (int li = 0; li < 3; ++li) {
                                vec3 toL = lanternPos[li] - hitPos;
                                float d2 = dot(toL, toL);
                                float d = sqrt(d2);
                                vec3 L = toL / d;
                                float l_NdotL = max(0.0, dot(normal, L));
                                if (l_NdotL > 0.0) {
                                    bool l_shad = traceShadowRay(hitPos, normal, L, d - 0.1);
                                    if (!l_shad) {
                                        float atten = 1.0 / (1.0 + 0.000004 * d2);
                                        directLight += (albedo / 3.14159) * lanternColor[li] * atten * l_NdotL;
                                    }
                                }
                            }
                        }

                        vec3 throughput = albedo;
                        vec3 indirectRadiance = vec3(0.0);

                        // Secondary Bounce Path Tracing
                        for (uint b = 1; b < pc.bounces; ++b) {
                            threadRays++;
                            rayQueryEXT bQuery;
                            rayQueryInitializeEXT(bQuery, topLevelAS, gl_RayFlagsNoneEXT, 0xFF, bOrigin, (pc.isGltf != 0u ? 0.05 : 0.005), bDir, tMaxPrimary);
                            while (rayQueryProceedEXT(bQuery)) {
                                if (rayQueryGetIntersectionTypeEXT(bQuery, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
                                    if (pc.isGltf != 0u) {
                                        uint b_candTri = rayQueryGetIntersectionPrimitiveIndexEXT(bQuery, false);
                                        uint b_candMatId = triMatBuf.triangleMats[b_candTri];
                                        GltfMaterialGpu b_candMat = matBuf.materials[b_candMatId];
                                        if (b_candMat.alphaMode == 1u /* MASK */) {
                                            vec2 b_candBary = rayQueryGetIntersectionBarycentricsEXT(bQuery, false);
                                            uint b_base = b_candTri * 36u;
                                            vec2 uv0 = vec2(vbuf.vertices[b_base + 10], vbuf.vertices[b_base + 11]);
                                            vec2 uv1 = vec2(vbuf.vertices[b_base + 22], vbuf.vertices[b_base + 23]);
                                            vec2 uv2 = vec2(vbuf.vertices[b_base + 34], vbuf.vertices[b_base + 35]);
                                            float cw = 1.0 - b_candBary.x - b_candBary.y;
                                            vec2 cuv = cw * uv0 + b_candBary.x * uv1 + b_candBary.y * uv2;
                                            float calpha = b_candMat.baseColorFactor.a;
                                            if (b_candMat.baseColorTexIdx >= 0) {
                                                calpha *= sampleTexture(uint(b_candMat.baseColorTexIdx), cuv).a;
                                            }
                                            if (calpha < b_candMat.alphaCutoff) {
                                                continue;
                                            }
                                        }
                                    }
                                    rayQueryConfirmIntersectionEXT(bQuery);
                                }
                            }

                            if (rayQueryGetIntersectionTypeEXT(bQuery, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
                                threadHits++;
                                if (b >= 2 && rand_float(rngState) < 0.4) break; // Russian roulette
                                float b_t = rayQueryGetIntersectionTEXT(bQuery, true);
                                vec3 b_hitPos = bOrigin + bDir * b_t;
                                uint b_primId = rayQueryGetIntersectionPrimitiveIndexEXT(bQuery, true);
                                vec2 b_bary = rayQueryGetIntersectionBarycentricsEXT(bQuery, true);
                                vec3 b_normal = computeSmoothNormal(pc.sceneType, b_primId, b_hitPos, bDir, b_bary);

                                vec3 b_albedo = vec3(0.72);
                                if (pc.isGltf != 0u) {
                                    vec2 b_ubary = unpackUnorm2x16(packUnorm2x16(b_bary));
                                    uint b_base = b_primId * 36u;
                                    vec2 b_uv0 = vec2(vbuf.vertices[b_base + 10], vbuf.vertices[b_base + 11]);
                                    vec2 b_uv1 = vec2(vbuf.vertices[b_base + 22], vbuf.vertices[b_base + 23]);
                                    vec2 b_uv2 = vec2(vbuf.vertices[b_base + 34], vbuf.vertices[b_base + 35]);
                                    float b_w = 1.0 - b_ubary.x - b_ubary.y;
                                    vec2 b_uv = b_w * b_uv0 + b_ubary.x * b_uv1 + b_ubary.y * b_uv2;
                                    uint b_matId = triMatBuf.triangleMats[b_primId];
                                    GltfMaterialGpu b_mat = matBuf.materials[b_matId];
                                    b_albedo = b_mat.baseColorFactor.rgb;
                                    if (b_mat.baseColorTexIdx >= 0) {
                                        b_albedo *= pow(sampleTexture(uint(b_mat.baseColorTexIdx), b_uv).rgb, vec3(2.2));
                                    }
                                }

                                float b_NdotL = max(0.0, dot(b_normal, sunDir));
                                if (b_NdotL > 0.0) {
                                    bool b_shadowed = traceShadowRay(b_hitPos, b_normal, sunDir, (pc.isGltf != 0u ? 5000.0 : 2000.0));
                                    if (!b_shadowed) {
                                        indirectRadiance += throughput * (b_albedo / 3.14159) * sunColor * b_NdotL;
                                    }
                                }

                                float b_u1 = rand_float(rngState);
                                float b_u2 = rand_float(rngState);
                                bDir = align_to_normal(cosine_sample_hemisphere(b_u1, b_u2), b_normal);
                                bOrigin = b_hitPos + b_normal * (pc.isGltf != 0u ? 0.05 : 0.005);
                                throughput *= b_albedo;
                            } else {
                                indirectRadiance += throughput * evalSky(pc.sceneType, bDir);
                                break;
                            }
                        }

                        sampleRadiance = directLight + indirectRadiance + emissive;
                    }
                } else {
                    if (pc.dumpRenders != 0) {
                        sampleRadiance = evalSky(pc.sceneType, curDir);
                    }
                }
                if (pc.dumpRenders != 0) {
                    accumRadiance += sampleRadiance;
                }
            }

            if (pc.dumpRenders != 0) {
                float expGain = (pc.sceneType == 2u) ? 1.6 : 1.0;
                vec3 finalColor = (accumRadiance / float(sppToRun)) * expGain;
                fb.pixels[pixelIdx] = vec4(tonemapACES(finalColor), 1.0);
            }
        }
    }

    uint waveRays = subgroupAdd(threadRays);
    uint waveHits = subgroupAdd(threadHits);
    if (subgroupElect()) {
        if (waveRays > 0u) atomicAdd(results.totalRays, waveRays);
        if (waveHits > 0u) atomicAdd(results.totalHits, waveHits);
    }
}
