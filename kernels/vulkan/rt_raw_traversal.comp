#version 460
#extension GL_EXT_ray_query : require
#extension GL_KHR_shader_subgroup_ballot : enable

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1) writeonly buffer ResultBuffer {
    uint hits[];
} results;

layout(push_constant) uniform PushConstants {
    uint rayCount;
    uint mode;
    float tMin;
    float tMax;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.rayCount) return;

    // Conformal 2D mapping into geometry bounds [0.01, 0.99]
    uint rx = idx & 2047u;
    uint ry = (idx >> 11) & 2047u;
    float fx = float(rx) * (0.98 / 2047.0) + 0.01;
    float fy = float(ry) * (0.98 / 2047.0) + 0.01;

    vec3 origin = vec3(fx, fy, -1.0);
    vec3 direction = vec3(0.0, 0.0, 1.0);

    uint rayFlags = (pc.mode == 0)
        ? (gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT)
        : (gl_RayFlagsOpaqueEXT);

    rayQueryEXT query;
    rayQueryInitializeEXT(query, topLevelAS, rayFlags, 0xFF, origin, pc.tMin, direction, pc.tMax);
    
    while (rayQueryProceedEXT(query)) {
        // Pure hardware BVH traversal: opaque geometry is resolved directly
        // by the Ray Accelerator without shader candidate intervention.
    }

    bool hasHit = (rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT);
    uvec4 ballot = subgroupBallot(hasHit);
    if (subgroupElect()) {
        results.hits[gl_WorkGroupID.x] = subgroupBallotBitCount(ballot);
    }
}
