#version 460
// GPUBench Dual-Issue & Concurrency Benchmark Suite
// Config 4: Concurrent FP32 + INT32 (50/50 Dual-Issue)
// Evaluates concurrent execution across mixed datapaths (NVIDIA decoupled FP32+INT32
// datapaths vs AMD mixed ALU instruction pairing).

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Data {
    float data[];
} InOutBuffer;

layout(push_constant) uniform PushConstants {
    float multiplier;
    uint num_elements;
} pushConstants;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pushConstants.num_elements) return;

    float base = InOutBuffer.data[index];
    uint ubase = uint(base * 1000.0) + index;

    // 8 independent FP32 accumulator chains
    vec4 f0 = vec4(base);
    vec4 f1 = vec4(base + 0.1);
    vec4 f2 = vec4(base + 0.2);
    vec4 f3 = vec4(base + 0.3);
    vec4 f4 = vec4(base + 0.4);
    vec4 f5 = vec4(base + 0.5);
    vec4 f6 = vec4(base + 0.6);
    vec4 f7 = vec4(base + 0.7);

    vec4 mf = vec4(pushConstants.multiplier);
    vec4 cf0 = vec4(0.0001, 0.0002, 0.0003, 0.0004);
    vec4 cf1 = vec4(0.0005, 0.0006, 0.0007, 0.0008);
    vec4 cf2 = vec4(0.0009, 0.0010, 0.0011, 0.0012);
    vec4 cf3 = vec4(0.0013, 0.0014, 0.0015, 0.0016);
    vec4 cf4 = vec4(0.0017, 0.0018, 0.0019, 0.0020);
    vec4 cf5 = vec4(0.0021, 0.0022, 0.0023, 0.0024);
    vec4 cf6 = vec4(0.0025, 0.0026, 0.0027, 0.0028);
    vec4 cf7 = vec4(0.0029, 0.0030, 0.0031, 0.0032);

    // 8 independent INT32 accumulator chains
    uvec4 u0 = uvec4(ubase);
    uvec4 u1 = uvec4(ubase + 1u);
    uvec4 u2 = uvec4(ubase + 2u);
    uvec4 u3 = uvec4(ubase + 3u);
    uvec4 u4 = uvec4(ubase + 4u);
    uvec4 u5 = uvec4(ubase + 5u);
    uvec4 u6 = uvec4(ubase + 6u);
    uvec4 u7 = uvec4(ubase + 7u);

    uvec4 mu = uvec4(uint(pushConstants.multiplier));
    if (mu.x == 0u) mu = uvec4(1u);
    uvec4 cu0 = uvec4(13u, 17u, 19u, 23u);
    uvec4 cu1 = uvec4(29u, 31u, 37u, 41u);
    uvec4 cu2 = uvec4(43u, 47u, 53u, 59u);
    uvec4 cu3 = uvec4(61u, 67u, 71u, 73u);
    uvec4 cu4 = uvec4(79u, 83u, 89u, 97u);
    uvec4 cu5 = uvec4(101u, 103u, 107u, 109u);
    uvec4 cu6 = uvec4(113u, 127u, 131u, 137u);
    uvec4 cu7 = uvec4(139u, 149u, 151u, 157u);

    // 16384 iterations * (8 vec4 FMAs + 8 uvec4 INT adds)
    // = 16384 * (64 FP32 ops + 64 INT32 ops) = 16384 * 128 = 2,097,152 operations
    for (int i = 0; i < 16384; ++i) {
        f0 = fma(f0, mf, cf0);
        u0 = (u0 + cu0) + 1u;

        f1 = fma(f1, mf, cf1);
        u1 = (u1 + cu1) + 1u;

        f2 = fma(f2, mf, cf2);
        u2 = (u2 + cu2) + 1u;

        f3 = fma(f3, mf, cf3);
        u3 = (u3 + cu3) + 1u;

        f4 = fma(f4, mf, cf4);
        u4 = (u4 + cu4) + 1u;

        f5 = fma(f5, mf, cf5);
        u5 = (u5 + cu5) + 1u;

        f6 = fma(f6, mf, cf6);
        u6 = (u6 + cu6) + 1u;

        f7 = fma(f7, mf, cf7);
        u7 = (u7 + cu7) + 1u;
    }

    vec4 fres = (f0 + f1) + (f2 + f3) + (f4 + f5) + (f6 + f7);
    uvec4 ures = (u0 + u1) + (u2 + u3) + (u4 + u5) + (u6 + u7);

    InOutBuffer.data[index] = fres.x + fres.y + fres.z + fres.w + float(ures.x ^ ures.y ^ ures.z ^ ures.w);
}
