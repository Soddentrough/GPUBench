#version 460
// GPUBench Dual-Issue & Concurrency Benchmark Suite
// Config 6: Dual-Issue Mixed (FP32+INT32, 50/50 Dual-Issue)
// Evaluates concurrent execution across mixed datapaths (8 FP32 + 8 INT32 scalar chains).

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Data {
    float data[];
} InOutBuffer;

layout(push_constant) uniform PushConstants {
    float multiplier;
    uint num_elements;
} pushConstants;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pushConstants.num_elements) return;

    float base = InOutBuffer.data[index];
    uint ubase = uint(base * 1000.0) + index;

    // 8 independent FP32 scalar accumulator chains
    float f0 = base;
    float f1 = base + 0.1;
    float f2 = base + 0.2;
    float f3 = base + 0.3;
    float f4 = base + 0.4;
    float f5 = base + 0.5;
    float f6 = base + 0.6;
    float f7 = base + 0.7;

    float mf = pushConstants.multiplier;
    float cf0 = 0.0001;
    float cf1 = 0.0002;
    float cf2 = 0.0003;
    float cf3 = 0.0004;
    float cf4 = 0.0005;
    float cf5 = 0.0006;
    float cf6 = 0.0007;
    float cf7 = 0.0008;

    // 8 independent INT32 scalar accumulator chains
    uint u0 = ubase;
    uint u1 = ubase + 1u;
    uint u2 = ubase + 2u;
    uint u3 = ubase + 3u;
    uint u4 = ubase + 4u;
    uint u5 = ubase + 5u;
    uint u6 = ubase + 6u;
    uint u7 = ubase + 7u;

    uint mu = uint(pushConstants.multiplier);
    if (mu == 0u) mu = 1u;

    uint cu0 = 13u;
    uint cu1 = 29u;
    uint cu2 = 43u;
    uint cu3 = 61u;
    uint cu4 = 79u;
    uint cu5 = 101u;
    uint cu6 = 113u;
    uint cu7 = 139u;

    // 65536 iterations * (8 scalar FMAs + 8 scalar INT add+xor)
    // = 65536 * (16 FP32 ops + 16 INT32 ops) = 65536 * 32 = 2,097,152 operations
    for (int i = 0; i < 65536; ++i) {
        f0 = fma(f0, mf, cf0);
        u0 = (u0 + cu0) ^ mu;

        f1 = fma(f1, mf, cf1);
        u1 = (u1 + cu1) ^ mu;

        f2 = fma(f2, mf, cf2);
        u2 = (u2 + cu2) ^ mu;

        f3 = fma(f3, mf, cf3);
        u3 = (u3 + cu3) ^ mu;

        f4 = fma(f4, mf, cf4);
        u4 = (u4 + cu4) ^ mu;

        f5 = fma(f5, mf, cf5);
        u5 = (u5 + cu5) ^ mu;

        f6 = fma(f6, mf, cf6);
        u6 = (u6 + cu6) ^ mu;

        f7 = fma(f7, mf, cf7);
        u7 = (u7 + cu7) ^ mu;
    }

    float fres = (f0 + f1) + (f2 + f3) + (f4 + f5) + (f6 + f7);
    uint ures = u0 ^ u1 ^ u2 ^ u3 ^ u4 ^ u5 ^ u6 ^ u7;

    InOutBuffer.data[index] = fres + float(ures);
}
