#version 460
#extension GL_EXT_ray_query : enable
#extension GL_EXT_ray_flags_primitive_culling : enable

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1) buffer Results {
    uint totalRays;
    uint totalHits;
    float accumulatedLuminance;
} results;

layout(set = 0, binding = 2) buffer Framebuffer {
    vec4 pixels[];
} fb;

layout(push_constant) uniform PushConstants {
    uint rayCount;
    uint mode;     // 0: Material Divergence, 1: Multi-Bounce Path Tracing, 2: Incoherent GI
    uint bounces;  // Max bounces (for mode 1)
    uint seed;
    uint dumpRenders; // 1: dump pixels to fb
} pc;

shared uint localRays;
shared uint localHits;

// PCG Random Generator
uint pcg_hash(inout uint state) {
    uint oldstate = state;
    state = oldstate * 747796405u + 2891336453u;
    uint word = ((oldstate >> ((oldstate >> 28u) + 4u)) ^ oldstate) * 277803737u;
    return (word >> 22u) ^ word;
}

float rand_float(inout uint state) {
    return float(pcg_hash(state) & 0x00FFFFFFu) / 16777216.0;
}

vec3 cosine_sample_hemisphere(float u1, float u2) {
    float r = sqrt(u1);
    float theta = 6.28318530718 * u2;
    float x = r * cos(theta);
    float y = r * sin(theta);
    float z = sqrt(max(0.0, 1.0 - u1));
    return vec3(x, y, z);
}

vec3 align_to_normal(vec3 sample_dir, vec3 normal) {
    vec3 up = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);
    return tangent * sample_dir.x + bitangent * sample_dir.y + normal * sample_dir.z;
}

// Procedural 3D Voronoi cellular noise for Car Paint Flakes
float voronoiFlakes(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    float minDist = 1.0;
    for (int z = -1; z <= 1; ++z) {
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                vec3 g = vec3(float(x), float(y), float(z));
                vec3 o = fract(sin(vec3(dot(i + g, vec3(127.1, 311.7, 74.7)),
                                        dot(i + g, vec3(269.5, 183.3, 246.1)),
                                        dot(i + g, vec3(113.5, 271.9, 124.6)))) * 43758.5453);
                vec3 diff = g + o - f;
                minDist = min(minDist, dot(diff, diff));
            }
        }
    }
    return sqrt(minDist);
}

// 3D Hash and FBM for Weathered Rust
float hash13(vec3 p3) {
    p3 = fract(p3 * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float noise3D(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    vec3 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(mix(hash13(i + vec3(0,0,0)), hash13(i + vec3(1,0,0)), u.x),
                   mix(hash13(i + vec3(0,1,0)), hash13(i + vec3(1,1,0)), u.x), u.y),
               mix(mix(hash13(i + vec3(0,0,1)), hash13(i + vec3(1,0,1)), u.x),
                   mix(hash13(i + vec3(0,1,1)), hash13(i + vec3(1,1,1)), u.x), u.y), u.z);
}

float fbmRust(vec3 p) {
    float v = 0.0;
    float a = 0.5;
    vec3 shift = vec3(100.0);
    for (int o = 0; o < 5; ++o) {
        v += a * noise3D(p);
        p = p * 2.04 + shift;
        a *= 0.5;
    }
    return v;
}

void buildOrthonormalBasis(vec3 n, out vec3 t, out vec3 b) {
    if (abs(n.z) < 0.999) {
        t = normalize(cross(n, vec3(0.0, 0.0, 1.0)));
    } else {
        t = normalize(cross(n, vec3(0.0, 1.0, 0.0)));
    }
    b = cross(n, t);
}

// Procedural hash & value noise for atmospheric cloud coverage
float skyHash21(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

float skyNoise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = skyHash21(i);
    float b = skyHash21(i + vec2(1.0, 0.0));
    float c = skyHash21(i + vec2(0.0, 1.0));
    float d = skyHash21(i + vec2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float skyCloudFBM(vec2 p) {
    float v = 0.0;
    float a = 0.5;
    mat2 rot = mat2(0.8, -0.6, 0.6, 0.8);
    for (int i = 0; i < 3; ++i) {
        v += a * skyNoise(p);
        p = rot * p * 2.02 + vec2(1.7, 9.2);
        a *= 0.5;
    }
    return v;
}

// Analytic Atmospheric Rayleigh-Mie Sky Model with Procedural Clouds for Ray Miss Evaluation
vec3 evalAnalyticSky(vec3 dir) {
    vec3 sunDir = normalize(vec3(0.342, -0.664, 0.664));
    float cosTheta = clamp(dir.z, 0.0, 1.0);
    float cosGamma = dot(dir, sunDir);

    // Deep zenith gradient -> atmospheric haze
    vec3 zenithCol = vec3(0.06, 0.22, 0.62);
    vec3 horizonCol = vec3(0.58, 0.70, 0.84);
    float rayleighPhase = 0.75 * (1.0 + cosGamma * cosGamma);
    vec3 skyGrad = mix(horizonCol, zenithCol, pow(cosTheta, 0.55));

    // Sharp solar disc + Henyey-Greenstein corona
    float sunDisc = smoothstep(0.9985, 0.9995, cosGamma);
    const float g = 0.82;
    const float g2 = g * g;
    float miePhase = (1.5 * (1.0 - g2) / (2.0 + g2)) * (1.0 + cosGamma * cosGamma) 
                   / pow(max(1.0 + g2 - 2.0 * g * cosGamma, 0.001), 1.5);
    vec3 sunColor = vec3(1.0, 0.92, 0.75);

    vec3 sky = skyGrad * rayleighPhase + sunColor * (miePhase * 0.04) + sunColor * (sunDisc * 8.0);

    // Procedural planar cloud deck (Z-up coordinates)
    if (dir.z > 0.02) {
        vec2 cloudUV = (dir.xy / (dir.z + 0.05)) * 1.8;
        float cloudDensity = smoothstep(0.42, 0.75, skyCloudFBM(cloudUV));
        if (cloudDensity > 0.0) {
            float sunScatter = clamp(cosGamma, 0.0, 1.0);
            vec3 cloudLit = vec3(0.72, 0.76, 0.82) * 0.4 + vec3(1.0, 0.96, 0.90) * 1.4 * pow(sunScatter, 3.0);
            vec3 cloudShadow = vec3(0.35, 0.38, 0.45);
            vec3 cloudColor = mix(cloudShadow, cloudLit, 0.6 + 0.4 * cosTheta);
            sky = mix(sky, cloudColor, cloudDensity * 0.85);
        }
    } else {
        vec3 groundCol = vec3(0.06, 0.06, 0.07);
        sky = mix(horizonCol * 0.4, groundCol, clamp(-dir.z * 3.0, 0.0, 1.0));
    }

    return sky;
}

// 4 Realistic Production Lights matching Blender showroom scene
struct SceneLight {
    vec3 dir;
    vec3 color;
    float intensity;
};

const SceneLight SCENE_LIGHTS[4] = SceneLight[4](
    SceneLight(vec3(0.342, -0.664, 0.664), vec3(1.0, 0.96, 0.90), 3.4),   // Key Sun
    SceneLight(vec3(-0.60, 0.70, 0.40), vec3(1.0, 0.75, 0.40), 1.6),     // Warm Rim
    SceneLight(vec3(-0.55, -0.75, 0.35), vec3(0.65, 0.80, 1.0), 1.4),    // Cool Fill
    SceneLight(vec3(0.0, 0.20, 0.95), vec3(0.40, 0.35, 0.30), 0.6)       // Ground Bounce
);

// 5 Realistic Production Material Archetypes matching Blender showroom scene
vec3 evalMaterialBSDF(uint matId, vec3 normal, vec3 inDir, vec3 hitPos, inout uint rng) {
    vec3 viewDir = -inDir;
    float NdotV = max(dot(normal, viewDir), 0.001);
    vec3 totalRadiance = vec3(0.0);
    uint archetype = (matId < 20) ? (matId / 4) : 5;

    for (int l = 0; l < 4; ++l) {
        vec3 lightDir = normalize(SCENE_LIGHTS[l].dir);
        vec3 lightCol = SCENE_LIGHTS[l].color * SCENE_LIGHTS[l].intensity;
        vec3 halfVec = normalize(viewDir + lightDir);
        float NdotL = max(dot(normal, lightDir), 0.0);
        float NdotH = max(dot(normal, halfVec), 0.0);
        float VdotH = max(dot(viewDir, halfVec), 0.0);

        if (NdotL <= 0.0 && archetype != 1 && archetype != 5) continue;

        vec3 color = vec3(0.0);
        switch (archetype) {
            case 0: {
                // Archetype 0: Automotive Clearcoat with Metallic Voronoi Flakes (Crimson Red)
                float flakeNoise = voronoiFlakes(hitPos * 120.0);
                vec3 flakeNormal = normalize(normal + (fract(vec3(flakeNoise * 13.0, flakeNoise * 7.0, flakeNoise * 19.0)) - 0.5) * 0.15);
                float flakeNdotH = max(dot(flakeNormal, halfVec), 0.0);
                float flakeNdotL = max(dot(flakeNormal, lightDir), 0.0);
                
                float a2 = 0.06;
                float d = flakeNdotH * flakeNdotH * (a2 - 1.0) + 1.0;
                float D_base = a2 / (3.14159 * d * d + 0.0001);
                vec3 baseTint = vec3(0.85, 0.03, 0.06); // Crimson red
                vec3 baseSpec = (D_base * 0.9 * baseTint) / (4.0 * NdotL * NdotV + 0.001) * flakeNdotL;

                float a2_coat = 0.0004;
                float d_coat = NdotH * NdotH * (a2_coat - 1.0) + 1.0;
                float D_coat = a2_coat / (3.14159 * d_coat * d_coat + 0.0001);
                float F_coat = 0.04 + 0.96 * pow(clamp(1.0 - VdotH, 0.0, 1.0), 5.0);
                vec3 coatSpec = vec3((D_coat * F_coat) / (4.0 * NdotL * NdotV + 0.001) * NdotL);

                vec3 absorption = exp(-vec3(0.1, 0.8, 0.7) * 0.05);
                color = coatSpec + baseSpec * (1.0 - F_coat) * absorption;
                break;
            }
            case 1: {
                // Archetype 1: Organic Jade / Subsurface Scattering (Mint Green)
                vec3 baseJade = vec3(0.08, 0.82, 0.48);
                float wrap = 0.45;
                float diffuseWrap = max((dot(normal, lightDir) + wrap) / (1.0 + wrap), 0.0);
                vec3 sssProfile = exp(-vec3(0.35, 0.9, 0.4) * (1.0 - diffuseWrap));
                float a2 = 0.015;
                float d = NdotH * NdotH * (a2 - 1.0) + 1.0;
                float D = a2 / (3.14159 * d * d + 0.0001);
                float F = 0.05 + 0.95 * pow(clamp(1.0 - VdotH, 0.0, 1.0), 5.0);
                vec3 coat = vec3((D * F) / (4.0 * NdotL * NdotV + 0.001) * NdotL);
                color = baseJade * diffuseWrap * sssProfile * 2.2 + coat;
                break;
            }
            case 2: {
                // Archetype 2: Dispersive Chrome / Glass (Mirror Conductor)
                float a2 = 0.002;
                float d = NdotH * NdotH * (a2 - 1.0) + 1.0;
                float D = a2 / (3.14159 * d * d + 0.0001);
                vec3 baseCol = vec3(0.95, 0.98, 1.0);
                vec3 F = baseCol + (1.0 - baseCol) * pow(clamp(1.0 - VdotH, 0.0, 1.0), 5.0);
                color = (D * F) / (4.0 * NdotL * NdotV + 0.001) * NdotL + baseCol * (0.05 * NdotL);
                break;
            }
            case 3: {
                // Archetype 3: Anisotropic Woven Velvet with Charlie Sheen (Deep Purple)
                vec3 t, b;
                buildOrthonormalBasis(normal, t, b);
                float TdotH = dot(t, halfVec);
                float BdotH = dot(b, halfVec);
                float ax = 0.04;
                float ay = 0.36;
                float d_aniso = (TdotH * TdotH) / (ax * ax) + (BdotH * BdotH) / (ay * ay) + NdotH * NdotH;
                float D_aniso = 1.0 / (3.14159 * ax * ay * d_aniso * d_aniso + 0.0001);
                
                float sin2 = max(1.0 - NdotV * NdotV, 0.0);
                float sheen = pow(sin2, 1.25) * 1.5;
                vec3 sheenCol = vec3(0.95, 0.4, 0.8);
                vec3 baseCol = vec3(0.32, 0.02, 0.25);
                
                float weave = 0.5 + 0.5 * sin(dot(hitPos.xy, vec2(80.0)));
                color = (baseCol * weave * NdotL + sheenCol * sheen + vec3(D_aniso * 0.1) * NdotL);
                break;
            }
            case 4: {
                // Archetype 4: Weathered Industrial Rust (Multi-octave FBM Procedural)
                float rustNoise = fbmRust(hitPos * 4.0);
                float rustMask = smoothstep(0.35, 0.65, rustNoise);
                
                vec3 steelCol = vec3(0.42, 0.44, 0.47);
                float d_steel = NdotH * NdotH * (0.09 - 1.0) + 1.0;
                float D_steel = 0.09 / (3.14159 * d_steel * d_steel + 0.0001);
                vec3 steelSpec = steelCol * (D_steel / (4.0 * NdotL * NdotV + 0.001) * NdotL);

                vec3 rustCol = vec3(0.55, 0.16, 0.05);
                vec3 rustDiff = rustCol * NdotL;

                color = mix(steelSpec, rustDiff, rustMask);
                break;
            }
            case 5: {
                // Archetype 5: Sleek Dark Charcoal Showroom Floor matching Blender
                vec3 floorBase = vec3(0.06, 0.06, 0.07);
                float d_floor = NdotH * NdotH * (0.09 - 1.0) + 1.0;
                float D_floor = 0.09 / (3.14159 * d_floor * d_floor + 0.0001);
                vec3 floorSpec = vec3(D_floor * 0.12 / (4.0 * NdotL * NdotV + 0.001) * NdotL);
                color = floorBase * NdotL + floorSpec;
                break;
            }
        }
        totalRadiance += color * lightCol;
    }

    // Specular environment reflection for polished materials
    vec3 reflDir = reflect(inDir, normal);
    vec3 skyRefl = evalAnalyticSky(reflDir);
    if (archetype == 0) {
        totalRadiance += skyRefl * 0.35 * pow(clamp(1.0 - NdotV, 0.0, 1.0), 4.0);
    } else if (archetype == 1) {
        totalRadiance += skyRefl * 0.15 * pow(clamp(1.0 - NdotV, 0.0, 1.0), 5.0);
    } else if (archetype == 2) {
        totalRadiance = mix(totalRadiance, skyRefl * 1.2, 0.75);
    } else if (archetype == 5) {
        totalRadiance += skyRefl * 0.08 * pow(clamp(1.0 - NdotV, 0.0, 1.0), 3.0);
    }

    return totalRadiance;
}

vec3 computeSmoothNormal(uint primId, vec3 hitPos, vec3 rayDir) {
    vec3 normal;
    if (primId < 65536) {
        // Continuous Parametric Trefoil Torus Knot tube normal with segment interpolation
        uint ringIdx = primId / 256;
        float u0 = (float(ringIdx) / 256.0) * 6.2831853;
        float u1 = (float((ringIdx + 1) % 256) / 256.0) * 6.2831853;

        float r0 = 2.0 + 0.8 * cos(3.0 * u0);
        vec3 unrot0 = vec3(r0 * cos(2.0 * u0), r0 * sin(2.0 * u0), -0.8 * sin(3.0 * u0));
        float r1 = 2.0 + 0.8 * cos(3.0 * u1);
        vec3 unrot1 = vec3(r1 * cos(2.0 * u1), r1 * sin(2.0 * u1), -0.8 * sin(3.0 * u1));

        mat3 R = mat3(
            0.907673, -0.094951, -0.408795,
            0.243210,  0.912837,  0.327990,
            0.342020, -0.397131,  0.851651
        );
        vec3 c0 = R * unrot0 + vec3(0.0, 0.0, 0.45);
        vec3 c1 = R * unrot1 + vec3(0.0, 0.0, 0.45);

        vec3 seg = c1 - c0;
        float segLen2 = dot(seg, seg);
        float tSeg = clamp(dot(hitPos - c0, seg) / max(segLen2, 0.00001), 0.0, 1.0);
        vec3 center = c0 + tSeg * seg;

        normal = normalize(hitPos - center);
    } else {
        // Showroom cavity dish: z = -1.5 + 0.035 * (x^2 + y^2)
        normal = normalize(vec3(-0.07 * hitPos.x, -0.07 * hitPos.y, 1.0));
    }
    if (dot(normal, rayDir) > 0.0) normal = -normal;
    return normal;
}

uint computeMaterialId(uint primId, vec3 hitPos) {
    if (primId < 65536) {
        // 5 broad continuous material sections matching Blender showroom scene (ring // 51)
        uint ringIdx = primId / 256;
        uint section = (ringIdx / 51) % 5;
        uint subQueue = primId % 4;
        return section * 4 + subQueue;
    } else {
        // Showroom floor: distribute across 12 queues (20..31) so no queue overflows
        return 20 + ((primId - 65536) % 12);
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.rayCount) return;

    if (gl_LocalInvocationID.x == 0) {
        localRays = 0;
        localHits = 0;
    }
    barrier();

    uint rngState = idx + pc.seed;

    // Perspective showroom camera matching Blender view (0, -8.2, 2.0) looking at (0, 0, 0.45)
    vec3 camPos = vec3(0.0, -8.2, 2.0);
    vec3 camForward = vec3(0.0, 0.9826, -0.1857);
    vec3 camRight = vec3(1.0, 0.0, 0.0);
    vec3 camUp = vec3(0.0, 0.1857, 0.9826);
    float fov = 0.48; // ~52 deg FoV (38mm lens)

    vec2 uv = vec2((float(idx % 1024) - 512.0 + 0.5) / 512.0, (float(idx / 1024) - 512.0 + 0.5) / 512.0);
    vec3 origin = camPos;
    vec3 direction = normalize(camForward + camRight * (uv.x * fov) - camUp * (uv.y * fov));
    vec3 accumulated = vec3(0.0);
    vec3 throughput = vec3(1.0);
    uint threadRays = 0;
    uint threadHits = 0;

    if (pc.mode == 0) {
        // Mode 0: Material Divergence Stress Test (32 materials)
        threadRays++;
        rayQueryEXT query;
        rayQueryInitializeEXT(query, topLevelAS, gl_RayFlagsNoneEXT, 0xFF, origin, 0.01, direction, 50.0);
        while (rayQueryProceedEXT(query)) {}

        if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
            threadHits++;
            float t = rayQueryGetIntersectionTEXT(query, true);
            vec3 hitPos = origin + direction * t;
            uint primId = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
            vec3 normal = computeSmoothNormal(primId, hitPos, direction);
            uint matId = computeMaterialId(primId, hitPos);

            accumulated = evalMaterialBSDF(matId, normal, direction, hitPos, rngState);
            if (dot(accumulated, accumulated) >= 0.0) threadHits++;
        } else {
            accumulated = evalAnalyticSky(direction);
        }

        if (pc.dumpRenders != 0) {
            fb.pixels[idx] = vec4(accumulated, 1.0);
        }
    } else if (pc.mode == 1) {
        // Mode 1: Multi-Bounce Path Tracing with Russian Roulette (SIMD Lane Starvation)
        for (uint b = 0; b < pc.bounces; ++b) {
            threadRays++;
            rayQueryEXT query;
            rayQueryInitializeEXT(query, topLevelAS, gl_RayFlagsNoneEXT, 0xFF, origin, 0.001, direction, 20.0);
            while (rayQueryProceedEXT(query)) {}

            if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
                threadHits++;
                float t = rayQueryGetIntersectionTEXT(query, true);
                vec3 hitPos = origin + direction * t;
                uint primId = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
                vec3 normal = computeSmoothNormal(primId, hitPos, direction);

                // Hemisphere reflection
                float u1 = rand_float(rngState);
                float u2 = rand_float(rngState);
                direction = align_to_normal(cosine_sample_hemisphere(u1, u2), normal);
                origin = hitPos + normal * 0.002;

                throughput *= vec3(0.8);

                // Russian roulette termination (40% termination probability)
                // In traditional execution, terminated threads must idle until the entire wave completes!
                if (b >= 2 && rand_float(rngState) < 0.4) {
                    break; // Thread becomes inactive; remaining lanes keep looping
                }
            } else {
                accumulated += throughput * evalAnalyticSky(direction);
                break;
            }
        }
    } else if (pc.mode == 2) {
        // Mode 2: Incoherent Secondary GI (Hemisphere Scattering without Spatial Binning)
        threadRays++;
        rayQueryEXT query1;
        rayQueryInitializeEXT(query1, topLevelAS, gl_RayFlagsNoneEXT, 0xFF, origin, 0.001, direction, 20.0);
        while (rayQueryProceedEXT(query1)) {}

        if (rayQueryGetIntersectionTypeEXT(query1, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
            threadHits++;
            float t = rayQueryGetIntersectionTEXT(query1, true);
            vec3 hitPos = origin + direction * t;
            uint primId = rayQueryGetIntersectionPrimitiveIndexEXT(query1, true);
            vec3 normal = computeSmoothNormal(primId, hitPos, direction);

            // Incoherent scattering: arbitrary random directions
            float u1 = rand_float(rngState);
            float u2 = rand_float(rngState);
            vec3 incohDir = align_to_normal(cosine_sample_hemisphere(u1, u2), normal);

            // Secondary ray: high BVH cache miss rate when unorganized
            threadRays++;
            rayQueryEXT query2;
            rayQueryInitializeEXT(query2, topLevelAS, gl_RayFlagsNoneEXT, 0xFF, hitPos + normal * 0.002, 0.001, incohDir, 20.0);
            while (rayQueryProceedEXT(query2)) {}

            if (rayQueryGetIntersectionTypeEXT(query2, true) != 0) {
                threadHits++;
                accumulated += vec3(1.0);
            } else {
                accumulated += evalAnalyticSky(incohDir);
            }
        } else {
            accumulated += evalAnalyticSky(direction);
        }
    } else if (pc.mode == 3) {
        // Mode 3: Stage Breakdown - Pure BVH Traversal (98K Triangles, No Shading)
        threadRays++;
        rayQueryEXT query;
        rayQueryInitializeEXT(query, topLevelAS, gl_RayFlagsNoneEXT, 0xFF, origin, 0.001, direction, 20.0);
        while (rayQueryProceedEXT(query)) {}
        if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
            threadHits++;
        }
    } else if (pc.mode == 4) {
        // Mode 4: Stage Breakdown - Pure Material Shading (Megakernel Divergent, 4 Lights, No BVH)
        threadRays++;
        vec3 hitPos = vec3(uv.x * 5.0, uv.y * 5.0, 1.5);
        vec3 normal = ((idx % 2) == 0) ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
        uint matId = idx % 32;
        accumulated = evalMaterialBSDF(matId, normal, direction, hitPos, rngState);
        if (dot(accumulated, accumulated) >= 0.0) {
            threadHits++;
        }
    }

    if (threadRays > 0) atomicAdd(localRays, threadRays);
    if (threadHits > 0) atomicAdd(localHits, threadHits);
    barrier();

    if (gl_LocalInvocationID.x == 0) {
        atomicAdd(results.totalRays, localRays);
        atomicAdd(results.totalHits, localHits);
    }
}
