#version 460
// GPUBench Dual-Issue & Concurrency Benchmark Suite
// Config 3: Standard INT32 (Single-Issue Baseline)
// Evaluates single-issue integer baseline with a strict sequential dependency chain.

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Data {
    float data[];
} InOutBuffer;

layout(push_constant) uniform PushConstants {
    float multiplier;
    uint num_elements;
} pushConstants;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pushConstants.num_elements) return;

    uint ubase = uint(InOutBuffer.data[index] * 1000.0) + index;
    uint val0 = ubase;
    uint val1 = ubase + 1u;

    uint mu = uint(pushConstants.multiplier);
    if (mu == 0u) mu = 1u;

    uint cu0 = 13u;
    uint cu1 = 29u;

    // 131072 iterations * 2 scalar INT32 ops (add + xor = 2 ops each) = 131072 * 4 = 524,288 INT32 ops
    for (int i = 0; i < 131072; ++i) {
        val0 = (val1 + cu0) ^ mu;
        val1 = (val0 + cu1) ^ mu;
    }

    InOutBuffer.data[index] = float(val0 ^ val1);
}
